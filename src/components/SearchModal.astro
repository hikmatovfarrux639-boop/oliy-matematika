---
---

<!-- Search Trigger Button (for Header) -->
<button id="search-open-btn" class="search-trigger-btn" aria-label="Saytdan qidirish" title="Qidiruv (Ctrl+K)">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <span class="search-btn-text">Qidiruv...</span>
  <kbd class="search-kbd">Ctrl K</kbd>
</button>

<!-- Search Modal Overlay -->
<div id="search-modal-backdrop" class="search-modal-backdrop" style="display: none;">
  <div class="search-modal-dialog">
    <div class="search-input-header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted); flex-shrink: 0;">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="search-input" 
        placeholder="Mavzu qidiring yoki: «Determinantga qiynalyapman» deb yozing..."
        autocomplete="off"
        spellcheck="false"
      />
      <button id="search-close-btn" class="search-close-btn" aria-label="Yopish">
        <kbd>Esc</kbd>
      </button>
    </div>

    <!-- Search Results List -->
    <div id="search-results-container" class="search-results-list">
      <div id="search-empty-state" class="search-empty-state">
        <div style="font-size: 2rem; margin-bottom: 0.5rem;">🔍</div>
        <p style="font-weight: 600; color: var(--text-main); margin-bottom: 0.25rem;">Mavzu qidiring yoki AI Strategdan so'rang</p>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
          Masalan: <code>limit</code>, <code>hosila</code>, <code>determinantga qiynalyapman</code>, <code>integrallarni qanday o'rganay</code>
        </p>
        <a href="/strategiya" class="ai-strategy-promo-btn" id="search-empty-strategy-link">
          <span>🧭</span>
          <span>Qiynalayotgan mavzungiz bo'yicha <strong>AI O'quv Strategiyasi</strong> tuzish →</span>
        </a>
      </div>
      <div id="search-strategy-box" style="display: none; margin-bottom: 0.75rem;"></div>
      <div id="search-results-list" style="display: none;"></div>
      <div id="search-no-results" style="display: none; text-align: center; padding: 1.5rem 1rem; color: var(--text-muted);">
        Hech narsa topilmadi. Yuqoridagi AI Strategiya orqali o'quv rejasini ochib ko'ring.
      </div>
    </div>

    <div class="search-modal-footer">
      <span>Navigatsiya: <kbd>↑</kbd> <kbd>↓</kbd></span>
      <span>Tanlash: <kbd>Enter</kbd></span>
      <span>Yopish: <kbd>Esc</kbd></span>
    </div>
  </div>
</div>

<style>
  .search-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-muted);
    color: var(--text-muted);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .search-trigger-btn:hover {
    border-color: var(--primary);
    color: var(--text-main);
  }

  @media (max-width: 640px) {
    .search-btn-text, .search-kbd {
      display: none;
    }
    .search-trigger-btn {
      padding: 0.5rem;
      border-radius: var(--radius-md);
    }
  }

  .search-kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    color: var(--text-subtle);
  }

  /* Modal Backdrop */
  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 4rem 1rem 1rem;
    animation: fadeIn 0.15s ease-out;
  }

  .search-modal-dialog {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 640px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
    overflow: hidden;
  }

  .search-input-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
  }

  #search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1.1rem;
    color: var(--text-main);
  }

  .search-close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .search-close-btn kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--bg-muted);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
    color: var(--text-muted);
  }

  .search-results-list {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
    max-height: 450px;
  }

  .search-empty-state {
    text-align: center;
    padding: 2rem 1rem;
  }

  .ai-strategy-promo-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(37, 99, 235, 0.12));
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: var(--text-main);
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .ai-strategy-promo-btn:hover {
    border-color: var(--primary);
    transform: translateY(-1px);
  }

  :global(.modal-strategy-card) {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(37, 99, 235, 0.08) 100%);
    border: 1.5px solid #10b981;
    border-radius: var(--radius-md);
    padding: 0.9rem 1rem;
  }

  :global(.modal-mode-chip) {
    font-size: 0.76rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
    display: inline-block;
  }
  :global(.modal-mode-chip:hover) {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  :global(.modal-strategy-step) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.65rem;
    margin-top: 0.35rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.84rem;
    color: var(--text-main);
    font-weight: 600;
    transition: border-color 0.15s ease;
  }
  :global(.modal-strategy-step:hover) {
    border-color: var(--primary);
    color: var(--primary);
  }

  .search-item-card {
    display: block;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 0.5rem;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }
  .search-item-card:hover, .search-item-card.selected {
    background: var(--primary-light);
    border-color: var(--primary);
  }

  .search-item-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--primary);
    margin-bottom: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .search-item-excerpt {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .search-item-excerpt :global(mark) {
    background: rgba(37, 99, 235, 0.2);
    color: var(--primary);
    font-weight: 700;
    border-radius: 2px;
    padding: 0 0.2em;
  }

  .search-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--border-color);
    background: var(--bg-muted);
    font-size: 0.75rem;
    color: var(--text-subtle);
  }
  .search-modal-footer kbd {
    font-family: var(--font-mono);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 3px;
    padding: 0.1rem 0.3rem;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import { generateStudyStrategy, isStrategyOrTopicHelpQuery, normalizeQueryForStrategy } from '../utils/studyStrategyEngine';

  let pagefindInstance: any = null;

  async function getPagefind() {
    if (pagefindInstance) return pagefindInstance;
    try {
      // Dynamic browser-only import that bypasses Vite bundling
      const loadModule = new Function('path', 'return import(path)');
      pagefindInstance = await loadModule('/pagefind/pagefind.js');
      await pagefindInstance.init();
      return pagefindInstance;
    } catch (e) {
      console.warn("Pagefind indeksi hali yuklanmadi:", e);
      return null;
    }
  }

  function setupSearch() {
    const openBtn = document.getElementById('search-open-btn');
    const backdrop = document.getElementById('search-modal-backdrop');
    const closeBtn = document.getElementById('search-close-btn');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const emptyState = document.getElementById('search-empty-state');
    const strategyBox = document.getElementById('search-strategy-box');
    const resultsContainer = document.getElementById('search-results-list');
    const noResults = document.getElementById('search-no-results');
    const emptyStrategyLink = document.getElementById('search-empty-strategy-link');

    let selectedIndex = -1;

    function openModal() {
      const curBackdrop = document.getElementById('search-modal-backdrop');
      const curInput = document.getElementById('search-input') as HTMLInputElement | null;
      const curEmpty = document.getElementById('search-empty-state');
      const curStrategy = document.getElementById('search-strategy-box');
      const curResults = document.getElementById('search-results-list');
      const curNoRes = document.getElementById('search-no-results');

      if (!curBackdrop || !curInput) return;
      curBackdrop.style.display = 'flex';
      curInput.value = '';
      selectedIndex = -1;
      if (curEmpty) curEmpty.style.display = 'block';
      if (curStrategy) curStrategy.style.display = 'none';
      if (curResults) curResults.style.display = 'none';
      if (curNoRes) curNoRes.style.display = 'none';
      setTimeout(() => curInput.focus(), 50);
      document.body.style.overflow = 'hidden';
      getPagefind(); // Preload
    }

    function closeModal() {
      const curBackdrop = document.getElementById('search-modal-backdrop');
      if (!curBackdrop) return;
      curBackdrop.style.display = 'none';
      document.body.style.overflow = '';
    }

    emptyStrategyLink?.addEventListener('click', closeModal);

    if (openBtn && !(openBtn as any)._hasSearchInit) {
      (openBtn as any)._hasSearchInit = true;
      openBtn.addEventListener('click', openModal);
      openBtn.addEventListener('mouseenter', () => { getPagefind(); }, { once: true });
      closeBtn?.addEventListener('click', closeModal);
      backdrop?.addEventListener('click', (e) => {
        if (e.target === backdrop) closeModal();
      });
    }

    // Keyboard shortcuts: Ctrl+K, Cmd+K, Esc (runs globally and always finds active DOM)
    if (!(window as any)._hasSearchKeydown) {
      (window as any)._hasSearchKeydown = true;
      window.addEventListener('keydown', (e) => {
        const curBackdrop = document.getElementById('search-modal-backdrop');
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (curBackdrop?.style.display === 'flex') {
            closeModal();
          } else {
            openModal();
          }
        } else if (e.key === 'Escape' && curBackdrop?.style.display === 'flex') {
          closeModal();
        }
      });
    }

    function updateSelection(items: NodeListOf<HTMLAnchorElement>) {
      items.forEach((item, idx) => {
        if (idx === selectedIndex) {
          item.classList.add('selected');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('selected');
        }
      });
    }

    // Real-time search query
    let debounceTimer: any = null;
    input?.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const query = input.value.trim();

      if (!query) {
        selectedIndex = -1;
        if (emptyState) emptyState.style.display = 'block';
        if (strategyBox) strategyBox.style.display = 'none';
        if (resultsContainer) resultsContainer.style.display = 'none';
        if (noResults) noResults.style.display = 'none';
        return;
      }

      debounceTimer = setTimeout(async () => {
        if (emptyState) emptyState.style.display = 'none';

        // 1. Always render smart AI Study Strategy Roadmap card when query >= 3 chars
        if (strategyBox && query.length >= 3) {
          const plan = generateStudyStrategy(query, 'deep');
          const isExplicitStrategy = isStrategyOrTopicHelpQuery(query);
          const topSteps = plan.steps.slice(0, 2);
          strategyBox.style.display = 'block';
          strategyBox.innerHTML = `
            <div class="modal-strategy-card">
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.35rem;">
                <span style="font-size: 0.78rem; font-weight: 800; color: #059669;">
                  🧭 AI O'QUV NAVIGATORI: ${plan.topicTitle}
                </span>
                <span style="font-size: 0.75rem; color: var(--text-muted);">Formatni tanlang:</span>
              </div>
              <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.55rem;">
                ${isExplicitStrategy ? plan.empathyMessage : "Ushbu mavzuni qanday o'rganmoqchisiz? Faqat asosiy darsmi yoki poydevordan chuqurmi?"}
              </div>

              <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.6rem;">
                <a href="/strategiya?q=${encodeURIComponent(query)}&mode=express" class="modal-mode-chip" style="background: rgba(234, 88, 12, 0.12); color: #ea580c; border: 1px solid rgba(234, 88, 12, 0.3);">
                  ⚡ Faqat shu mavzu (Tezkor 20 daqiqa) →
                </a>
                <a href="/strategiya?q=${encodeURIComponent(query)}&mode=deep" class="modal-mode-chip" style="background: rgba(16, 185, 129, 0.12); color: #059669; border: 1px solid rgba(16, 185, 129, 0.3); font-weight: 700;">
                  🎓 Poydevor bilan chuqur (To'liq xarita) →
                </a>
                <a href="/strategiya?q=${encodeURIComponent(query)}&mode=exam" class="modal-mode-chip" style="background: rgba(37, 99, 235, 0.12); color: #2563eb; border: 1px solid rgba(37, 99, 235, 0.3);">
                  📝 Imtihon & Test rejasi →
                </a>
              </div>

              ${topSteps
                .map(
                  (s, i) => `
                <a href="${s.url}" class="modal-strategy-step">
                  <span><strong>${i + 1}-qadam (${s.phase}):</strong> ${s.title}</span>
                  <span style="font-size: 0.75rem; color: var(--primary); flex-shrink: 0;">⏱ ${s.duration} →</span>
                </a>
              `
                )
                .join('')}
            </div>
          `;
          strategyBox.querySelectorAll('a').forEach((a) => {
            a.addEventListener('click', closeModal);
          });
        } else if (strategyBox) {
          strategyBox.style.display = 'none';
        }

        const pf = await getPagefind();
        if (!pf) {
          return;
        }

        // Normalize typos (e.g. "dterminant" -> "determinant") and strip conversational filler words for Pagefind search
        const normalizedQuery = normalizeQueryForStrategy(query)
          .replace(/\b(men|darsda|qiynalyapman|tushunmayapman|nimadan|boshlay|qanday|organay|kerak|uchun)\b/g, ' ')
          .replace(/\s+/g, ' ')
          .trim() || normalizeQueryForStrategy(query);

        let search = await pf.search(query);
        if (search.results.length === 0 && normalizedQuery !== query.toLowerCase()) {
          search = await pf.search(normalizedQuery);
        }

        const dataPromises = search.results.slice(0, 8).map((r: any) => r.data());
        const results = await Promise.all(dataPromises);

        if (results.length === 0) {
          selectedIndex = -1;
          if (resultsContainer) resultsContainer.style.display = 'none';
          if (noResults) noResults.style.display = strategyBox?.style.display === 'block' ? 'none' : 'block';
        } else {
          if (noResults) noResults.style.display = 'none';
          if (resultsContainer) {
            resultsContainer.style.display = 'block';
            resultsContainer.innerHTML = results.map((item, idx) => `
              <a href="${item.url}" class="search-item-card ${idx === 0 ? 'selected' : ''}">
                <div class="search-item-title">
                  <span>${item.meta.title || 'Mavzu'}</span>
                  <span style="font-size: 0.75rem; color: var(--text-subtle);">O'tish →</span>
                </div>
                <div class="search-item-excerpt">${item.excerpt}</div>
              </a>
            `).join('');

            selectedIndex = 0;

            // Close modal when a search item is clicked
            resultsContainer.querySelectorAll('a').forEach(a => {
              a.addEventListener('click', closeModal);
            });
          }
        }
      }, 150);
    });

    // Arrow keys & Enter navigation on the search input
    input?.addEventListener('keydown', (e) => {
      const items = resultsContainer?.querySelectorAll<HTMLAnchorElement>('.search-item-card');
      if (!items || items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateSelection(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateSelection(items);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (selectedIndex >= 0 && items[selectedIndex]) {
          closeModal();
          items[selectedIndex].click();
        }
      }
    });
  }

  setupSearch();
  document.addEventListener('astro:page-load', setupSearch);
  document.addEventListener('astro:after-swap', setupSearch);
</script>
