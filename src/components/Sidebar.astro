---
import { MODULES } from '../data/modules';
import { getCollection } from 'astro:content';

const currentPath = Astro.url.pathname;
const allLessons = await getCollection('lessons');

// Group lessons by module and sort
const lessonsByModule: Record<string, typeof allLessons> = {};
for (const lesson of allLessons) {
  const mod = lesson.data.module || 'boshqa';
  if (!lessonsByModule[mod]) lessonsByModule[mod] = [];
  lessonsByModule[mod].push(lesson);
}
for (const mod in lessonsByModule) {
  lessonsByModule[mod].sort((a, b) => a.data.order - b.data.order);
}

function isModuleActive(slug: string): boolean {
  return currentPath === `/modullar/${slug}` || 
         currentPath === `/modullar/${slug}/` || 
         currentPath.startsWith(`/dars/${slug}/`) || 
         currentPath.includes(`/${slug}/`);
}
---

<aside class="sidebar-nav">
  <div style="margin-bottom: 1.5rem;">
    <div class="sidebar-section-title">Oliy Matematika Modullari</div>
    <ul class="module-nav-list">
      {MODULES.map(m => {
        const isCurrent = isModuleActive(m.slug);
        const moduleLessons = lessonsByModule[m.slug] || [];
        return (
          <li class={`module-nav-item ${isCurrent ? 'active' : ''} ${!m.isActive ? 'inactive' : ''}`}>
            <a href={`/modullar/${m.slug}`} title={m.title}>
              <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 175px;">
                {m.title}
              </span>
              {m.isActive ? (
                <span class="module-counter-badge">{moduleLessons.length} dars</span>
              ) : (
                <span style="font-size: 0.65rem; color: var(--text-subtle); background: var(--bg-muted); padding: 0.15rem 0.35rem; border-radius: 4px;">Tez orada</span>
              )}
            </a>

            {isCurrent && moduleLessons.length > 0 && (
              <ul class="sidebar-sublesson-list">
                {moduleLessons.map(l => {
                  const lessonSlug = l.id.replace(/\.mdx?$/, '');
                  const lessonUrl = `/dars/${lessonSlug}`;
                  const isLessonActive = currentPath === lessonUrl || currentPath === `${lessonUrl}/`;
                  return (
                    <li class={`sublesson-item ${isLessonActive ? 'active' : ''}`}>
                      <a href={lessonUrl} title={l.data.title}>
                        <span class="sublesson-order">{l.data.order}.</span>
                        <span class="sublesson-title">{l.data.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        );
      })}
    </ul>
  </div>

  <div style="border-top: 1px solid var(--border-color); padding-top: 1.25rem;">
    <div class="sidebar-section-title">Interaktiv Uskunalar</div>
    <ul class="module-nav-list">
      <li class={`module-nav-item ${currentPath.startsWith('/testlar') ? 'active' : ''}`} style="border-left: 3px solid #3b82f6; margin-bottom: 0.25rem;">
        <a href="/testlar" style="font-weight: 700; display: flex; align-items: center; justify-content: space-between;">
          <span>📝 Testlar (HEMIS)</span>
          <span style="font-size: 0.65rem; background: #3b82f6; color: white; padding: 0.1rem 0.4rem; border-radius: 4px;">Top</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/ai-yechuvchi' ? 'active' : ''}`} style="border-left: 3px solid #10b981; margin-bottom: 0.25rem;">
        <a href="/ai-yechuvchi" style="color: var(--primary); font-weight: 700; display: flex; align-items: center; justify-content: space-between;">
          <span>🤖 AI Yechuvchi</span>
          <span style="font-size: 0.65rem; background: #10b981; color: white; padding: 0.1rem 0.4rem; border-radius: 4px;">Yangi</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath.startsWith('/strategiya') ? 'active' : ''}`} style="border-left: 3px solid #059669; margin-bottom: 0.25rem;">
        <a href="/strategiya" style="color: #059669; font-weight: 700; display: flex; align-items: center; justify-content: space-between;">
          <span>🧭 AI O'quv Strategiyasi</span>
          <span style="font-size: 0.65rem; background: #059669; color: white; padding: 0.1rem 0.4rem; border-radius: 4px;">Mentor</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/laboratoriya' ? 'active' : ''}`} style="border-left: 3px solid #ec4899; margin-bottom: 0.25rem;">
        <a href="/laboratoriya" style="color: #ec4899; font-weight: 700; display: flex; align-items: center; justify-content: space-between;">
          <span>🔮 Laboratoriya</span>
          <span style="font-size: 0.65rem; background: #ec4899; color: white; padding: 0.1rem 0.4rem; border-radius: 4px;">WOW</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/grafik' ? 'active' : ''}`}>
        <a href="/grafik">
          <span>📈 Grafik chizgich</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/hosila' ? 'active' : ''}`}>
        <a href="/hosila">
          <span>⚡ Hosila kalkulyatori</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/matritsa' ? 'active' : ''}`} style="border-left: 3px solid #8b5cf6;">
        <a href="/matritsa" style="font-weight: 700; color: #8b5cf6; display: flex; align-items: center; justify-content: space-between;">
          <span>🔢 Matritsa kalkulyatori</span>
          <span style="font-size: 0.65rem; background: #8b5cf6; color: white; padding: 0.1rem 0.4rem; border-radius: 4px;">TATU</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/vektor' ? 'active' : ''}`} style="border-left: 3px solid #06b6d4;">
        <a href="/vektor" style="font-weight: 700; color: #06b6d4; display: flex; align-items: center; justify-content: space-between;">
          <span>📐 Vektor kalkulyatori</span>
          <span style="font-size: 0.65rem; background: #06b6d4; color: white; padding: 0.1rem 0.4rem; border-radius: 4px;">3D</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/formulalar' ? 'active' : ''}`}>
        <a href="/formulalar">
          <span>📐 Formulalar jadvali</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/shpargalkalar' ? 'active' : ''}`} style="border-left: 3px solid #f59e0b;">
        <a href="/shpargalkalar" style="font-weight: 700; color: #f59e0b; display: flex; align-items: center; justify-content: space-between;">
          <span>📄 Shpargalkalar</span>
          <span style="font-size: 0.65rem; background: #f59e0b; color: white; padding: 0.1rem 0.4rem; border-radius: 4px;">PDF</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/lugat' ? 'active' : ''}`} style="border-left: 3px solid #ec4899;">
        <a href="/lugat" style="font-weight: 700; color: #ec4899; display: flex; align-items: center; justify-content: space-between;">
          <span>📖 Lug'at & Glossariy</span>
          <span style="font-size: 0.65rem; background: #ec4899; color: white; padding: 0.1rem 0.4rem; border-radius: 4px;">A-Z</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/kutubxona' ? 'active' : ''}`} style="border-left: 3px solid #10b981;">
        <a href="/kutubxona" style="font-weight: 700; color: #10b981; display: flex; align-items: center; justify-content: space-between;">
          <span>📚 Kutubxona</span>
          <span style="font-size: 0.65rem; background: #10b981; color: white; padding: 0.1rem 0.4rem; border-radius: 4px;">Kitoblar</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/paradokslar' ? 'active' : ''}`} style="border-left: 3px solid #ea580c;">
        <a href="/paradokslar" style="font-weight: 700; color: #ea580c; display: flex; align-items: center; justify-content: space-between;">
          <span>🎭 Paradokslar</span>
          <span style="font-size: 0.65rem; background: #ea580c; color: white; padding: 0.1rem 0.4rem; border-radius: 4px;">Mantiq</span>
        </a>
      </li>
      <li class="module-nav-item" style="border-left: 3px solid #0284c7; margin-top: 0.5rem;">
        <a href="https://t.me/oliy_matematika_1" target="_blank" rel="noopener noreferrer" style="color: #0284c7; font-weight: 700; display: flex; align-items: center; justify-content: space-between;">
          <span>💬 Telegram Guruh</span>
          <span style="font-size: 0.65rem; background: #0284c7; color: white; padding: 0.1rem 0.4rem; border-radius: 4px;">Kanal</span>
        </a>
      </li>
    </ul>
  </div>
</aside>

<script>
  function handleSidebarActiveScroll() {
    const sidebar = document.querySelector('.sidebar-nav');
    if (!sidebar) return;

    // Prioritize active sublesson, fallback to active module
    const activeSub = sidebar.querySelector('.sublesson-item.active') as HTMLElement | null;
    const activeMod = sidebar.querySelector('.module-nav-item.active') as HTMLElement | null;
    const target = activeSub || activeMod;

    if (target) {
      target.scrollIntoView({ block: 'nearest', behavior: 'instant' });
    }
  }

  document.addEventListener('astro:page-load', handleSidebarActiveScroll);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleSidebarActiveScroll);
  } else {
    handleSidebarActiveScroll();
  }
</script>

<style>
  .module-counter-badge {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-subtle);
    background: var(--bg-muted);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .module-nav-item.active > a .module-counter-badge {
    background: var(--primary);
    color: white;
  }

  .sidebar-sublesson-list {
    list-style: none;
    margin: 0.35rem 0 0.6rem 0.75rem;
    padding-left: 0.6rem;
    border-left: 2px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .sublesson-item a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--text-muted);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .sublesson-item a:hover {
    background-color: var(--bg-muted);
    color: var(--primary);
  }

  .sublesson-item.active a {
    background-color: var(--primary-light);
    color: var(--primary);
    font-weight: 700;
  }

  .sublesson-order {
    font-size: 0.75rem;
    font-weight: 700;
    opacity: 0.75;
    flex-shrink: 0;
  }

  .sublesson-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 195px;
  }
</style>
