---
import { MODULES } from '../data/modules';
import { getCollection } from 'astro:content';

const currentPath = Astro.url.pathname;
const allLessons = await getCollection('lessons');

// Group lessons by module and sort
const lessonsByModule: Record<string, typeof allLessons> = {};
for (const lesson of allLessons) {
  const mod = lesson.data.module || 'boshqa';
  if (!lessonsByModule[mod]) lessonsByModule[mod] = [];
  lessonsByModule[mod].push(lesson);
}
for (const mod in lessonsByModule) {
  lessonsByModule[mod].sort((a, b) => a.data.order - b.data.order);
}

function isModuleActive(slug: string): boolean {
  return currentPath === `/modullar/${slug}` || 
         currentPath === `/modullar/${slug}/` || 
         currentPath.startsWith(`/dars/${slug}/`) || 
         currentPath.includes(`/${slug}/`);
}
---

<aside class="sidebar-nav">
  <div style="margin-bottom: 1.5rem;">
    <div class="sidebar-section-title">Oliy Matematika Modullari</div>
    <ul class="module-nav-list">
      {MODULES.map(m => {
        const isCurrent = isModuleActive(m.slug);
        const moduleLessons = lessonsByModule[m.slug] || [];
        return (
          <li class={`module-nav-item ${isCurrent ? 'active' : ''} ${!m.isActive ? 'inactive' : ''}`}>
            <a href={`/modullar/${m.slug}`} title={m.title}>
              <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 175px;">
                {m.title}
              </span>
              {m.isActive ? (
                <span class="module-counter-badge">{moduleLessons.length} dars</span>
              ) : (
                <span style="font-size: 0.65rem; color: var(--text-subtle); background: var(--bg-muted); padding: 0.15rem 0.35rem; border-radius: 4px;">Tez orada</span>
              )}
            </a>

            {isCurrent && moduleLessons.length > 0 && (
              <ul class="sidebar-sublesson-list">
                {moduleLessons.map(l => {
                  const lessonSlug = l.id.replace(/\.mdx?$/, '');
                  const lessonUrl = `/dars/${lessonSlug}`;
                  const isLessonActive = currentPath === lessonUrl || currentPath === `${lessonUrl}/`;
                  return (
                    <li class={`sublesson-item ${isLessonActive ? 'active' : ''}`}>
                      <a href={lessonUrl} title={l.data.title}>
                        <span class="sublesson-order">{l.data.order}.</span>
                        <span class="sublesson-title">{l.data.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        );
      })}
    </ul>
  </div>

  <div style="border-top: 1px solid var(--border-color); padding-top: 1.25rem;">
    <div class="sidebar-section-title">Interaktiv Uskunalar</div>
    <ul class="module-nav-list">
      <li class={`module-nav-item ${currentPath.startsWith('/testlar') ? 'active' : ''}`}>
        <a href="/testlar">
          <span>📝 Testlar</span>
          <span class="nav-badge-primary">Top</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/ai-yechuvchi' ? 'active' : ''}`}>
        <a href="/ai-yechuvchi">
          <span>🤖 AI Yechuvchi</span>
          <span class="nav-badge-primary">AI</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath.startsWith('/strategiya') ? 'active' : ''}`}>
        <a href="/strategiya">
          <span>🧭 AI O'quv Strategiyasi</span>
          <span class="nav-badge-neutral">Tavsiya</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/laboratoriya' ? 'active' : ''}`}>
        <a href="/laboratoriya">
          <span>🔬 Vizual Laboratoriya</span>
          <span class="nav-badge-neutral">3D</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/grafik' ? 'active' : ''}`}>
        <a href="/grafik">
          <span>📈 Grafik chizgich</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/hosila' ? 'active' : ''}`}>
        <a href="/hosila">
          <span>⚡ Hosila kalkulyatori</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/matritsa' ? 'active' : ''}`}>
        <a href="/matritsa">
          <span>🔢 Matritsa kalkulyatori</span>
          <span class="nav-badge-primary">PRO</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/vektor' ? 'active' : ''}`}>
        <a href="/vektor">
          <span>📐 Vektor kalkulyatori</span>
          <span class="nav-badge-neutral">3D</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/formulalar' ? 'active' : ''}`}>
        <a href="/formulalar">
          <span>📑 Formulalar jadvali</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/shpargalkalar' ? 'active' : ''}`}>
        <a href="/shpargalkalar">
          <span>📄 Shpargalkalar (PDF)</span>
          <span class="nav-badge-neutral">A4</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/lugat' ? 'active' : ''}`}>
        <a href="/lugat">
          <span>📖 Lug'at & Glossariy</span>
          <span class="nav-badge-neutral">A–Z</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/kutubxona' ? 'active' : ''}`}>
        <a href="/kutubxona">
          <span>📚 Kitoblar Kutubxonasi</span>
          <span class="nav-badge-neutral">Fondi</span>
        </a>
      </li>
      <li class={`module-nav-item ${currentPath === '/paradokslar' ? 'active' : ''}`}>
        <a href="/paradokslar">
          <span>🧠 Matematik Paradokslar</span>
          <span class="nav-badge-neutral">Mantiq</span>
        </a>
      </li>
      <li class="module-nav-item">
        <a href="https://t.me/oliy_matematika_1" target="_blank" rel="noopener noreferrer">
          <span>💬 Telegram Guruh</span>
          <span class="nav-badge-primary">Kanal</span>
        </a>
      </li>
    </ul>
  </div>
</aside>

<script>
  function handleSidebarActiveScroll() {
    const sidebar = document.querySelector('.sidebar-nav');
    if (!sidebar) return;

    // Prioritize active sublesson, fallback to active module
    const activeSub = sidebar.querySelector('.sublesson-item.active') as HTMLElement | null;
    const activeMod = sidebar.querySelector('.module-nav-item.active') as HTMLElement | null;
    const target = activeSub || activeMod;

    if (target) {
      target.scrollIntoView({ block: 'nearest', behavior: 'instant' });
    }
  }

  document.addEventListener('astro:page-load', handleSidebarActiveScroll);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleSidebarActiveScroll);
  } else {
    handleSidebarActiveScroll();
  }
</script>

<style>
  .nav-badge-primary {
    font-size: 0.65rem;
    font-weight: 600;
    background: rgba(37, 99, 235, 0.12);
    color: var(--primary);
    border: 1px solid rgba(37, 99, 235, 0.25);
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    margin-left: auto;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .nav-badge-neutral {
    font-size: 0.65rem;
    font-weight: 600;
    background: var(--bg-muted);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    margin-left: auto;
    line-height: 1.2;
  }

  :global([data-theme="dark"]) .nav-badge-primary {
    background: rgba(59, 130, 246, 0.18);
    color: #93c5fd;
    border-color: rgba(59, 130, 246, 0.3);
  }

  .module-counter-badge {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-subtle);
    background: var(--bg-muted);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .module-nav-item.active > a .module-counter-badge {
    background: var(--primary);
    color: white;
  }

  .sidebar-sublesson-list {
    list-style: none;
    margin: 0.35rem 0 0.6rem 0.75rem;
    padding-left: 0.6rem;
    border-left: 2px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .sublesson-item a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--text-muted);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .sublesson-item a:hover {
    background-color: var(--bg-muted);
    color: var(--primary);
  }

  .sublesson-item.active a {
    background-color: var(--primary-light);
    color: var(--primary);
    font-weight: 700;
  }

  .sublesson-order {
    font-size: 0.75rem;
    font-weight: 700;
    opacity: 0.75;
    flex-shrink: 0;
  }

  .sublesson-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 195px;
  }
</style>
