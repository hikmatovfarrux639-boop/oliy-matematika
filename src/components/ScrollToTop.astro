---
// ScrollToTop.astro - Floating Back to Top Button
---

<button
  id="scroll-to-top-btn"
  type="button"
  class="scroll-to-top-fab"
  aria-label="Sahifaning yuqori qismiga qaytish"
  title="Tepaga qaytish"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<script>
  function setupScrollToTop() {
    const btn = document.getElementById('scroll-to-top-btn');
    if (!btn || (btn as any)._hasScrollInit) return;
    (btn as any)._hasScrollInit = true;

    let ticking = false;

    function handleScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          if (window.scrollY > 280) {
            btn?.classList.add('visible');
          } else {
            btn?.classList.remove('visible');
          }
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    // Initial check
    handleScroll();

    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }

  setupScrollToTop();
  document.addEventListener('astro:page-load', setupScrollToTop);
  document.addEventListener('astro:after-swap', setupScrollToTop);
</script>

<style>
  .scroll-to-top-fab {
    position: fixed;
    right: 1.5rem;
    bottom: 2rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--primary);
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    z-index: 990;
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) scale(0.9);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease, background 0.2s ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .scroll-to-top-fab.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .scroll-to-top-fab:hover {
    background: var(--primary-hover, #1d4ed8);
    transform: translateY(-2px) scale(1.05);
  }

  .scroll-to-top-fab:active {
    transform: translateY(0) scale(0.95);
  }

  @media (max-width: 768px) {
    .scroll-to-top-fab {
      right: 1rem;
      /* Position above the 60px mobile bottom navigation bar */
      bottom: calc(72px + env(safe-area-inset-bottom, 0px));
      width: 40px;
      height: 40px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.25);
    }
  }
</style>
