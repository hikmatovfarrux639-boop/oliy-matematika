---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import BackupModal from '../components/BackupModal.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  showSidebar?: boolean;
}

const {
  title = "Oliy Matematika — O'zbek tilidagi ta'lim platformasi",
  description = "Universitet oliy matematika kursi: limitlar, hosila, integrallar, funksiyalar va grafiklar tushunarli tilda.",
  showSidebar = true
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://oliy-matematika.vercel.app').href;
const ogImageUrl = 'https://oliy-matematika.vercel.app/og-image.svg';
---

<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover, interactive-widget=resizes-content" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="oliy matematika, oliy matematika darslari, oliy matematika vercel, vektor kalkulyatori, matritsa kalkulyatori, hemis matematika, tuit lms, determinant hisoblash, limitlar, hosila, integrallar, differensial tenglamalar, oliy matematika uzbekcha, oliy matematika misollar yechish" />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#2563eb" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

  <!-- Open Graph / Facebook / Telegram -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:locale" content="uz_UZ" />
  <meta property="og:site_name" content="Oliy Matematika Platformasi" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <ClientRouter />

  <!-- Inline Theme Script to prevent flash of wrong theme and persist across page navigation -->
  <script is:inline>
    (function() {
      function applyTheme(doc) {
        try {
          const target = doc || document;
          const savedTheme = localStorage.getItem('math_theme');
          const theme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          target.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          console.error('Theme apply error:', e);
        }
      }

      // Initial apply
      applyTheme(document);

      // Astro View Transitions lifecycle hooks
      document.addEventListener('astro:before-swap', function(ev) {
        if (ev && ev.newDocument) {
          applyTheme(ev.newDocument);
        }
      });
      document.addEventListener('astro:after-swap', function() {
        applyTheme(document);
      });
      document.addEventListener('astro:page-load', function() {
        applyTheme(document);
      });
    })();
  </script>

  <!-- Service Worker registration for PWA offline capability -->
  <script is:inline>
    if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').catch(function() {});
      });
    }
  </script>
</head>
<body>
  <!-- Telegram In-App Browser Resilience Banner -->
  <div id="tg-notice-banner" style="display: none; background: #0284c7; color: white; padding: 0.55rem 1rem; font-size: 0.85rem; justify-content: center; align-items: center; gap: 0.75rem; text-align: center; position: sticky; top: 0; z-index: 1000; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
    <span>📱 <strong>Telegram brauzeridasiz:</strong> Dars natijalari kesh tozalanganda yo'qolmasligi uchun saytni doimiy brauzeringizda (Chrome, Safari) ochish tavsiya etiladi.</span>
    <button id="tg-dismiss-btn" type="button" style="background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.4); color: white; border-radius: 4px; padding: 0.15rem 0.6rem; font-size: 0.75rem; cursor: pointer; white-space: nowrap;">
      Tushunarli ✕
    </button>
  </div>

  <Header />
  <MobileDrawer />
  <BackupModal />

  <script is:inline>
    function checkTelegramWebview() {
      try {
        const isTg = /Telegram/i.test(navigator.userAgent);
        const isDismissed = sessionStorage.getItem('tg_notice_dismissed');
        const banner = document.getElementById('tg-notice-banner');
        if (isTg && !isDismissed && banner) {
          banner.style.display = 'flex';
          document.getElementById('tg-dismiss-btn')?.addEventListener('click', function() {
            banner.style.display = 'none';
            sessionStorage.setItem('tg_notice_dismissed', '1');
          });
        }
      } catch (e) {}
    }
    document.addEventListener('astro:page-load', checkTelegramWebview);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkTelegramWebview);
    } else {
      checkTelegramWebview();
    }
  </script>

  <div class="layout-container">
    {showSidebar && <Sidebar />}
    <main class="main-content" data-pagefind-body>
      <slot />
    </main>
  </div>

  <footer class="app-footer">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.5rem; align-items: center;">
      <p style="font-weight: 600; color: var(--text-main);">Oliy Matematika — Ochiq va qulay ta'lim platformasi</p>
      <p style="color: var(--text-muted); font-size: 0.8rem;">
        Talabalar va o'rganuvchilar uchun maxsus tayyorlangan. Barcha nazariya va formulalar o'zbek tilida (lotin yozuvida).
      </p>
      <p style="color: var(--text-subtle); font-size: 0.75rem;">
        Hech qanday server yoki ma'lumotlar bazasisiz — 100% statik va o'ta tezkor.
      </p>
    </div>
  </footer>

  <ScrollToTop />
  <MobileBottomNav />
</body>
</html>
