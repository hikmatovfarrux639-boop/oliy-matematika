---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FORMULAS } from '../data/formulas';
import katex from 'katex';

// Pre-render KaTeX HTML at build time for instant loading
const formulasWithHtml = FORMULAS.map(f => ({
  ...f,
  html: katex.renderToString(f.latex, {
    displayMode: true,
    throwOnError: false,
    output: 'html'
  })
}));
---

<BaseLayout title="Oliy Matematika Formulalari — Jadval va Nusxalash" description="Asosiy limitlar, hosilalar va integrallar jadvallari. 1 marta bosishda LaTeX nusxalash imkoniyati.">
  <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.75rem; margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
      <span class="badge badge-active">Ma'lumotnoma & Spravochnik</span>
      <span style="font-size: 0.85rem; color: var(--text-subtle);">1-bosishda LaTeX nusxalash</span>
    </div>

    <h1 style="font-size: 2.1rem; font-weight: 800; margin-bottom: 0.5rem;">
      📐 Oliy Matematika Asosiy Formulalar Jadvali
    </h1>
    <p style="color: var(--text-muted); font-size: 1.05rem; max-width: 760px; line-height: 1.6;">
      Imtihonlar, laboratoriyalar va amaliy mashg'ulotlar uchun tayyor ma'lumotnoma. Har bir formulani bir marta bosish orqali uning <strong>LaTeX kodi</strong>ni buferga nusxalab olishingiz mumkin.
    </p>

    <!-- Search & Filter bar -->
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem;">
      <!-- Category Tabs -->
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button class="tab-btn active" data-tab="all">Barchasi ({FORMULAS.length})</button>
        <button class="tab-btn" data-tab="hosilalar">Hosilalar</button>
        <button class="tab-btn" data-tab="limitlar">Limitlar</button>
        <button class="tab-btn" data-tab="qoidalar">Differensiallash qoidalari</button>
        <button class="tab-btn" data-tab="integrallar">Integrallar</button>
        <button class="tab-btn" data-tab="algebra">Algebra & Matritsalar</button>
        <button class="tab-btn" data-tab="trigonometriya">Trigonometriya</button>
      </div>

      <!-- Action & Search -->
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <!-- Print / PDF Shpargalka Button -->
        <button id="print-formulas-btn" class="print-btn" title="A4 formatda shpargalka sifatida chop etish yoki PDF saqlash">
          <span>🖨️ PDF / Chop etish</span>
        </button>

        <!-- Quick Search Filter -->
        <div style="position: relative; min-width: 220px; flex: 1; max-width: 280px;">
          <input 
            type="text" 
            id="formula-search-input" 
            placeholder="Formulani qidirish..."
            style="width: 100%; padding: 0.55rem 0.85rem 0.55rem 2.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-surface); color: var(--text-main); font-size: 0.9rem;"
          />
          <span style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem;">🔍</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Formulas Container -->
  <div id="formulas-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem;">
    {formulasWithHtml.map(f => (
      <div class="formula-card" data-category={f.category} data-keywords={f.keywords}>
        <div class="formula-card-header">
          <span class="formula-title">{f.title}</span>
          <span class="badge" style="background: var(--bg-muted); color: var(--text-subtle);">{f.categoryLabel}</span>
        </div>

        <div class="formula-display" set:html={f.html} />

        <div class="formula-footer">
          <span class="formula-note">{f.note || ''}</span>
          <button class="copy-formula-btn" data-latex={f.latex}>
            <span>Nusxalash</span>
          </button>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .tab-btn {
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-surface);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .tab-btn:hover {
    color: var(--text-main);
    border-color: var(--primary);
  }
  .tab-btn.active {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }

  .formula-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .formula-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--primary);
  }

  .formula-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .formula-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .formula-display {
    padding: 0.75rem 0.5rem;
    background: var(--bg-muted);
    border-radius: var(--radius-sm);
    margin-bottom: 0.75rem;
    text-align: center;
    overflow-x: auto;
  }

  .formula-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-subtle);
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-color);
  }

  .copy-formula-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-surface);
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .copy-formula-btn:hover {
    background: var(--primary-light);
    border-color: var(--primary);
  }
  .copy-formula-btn.copied {
    background: var(--accent-light);
    color: var(--accent);
    border-color: var(--accent);
  }
  .print-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--accent);
    background: var(--accent-light);
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .print-btn:hover {
    background: var(--accent);
    color: white;
  }

  /* Optimized Print Layout for Cheatsheet PDF */
  @media print {
    header, 
    nav, 
    aside, 
    .tab-btn, 
    #formula-search-input, 
    .copy-formula-btn, 
    .print-btn,
    .badge-active {
      display: none !important;
    }
    body {
      background: white !important;
      color: black !important;
      font-size: 11pt;
    }
    #formulas-grid {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.75rem !important;
      page-break-inside: avoid;
    }
    .formula-card {
      border: 1px solid #ccc !important;
      background: #fafafa !important;
      box-shadow: none !important;
      padding: 0.75rem !important;
      break-inside: avoid;
    }
    .formula-display {
      color: black !important;
    }
    .formula-title {
      font-weight: bold !important;
      color: black !important;
    }
  }
</style>

<script>
  function setupFormulasPage() {
    const grid = document.getElementById('formulas-grid');
    if (!grid || (grid as any)._hasFormulasInit) return;
    (grid as any)._hasFormulasInit = true;

    const searchInput = document.getElementById('formula-search-input') as HTMLInputElement | null;
    const tabBtns = document.querySelectorAll('.tab-btn');
    const cards = document.querySelectorAll('.formula-card');
    const copyBtns = document.querySelectorAll('.copy-formula-btn');
    const printBtn = document.getElementById('print-formulas-btn');

    let activeCategory = 'all';

    // Print action
    printBtn?.addEventListener('click', () => {
      window.print();
    });

    function filterCards() {
      const query = searchInput?.value.toLowerCase().trim() || '';

      cards.forEach(card => {
        const el = card as HTMLElement;
        const category = el.dataset.category;
        const keywords = (el.dataset.keywords || '').toLowerCase();
        const title = el.querySelector('.formula-title')?.textContent?.toLowerCase() || '';

        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesQuery = query === '' || title.includes(query) || keywords.includes(query);

        if (matchesCategory && matchesQuery) {
          el.style.display = 'flex';
        } else {
          el.style.display = 'none';
        }
      });
    }

    // Tabs
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = btn.getAttribute('data-tab') || 'all';
        filterCards();
      });
    });

    // Search
    searchInput?.addEventListener('input', filterCards);

    // 1-Click Copy
    copyBtns.forEach(btn => {
      btn.addEventListener('click', async () => {
        const latex = btn.getAttribute('data-latex') || '';
        try {
          await navigator.clipboard.writeText(latex);
          const originalText = btn.innerHTML;
          btn.textContent = '✓ Nusxalandi!';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.classList.remove('copied');
          }, 2000);
        } catch (err) {
          console.error('Nusxalashda xatolik:', err);
        }
      });
    });
  }

  setupFormulasPage();
  document.addEventListener('astro:page-load', setupFormulasPage);
  document.addEventListener('astro:after-swap', setupFormulasPage);
</script>
