</style>

<script>
  import katex from 'katex';
  import { solveLocally, diagnoseTopic, type TopicDiagnosis } from '../utils/localSolver';

  function initAiSolver() {
    const input = document.getElementById('problem-input') as HTMLTextAreaElement | null;
    const solveBtn = document.getElementById('solve-problem-btn');
    const solveBtnText = document.getElementById('solve-btn-text');
    const solveBtnSpinner = document.getElementById('solve-btn-spinner');
    const clearBtn = document.getElementById('clear-problem-btn');
    const searchToggle = document.getElementById('google-search-toggle') as HTMLInputElement | null;

    const cameraBtn = document.getElementById('camera-btn');
    const galleryBtn = document.getElementById('gallery-btn');
    const cameraInput = document.getElementById('camera-file-input') as HTMLInputElement | null;
    const galleryInput = document.getElementById('gallery-file-input') as HTMLInputElement | null;
    const previewContainer = document.getElementById('image-preview-container');
    const imagePreview = document.getElementById('image-preview') as HTMLImageElement | null;
    const imageName = document.getElementById('image-name');
    const removeImageBtn = document.getElementById('remove-image-btn');

    const webcamModal = document.getElementById('webcam-modal-backdrop');
    const webcamVideo = document.getElementById('webcam-video') as HTMLVideoElement | null;
    const webcamCanvas = document.getElementById('webcam-canvas') as HTMLCanvasElement | null;
    const webcamSnapBtn = document.getElementById('webcam-snap-btn');
    const webcamCloseBtn = document.getElementById('webcam-close-btn');
    const webcamCancelBtn = document.getElementById('webcam-cancel-btn');
    const webcamSpinner = document.getElementById('webcam-loading-spinner');

    const errorBox = document.getElementById('ai-error-box');
    const errorText = document.getElementById('ai-error-text');
    const diagnosisCard = document.getElementById('topic-diagnosis-card');
    const solutionContainer = document.getElementById('solution-container');
    const solutionBody = document.getElementById('solution-body');
    const solutionEngineBadge = document.getElementById('solution-engine-badge');
    const askAiDeeperBtn = document.getElementById('ask-ai-deeper-btn');
    const copySolutionBtn = document.getElementById('copy-solution-btn');
    const printSolutionBtn = document.getElementById('print-solution-btn');
    const groundingContainer = document.getElementById('grounding-sources');
    const sourcesList = document.getElementById('sources-list');

    const apiKeyModal = document.getElementById('api-modal-backdrop');
    const apiKeySettingsBtn = document.getElementById('api-key-settings-btn');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const apiKeyInput = document.getElementById('api-key-input') as HTMLInputElement | null;
    const saveKeyBtn = document.getElementById('save-key-btn');
    const removeKeyBtn = document.getElementById('remove-key-btn');
    const apiKeyStatus = document.getElementById('api-key-status');

    if (!input || !solveBtn) return;
    if ((input as any)._hasAiSolverInitialized) return;
    (input as any)._hasAiSolverInitialized = true;

    let selectedImageBase64: string | null = null;
    let selectedImageMime: string | null = null;
    let currentMode: string = 'auto';
    let lastRawSolutionText = '';
    let activeStream: MediaStream | null = null;

    // Render KaTeX on preset buttons
    document.querySelectorAll('.preset-math').forEach(el => {
      const txt = (el.textContent || '').trim();
      if (!txt) return;
      try {
        katex.render(txt.replace(/^\$+|\$+$/g, ''), el as HTMLElement, { throwOnError: false, displayMode: false });
      } catch {}
    });

    // Mode Selector Pills
    document.querySelectorAll('.mode-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.mode-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentMode = (pill as HTMLElement).dataset.mode || 'auto';
        if (input.value.trim() || selectedImageBase64) {
          handleSolve(currentMode === 'ai');
        }
      });
    });

    // API Key status
    function updateKeyStatus() {
      const key = localStorage.getItem('gemini_user_api_key');
      if (key && key.trim()) {
        apiKeyStatus?.classList.remove('not-set');
        apiKeyStatus?.classList.add('set');
      } else {
        apiKeyStatus?.classList.remove('set');
        apiKeyStatus?.classList.add('not-set');
      }
    }
    updateKeyStatus();

    apiKeySettingsBtn?.addEventListener('click', () => {
      if (!apiKeyModal || !apiKeyInput) return;
      apiKeyInput.value = localStorage.getItem('gemini_user_api_key') || '';
      apiKeyModal.style.display = 'flex';
      apiKeyInput.focus();
    });
    modalCloseBtn?.addEventListener('click', () => { if (apiKeyModal) apiKeyModal.style.display = 'none'; });
    apiKeyModal?.addEventListener('click', (e) => { if (e.target === apiKeyModal) apiKeyModal.style.display = 'none'; });

    saveKeyBtn?.addEventListener('click', () => {
      const key = apiKeyInput?.value.trim() || '';
      if (key) localStorage.setItem('gemini_user_api_key', key);
      else localStorage.removeItem('gemini_user_api_key');
      updateKeyStatus();
      if (apiKeyModal) apiKeyModal.style.display = 'none';
    });

    removeKeyBtn?.addEventListener('click', () => {
      localStorage.removeItem('gemini_user_api_key');
      if (apiKeyInput) apiKeyInput.value = '';
      updateKeyStatus();
      if (apiKeyModal) apiKeyModal.style.display = 'none';
    });

    // Quick symbols
    document.querySelectorAll('.quick-sym').forEach(btn => {
      btn.addEventListener('click', () => {
        const sym = (btn as HTMLElement).dataset.insert || '';
        const start = input.selectionStart ?? input.value.length;
        const end = input.selectionEnd ?? input.value.length;
        const text = input.value;
        input.value = text.substring(0, start) + sym + text.substring(end);
        input.setSelectionRange(start + sym.length, start + sym.length);
        input.focus();
      });
    });

    // Presets 1-click
    document.querySelectorAll('.preset-card').forEach(btn => {
      btn.addEventListener('click', () => {
        const prob = (btn as HTMLElement).dataset.problem || '';
        input.value = prob;
        handleSolve(false);
      });
    });

    // FAST CLIENT-SIDE IMAGE COMPRESSION (Reduces 6MB photo to ~90KB in 40ms!)
    function compressAndLoadImage(file: File) {
      if (!file.type.startsWith('image/')) {
        showError('Faqat rasm fayllarini (JPG, PNG, WebP) yuklash mumkin.');
        return;
      }
      hideError();

      const reader = new FileReader();
      reader.onload = (e) => {
        const dataUrl = e.target?.result as string;
        const img = new Image();
        img.onload = () => {
          const MAX_DIM = 1200;
          let w = img.width;
          let h = img.height;
          if (w > MAX_DIM || h > MAX_DIM) {
            if (w > h) {
              h = Math.round((h * MAX_DIM) / w);
              w = MAX_DIM;
            } else {
              w = Math.round((w * MAX_DIM) / h);
              h = MAX_DIM;
            }
          }
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx?.drawImage(img, 0, 0, w, h);

          const compressedUrl = canvas.toDataURL('image/jpeg', 0.82);
          selectedImageBase64 = compressedUrl.split(',')[1];
          selectedImageMime = 'image/jpeg';

          if (imagePreview && previewContainer && imageName) {
            imagePreview.src = compressedUrl;
            const sizeKb = Math.round((selectedImageBase64.length * 3) / 4 / 1024);
            imageName.textContent = `${file.name} (${sizeKb} KB — optimallashtirildi)`;
            previewContainer.style.display = 'flex';
          }
        };
        img.src = dataUrl;
      };
      reader.readAsDataURL(file);
    }

    function stopWebcam() {
      if (activeStream) {
        activeStream.getTracks().forEach(t => t.stop());
        activeStream = null;
      }
      if (webcamModal) webcamModal.style.display = 'none';
    }

    cameraBtn?.addEventListener('click', async () => {
      const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      if (isMobile) {
        cameraInput?.click();
        return;
      }
      if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia && webcamModal && webcamVideo) {
        try {
          webcamModal.style.display = 'flex';
          if (webcamSpinner) webcamSpinner.style.display = 'block';
          activeStream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } },
            audio: false
          });
          webcamVideo.srcObject = activeStream;
          webcamVideo.onloadedmetadata = () => {
            if (webcamSpinner) webcamSpinner.style.display = 'none';
          };
        } catch {
          stopWebcam();
          cameraInput?.click();
        }
      } else {
        cameraInput?.click();
      }
    });

    webcamSnapBtn?.addEventListener('click', () => {
      if (!webcamVideo || !webcamCanvas) return;
      webcamCanvas.width = webcamVideo.videoWidth || 800;
      webcamCanvas.height = webcamVideo.videoHeight || 600;
      const ctx = webcamCanvas.getContext('2d');
      if (ctx) {
        ctx.drawImage(webcamVideo, 0, 0, webcamCanvas.width, webcamCanvas.height);
        const dataUrl = webcamCanvas.toDataURL('image/jpeg', 0.82);
        selectedImageBase64 = dataUrl.split(',')[1];
        selectedImageMime = 'image/jpeg';
        if (imagePreview && previewContainer && imageName) {
          imagePreview.src = dataUrl;
          imageName.textContent = 'kamera_misol.jpg';
          previewContainer.style.display = 'flex';
        }
      }
      stopWebcam();
    });

    webcamCloseBtn?.addEventListener('click', stopWebcam);
    webcamCancelBtn?.addEventListener('click', stopWebcam);
    galleryBtn?.addEventListener('click', () => galleryInput?.click());

    cameraInput?.addEventListener('change', () => {
      if (cameraInput.files?.[0]) compressAndLoadImage(cameraInput.files[0]);
    });
    galleryInput?.addEventListener('change', () => {
      if (galleryInput.files?.[0]) compressAndLoadImage(galleryInput.files[0]);
    });

    document.addEventListener('paste', (e: ClipboardEvent) => {
      const items = e.clipboardData?.items;
      if (!items) return;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.startsWith('image/')) {
          const file = items[i].getAsFile();
          if (file) compressAndLoadImage(file);
          break;
        }
      }
    });

    removeImageBtn?.addEventListener('click', () => {
      selectedImageBase64 = null;
      selectedImageMime = null;
      if (previewContainer) previewContainer.style.display = 'none';
      if (cameraInput) cameraInput.value = '';
      if (galleryInput) galleryInput.value = '';
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      removeImageBtn?.click();
      hideError();
      if (diagnosisCard) diagnosisCard.style.display = 'none';
      if (solutionContainer) solutionContainer.style.display = 'none';
      input.focus();
    });

    function showError(msg: string) {
      if (!errorBox || !errorText) return;
      errorText.textContent = msg;
      errorBox.style.display = 'block';
    }
    function hideError() {
      if (errorBox) errorBox.style.display = 'none';
    }

    /**
     * Renders the Smart Topic Diagnosis & Course Recommender Card
     */
    function renderDiagnosisCard(diag: TopicDiagnosis) {
      if (!diagnosisCard) return;

      const formulasHtml = diag.keyFormulas
        .map(f => {
          let rendered = f.latex;
          try {
            rendered = katex.renderToString(f.latex, { displayMode: false, throwOnError: false });
          } catch {}
          return `
            <div class="diag-formula-item">
              <div style="font-size: 0.74rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.25rem;">${f.name}:</div>
              <div style="font-size: 0.92rem; overflow-x: auto;">${rendered}</div>
            </div>
          `;
        })
        .join('');

      const relatedHtml = diag.relatedLessons
        .map(
          l => `
            <a href="${l.url}" class="diag-lesson-link">
              <span>📄 ${l.title}</span>
              <span style="color: var(--primary); font-weight: 800;">→</span>
            </a>
          `
        )
        .join('');

      let whyHtml = diag.whyThisTopic;
      whyHtml = whyHtml.replace(/\$([^\$\n]+?)\$/g, (_, m) => {
        try {
          return katex.renderToString(m, { displayMode: false, throwOnError: false });
        } catch {
          return m;
        }
      });

      let adviceHtml = diag.studyAdvice;
      adviceHtml = adviceHtml.replace(/\$([^\$\n]+?)\$/g, (_, m) => {
        try {
          return katex.renderToString(m, { displayMode: false, throwOnError: false });
        } catch {
          return m;
        }
      });

      diagnosisCard.innerHTML = `
        <div class="diag-header">
          <div>
            <a href="${diag.moduleUrl}" class="diag-module-badge">
              📂 ${diag.moduleTitle}
            </a>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--text-main); margin: 0.15rem 0 0.35rem;">
              🎯 Mavzu tashxisi: ${diag.topicName}
            </h2>
            <p style="font-size: 0.92rem; color: var(--text-muted); margin: 0; line-height: 1.5;">
              ${whyHtml}
            </p>
          </div>
          <span class="badge" style="background: var(--bg-muted); border: 1px solid var(--border-color); color: var(--text-main); font-size: 0.78rem; padding: 0.35rem 0.75rem;">
            Daraja: ${diag.difficulty}
          </span>
        </div>

        <!-- Primary Recommended Lesson CTA -->
        <div class="diag-primary-cta">
          <div>
            <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--primary); display: block; margin-bottom: 0.2rem;">
              ⭐ Ushbu misolni o'rganish uchun eng muhim dars:
            </span>
            <strong style="font-size: 1.08rem; color: var(--text-main);">
              📖 ${diag.primaryLesson.title}
            </strong>
          </div>
          <a href="${diag.primaryLesson.url}" class="btn btn-primary" style="font-weight: 700; font-size: 0.9rem; padding: 0.6rem 1.2rem; white-space: nowrap;">
            Darsni o'qish va o'rganish →
          </a>
        </div>

        <!-- Key Formulas Needed -->
        <div style="margin-bottom: 1.15rem;">
          <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-main); display: block; margin-bottom: 0.35rem;">
            🧮 Ushbu mavzuda ishlatiladigan asosiy formulalar:
          </span>
          <div class="diag-formulas-row">
            ${formulasHtml}
          </div>
        </div>

        <!-- Related Lessons in this Module -->
        <div style="margin-bottom: 1.15rem;">
          <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-main); display: block; margin-bottom: 0.35rem;">
            📚 Shu mavzuga aloqador qo'shimcha darslar:
          </span>
          <div class="diag-lessons-grid">
            ${relatedHtml}
          </div>
        </div>

        <!-- Study Tip + Quick Tools -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.85rem; padding-top: 0.9rem; border-top: 1px dashed var(--border-color);">
          <div style="flex: 1; min-width: 250px; font-size: 0.86rem; color: var(--text-muted); line-height: 1.5;">
            <strong style="color: var(--text-main);">💡 O'qituvchi maslahati:</strong> ${adviceHtml}
          </div>
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a href="/grafik" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">
              📈 Grafik chizgich
            </a>
            <a href="/testlar" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">
              📝 HEMIS Testlar
            </a>
            <a href="/shpargalkalar" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">
              📄 Shpargalka (PDF)
            </a>
          </div>
        </div>
      `;

      diagnosisCard.style.display = 'block';
    }

    /**
     * Render Markdown with KaTeX Display, Inline Math, and Course Links
     */
    function renderMathMarkdown(raw: string): string {
      let content = raw;

      const blockMathMap: string[] = [];
      content = content.replace(/\$\$([\s\S]*?)\$\$/g, (_, mathStr) => {
        try {
          const rendered = katex.renderToString(mathStr.trim(), { displayMode: true, throwOnError: false, output: 'html' });
          blockMathMap.push(rendered);
        } catch {
          blockMathMap.push(`<div class="katex-err">$$${mathStr}$$</div>`);
        }
        return `___BLOCK_MATH_${blockMathMap.length - 1}___`;
      });

      const inlineMathMap: string[] = [];
      content = content.replace(/\$([^\$\n]+?)\$/g, (_, mathStr) => {
        try {
          const rendered = katex.renderToString(mathStr.trim(), { displayMode: false, throwOnError: false, output: 'html' });
          inlineMathMap.push(rendered);
        } catch {
          inlineMathMap.push(`$${mathStr}$`);
        }
        return `___INLINE_MATH_${inlineMathMap.length - 1}___`;
      });

      // Convert markdown links [Title](/dars/...) to styled course buttons
      content = content.replace(/\[([^\]]+)\]\((\/(?:dars|modullar)\/[^\)]+)\)/g, '<a href="$2" class="inline-course-link">📖 $1 →</a>');

      content = content.replace(/^### (.*$)/gim, '<h3>$1</h3>');
      content = content.replace(/^## (.*$)/gim, '<h2 style="color: var(--primary); margin-top: 1.25rem;">$1</h2>');
      content = content.replace(/^# (.*$)/gim, '<h1 style="color: var(--primary);">$1</h1>');
      content = content.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      content = content.replace(/\*(.*?)\*/g, '<em>$1</em>');

      content = content.replace(/^(Qadam \d+:|1-qadam:|2-qadam:|3-qadam:|4-qadam:|5-qadam:)(.*$)/gim, '<div class="step-box"><strong>$1</strong>$2</div>');
      content = content.replace(/^(Javob:|Yakuniy javob:)(.*$)/gim, '<div class="answer-box"><strong>✅ $1</strong>$2</div>');
      content = content.replace(/\n\n/g, '<br><br>');

      inlineMathMap.forEach((m, idx) => {
        content = content.replace(`___INLINE_MATH_${idx}___`, m);
      });
      blockMathMap.forEach((m, idx) => {
        content = content.replace(`___BLOCK_MATH_${idx}___`, m);
      });

      return content;
    }

    /**
     * MAIN SOLVE HANDLER
     */
    async function handleSolve(forceAi = false) {
      hideError();
      const problemText = input!.value.trim();

      if (!problemText && !selectedImageBase64) {
        showError('Iltimos, misolni yozing yoki uning rasmini yuklang.');
        return;
      }

      // Always run instant Topic Diagnosis immediately (< 1ms)
      const localResult = solveLocally(problemText || 'funksiya', currentMode);
      renderDiagnosisCard(localResult.diagnosis);

      // STEP 1: Instant Local Analytical Engine (unless user uploaded a photo or explicitly forced AI)
      if (problemText && !selectedImageBase64 && !forceAi && currentMode !== 'ai') {
        if (localResult.solved && localResult.markdown) {
          lastRawSolutionText = localResult.markdown;
          if (solutionBody) {
            solutionBody.innerHTML = renderMathMarkdown(localResult.markdown);
          }
          if (solutionEngineBadge) {
            solutionEngineBadge.textContent = `⚡ Analitik dvigatel (${localResult.type || 'Avtomatik'}) • 0.01 soniyada yechildi`;
          }
          if (groundingContainer) groundingContainer.style.display = 'none';
          if (solutionContainer) {
            solutionContainer.style.display = 'block';
            diagnosisCard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          return;
        }
      }

      // STEP 2: Online Gemini 3.8 Flash Fast Multimodal Engine
      let apiKey = localStorage.getItem('gemini_user_api_key') || '';

      if (!apiKey) {
        if (solutionBody && solutionContainer) {
          solutionBody.innerHTML = `
            <div style="background: var(--bg-muted); border: 2px dashed var(--primary); border-radius: var(--radius-md); padding: 1.5rem; text-align: center;">
              <span style="font-size: 2.2rem; display: block; margin-bottom: 0.4rem;">🤖</span>
              <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem;">
                ${selectedImageBase64 ? "Rasmdagi qo'lyozma misolni o'qish va yechish" : "Gemini AI orqali chuqur yechim olish"}
              </h3>
              <p style="color: var(--text-muted); font-size: 0.92rem; max-width: 560px; margin: 0 auto 1.15rem; line-height: 1.6;">
                Yuqorida misolning <strong>mavzu tashxisi va kerakli darslar</strong> tayyor! Rasmdagi misolni yoki nostandart shartli masalani Gemini 3.8 Flash sun'iy intellekti orqali yechish uchun bepul API kalitni kiriting:
              </p>
              <div style="max-width: 500px; margin: 0 auto; display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center;">
                <input 
                  type="password" 
                  id="inline-api-key-input" 
                  placeholder="AIzaSy... kalitini bu yerga qo'ying" 
                  style="flex: 1; min-width: 230px; padding: 0.65rem 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-surface); color: var(--text-main); font-family: var(--font-mono); font-size: 0.9rem;"
                />
                <button type="button" id="inline-save-key-btn" class="btn btn-primary" style="padding: 0.65rem 1.25rem; font-weight: 700;">
                  Saqlash va Yechish 🚀
                </button>
              </div>
              <div style="margin-top: 0.9rem; font-size: 0.85rem;">
                <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener" style="color: var(--primary); font-weight: 700; text-decoration: underline;">
                  👉 1 daqiqada bepul Gemini API kalit olish (aistudio.google.com)
                </a>
              </div>
            </div>
          `;
          solutionContainer.style.display = 'block';
          diagnosisCard?.scrollIntoView({ behavior: 'smooth', block: 'start' });

          const inlineInput = document.getElementById('inline-api-key-input') as HTMLInputElement | null;
          const inlineSave = document.getElementById('inline-save-key-btn');
          inlineSave?.addEventListener('click', () => {
            const val = inlineInput?.value.trim() || '';
            if (val) {
              localStorage.setItem('gemini_user_api_key', val);
              updateKeyStatus();
              handleSolve(true);
            }
          });
        }
        return;
      }

      // Loading State
      solveBtn!.setAttribute('disabled', 'true');
      if (solveBtnText) solveBtnText.textContent = 'Gemini AI yechmoqda...';
      if (solveBtnSpinner) solveBtnSpinner.style.display = 'inline-block';

      try {
        const useGoogleSearch = searchToggle?.checked || false;

        const systemPrompt = `Siz OliyMatematika (oliy-matematika.vercel.app) platformasining tezkor professor-repetitorisiz.
Vazifangiz: Berilgan oliy matematika misolini (matn yoki rasmdagi qo'lyozma) o'zbek tilida (lotin yozuvida) qadamma-qadam yechish va talabaga saytdagi aynan qaysi darsni o'qish kerakligini tavsiya qilish.

Qat'iy qoidalar:
1. Barcha matematik formulalarni KaTeX formatida yozing: $...$ va $$...$$.
2. Yechimni qisqa, tushunarli va aniq 4 bo'limda bering:
   - ## 1. Masala sharti va mavzu tashxisi
   - ## 2. Qadamma-qadam yechim
   - ## 3. Yakuniy javob
   - ## 4. Saytdan o'rganish uchun tavsiya etilgan darslar
3. 4-bo'limda quyidagi mavjud dars havolalaridan eng moslarini markdown link sifatida bering:
   - [Tenglamalar va tengsizliklar](/dars/maktab-kursi/tenglamalar-va-tengsizliklar)
   - [Trigonometriya asoslari](/dars/maktab-kursi/trigonometriya-asoslari)
   - [Matritsalar va amallar](/dars/chiziqli-algebra/matritsalar-va-amallar)
   - [Determinantlar va xossalari](/dars/chiziqli-algebra/determinantlar)
   - [Chiziqli tenglamalar sistemasi va Kramer qoidasi](/dars/chiziqli-algebra/chiziqli-tenglamalar-sistemasi)
   - [Gauss usuli](/dars/chiziqli-algebra/gauss-usuli-amaliy)
   - [Skalyar ko'paytma](/dars/vektorlar-geometriya/skalyar-kopaytma)
   - [Vektor va aralash ko'paytma](/dars/vektorlar-geometriya/vektor-va-aralash-kopaytma)
   - [Muavr formulasi va kompleks sonlar](/dars/kompleks-sonlar/muavr-formulasi-va-ildiz-chiqarish)
   - [Aniqmasliklar (0/0 va ∞/∞) va ularni ochish](/dars/limitlar/aniqmasliklar-va-ularni-ochish)
   - [Ajoyib limitlar](/dars/limitlar/ajoyib-limitlar)
   - [Funksiyani tekshirish va grafik yasash](/dars/funksiyalar-grafiklar/funksiyani-tekshirish-va-grafik-yasash)
   - [Differensiallash qoidalari va jadvali](/dars/hosila/differensiallash-qoidalari-va-jadval)
   - [Murakkab funksiya hosilasi](/dars/hosila/murakkab-funksiya-hosilasi)
   - [Lopital qoidasi](/dars/hosila/lopital-qoidasi)
   - [Boshlang'ich funksiya va aniqmas integral](/dars/integrallar/boshlangich-funksiya-va-aniqmas-integral)
   - [O'zgaruvchini almashtirish usuli](/dars/integrallar/integrallash-usullari-almashtirish)
   - [Bo'laklab integrallash usuli](/dars/integrallar/bolaklab-integrallash)
   - [Aniq integral va Nyuton-Leybnits formulasi](/dars/integrallar/aniq-integral-va-nyuton-leybnits)
   - [Xususiy hosilalar](/dars/kop-ozgaruvchili-funksiyalar/xususiy-hosilalar)
   - [Ikki karrali integral](/dars/karrali-integrallar/ikki-karrali-integral-va-hisoblash)
   - [Musbat hadli qatorlar: Dalamber va Koshi alomatlari](/dars/qatorlar/musbat-hadli-qatorlar-alomatlari)
   - [O'zgaruvchilari ajraladigan differensial tenglamalar](/dars/differensial-tenglamalar/ozgaruvchilari-ajraladigan-tenglamalar)
   - [2-tartibli o'zgarmas koeffitsiyentli differensial tenglamalar](/dars/differensial-tenglamalar/ikkinchi-tartibli-chiziqli-differensial-tenglamalar)
   - [Kombinatorika va klassik ehtimollik](/dars/ehtimollar-nazariyasi/kombinatorika-va-klassik-ehtimollik)`;

        const parts: any[] = [];
        if (selectedImageBase64 && selectedImageMime) {
          parts.push({
            inline_data: {
              mime_type: selectedImageMime,
              data: selectedImageBase64
            }
          });
        }

        const queryText = problemText
          ? `Misolni qadamma-qadam yeching va saytdagi mos darsni tavsiya qiling:\n${problemText}`
          : `Rasmdagi misolni o'qib, qadamma-qadam yeching va saytdagi mos darsni tavsiya qiling.`;
        parts.push({ text: queryText });

        const candidateModels = [
          { name: 'gemini-3.8-flash', useThinkingLow: true },
          { name: 'gemini-3.5-flash-lite', useThinkingLow: false },
          { name: 'gemini-2.0-flash', useThinkingLow: false }
        ];

        let res: Response | null = null;
        let lastErrorMsg = '';

        for (const m of candidateModels) {
          try {
            const requestBody: any = {
              system_instruction: { parts: [{ text: systemPrompt }] },
              contents: [{ parts }],
              generationConfig: {
                temperature: 0.15,
                ...(m.useThinkingLow ? { thinkingConfig: { thinkingLevel: 'low' } } : {})
              }
            };
            if (useGoogleSearch) {
              requestBody.tools = [{ google_search: {} }];
            }

            const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/${m.name}:generateContent?key=${apiKey}`;
            const attempt = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(requestBody)
            });

            if (attempt.ok) {
              res = attempt;
              break;
            } else {
              const errData = await attempt.json().catch(() => ({}));
              lastErrorMsg = errData?.error?.message || `Xatolik (${attempt.status})`;
              if (lastErrorMsg.includes('API key') || lastErrorMsg.includes('API_KEY_INVALID')) {
                throw new Error(lastErrorMsg);
              }
            }
          } catch (e: any) {
            if (e.message && (e.message.includes('API key') || e.message.includes('API_KEY_INVALID'))) {
              throw e;
            }
            lastErrorMsg = e.message || String(e);
          }
        }

        if (!res || !res.ok) {
          throw new Error(lastErrorMsg || "Gemini serveriga ulanib bo'lmadi.");
        }

        const data = await res.json();
        const candidate = data.candidates?.[0];
        const partsList = candidate?.content?.parts || [];
        const nonThoughtTexts = partsList
          .filter((p: any) => !p.thought && p.text)
          .map((p: any) => p.text);

        const rawText = nonThoughtTexts.length > 0
          ? nonThoughtTexts.join('\n\n')
          : (partsList[0]?.text || "Yechim hosil qilib bo'lmadi.");
        lastRawSolutionText = rawText;

        // Also update the diagnosis card based on the recognized math text from AI!
        const aiDiag = diagnoseTopic(problemText + ' ' + rawText.slice(0, 350));
        renderDiagnosisCard(aiDiag);

        if (solutionBody) {
          solutionBody.innerHTML = renderMathMarkdown(rawText);
        }
        if (solutionEngineBadge) {
          solutionEngineBadge.textContent = '🤖 Gemini 3.8 Flash Multimodal AI orqali tahlil qilindi';
        }

        if (solutionContainer) {
          solutionContainer.style.display = 'block';
          diagnosisCard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } catch (err: any) {
        const errMsg = err.message || '';
        if (errMsg.includes('API key') || errMsg.includes('API_KEY_INVALID')) {
          localStorage.removeItem('gemini_user_api_key');
          updateKeyStatus();
          showError("⚠️ Kiritilgan Gemini API kaliti noto'g'ri. Iltimos, aistudio.google.com/app/apikey dan yangi kalit oling.");
        } else {
          showError(`AI xatoligi: ${errMsg}`);
        }
      } finally {
        solveBtn!.removeAttribute('disabled');
        if (solveBtnText) solveBtnText.textContent = '🚀 Tahlil qilish va Yechish';
        if (solveBtnSpinner) solveBtnSpinner.style.display = 'none';
      }
    }

    solveBtn.addEventListener('click', () => handleSolve(currentMode === 'ai'));
    askAiDeeperBtn?.addEventListener('click', () => handleSolve(true));

    input.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        handleSolve(currentMode === 'ai');
      }
    });

    copySolutionBtn?.addEventListener('click', async () => {
      if (!lastRawSolutionText) return;
      try {
        await navigator.clipboard.writeText(lastRawSolutionText);
        const orig = copySolutionBtn.textContent;
        copySolutionBtn.textContent = '✅ Nusxalandi!';
        setTimeout(() => { copySolutionBtn.textContent = orig; }, 2000);
      } catch {}
    });

    printSolutionBtn?.addEventListener('click', () => window.print());
  }

  initAiSolver();
  document.addEventListener('astro:page-load', initAiSolver);
</script>
