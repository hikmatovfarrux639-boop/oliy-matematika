---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="AI Masala Yechuvchi va Mavzu Tashxisi — Oliy Matematika" 
  description="Oliy matematika bo'yicha ixtiyoriy misolni kiriting yoki rasmini yuklang — tizim uning qaysi mavzuga tegishli ekanini aniqlaydi, saytdagi kerakli darslarni tavsiya qiladi va qadamma-qadam yechib beradi."
>
  <div class="ai-solver-hero">
    <div class="ai-hero-header">
      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <span class="badge badge-active" style="display: inline-flex; align-items: center; gap: 0.35rem;">
          <span class="pulse-dot"></span> Tezkor Analitik Dvigatel + Gemini AI
        </span>
        <span style="font-size: 0.85rem; color: var(--text-subtle);">
          0.01s Mahalliy Yechim • Mavzu Tashxisi • Rasm Tahlili
        </span>
      </div>

      <button id="api-key-settings-btn" class="btn btn-secondary" style="font-size: 0.85rem; padding: 0.35rem 0.75rem;">
        ⚙️ Gemini API Kaliti <span id="api-key-status" class="key-status-dot not-set" title="Kalit belgilanmagan"></span>
      </button>
    </div>

    <h1 style="font-size: 2.1rem; font-weight: 800; margin: 0.75rem 0 0.5rem; color: var(--text-main);">
      🤖 AI Masala Yechuvchi va Mavzu Yo'llanmasi
    </h1>
    <p style="color: var(--text-muted); font-size: 1.02rem; max-width: 780px; line-height: 1.6;">
      Ixtiyoriy misolni yozing yoki daftardagi <strong>rasmini suratga olib yuklang</strong>. Tizim misolning <strong>qaysi mavzuga doir ekanini darhol aniqlab</strong>, saytdagi qaysi darsni o'qish kerakligini tavsiya qiladi va qadamma-qadam yechimini chiqarib beradi.
    </p>

    <!-- Error message alert -->
    <div id="ai-error-box" style="display: none; background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 0.85rem 1.25rem; border-radius: var(--radius-md); margin-top: 1rem; font-size: 0.95rem;">
      <span id="ai-error-text">Xatolik yuz berdi.</span>
    </div>

    <!-- MAIN INPUT CARD -->
    <div class="solver-input-card">
      <div class="input-controls-top">
        <label for="problem-input" style="font-weight: 700; color: var(--text-main); font-size: 0.95rem;">
          ✍️ Misol yoki funksiyani kiriting:
        </label>
        <div style="display: flex; align-items: center; gap: 1rem;">
          <label class="toggle-switch-label" title="Internetdagi ilmiy maqola va bazalardan qidirish">
            <input type="checkbox" id="google-search-toggle" />
            <span class="toggle-text">🌐 Google Qidiruv</span>
          </label>
        </div>
      </div>

      <textarea 
        id="problem-input" 
        rows="3" 
        placeholder="Masalan: x^2 - 5x + 6 = 0  yoki  x^3 * sin(x)  yoki  lim (x->0) sin(5x)/x  yoki  y'' - 5y' + 6y = 0..."
        class="problem-textarea"
      ></textarea>

      <!-- Action Mode Selector (Makes solving instant and super convenient!) -->
      <div class="mode-selector-bar">
        <span class="mode-label">Amal turi:</span>
        <div class="mode-pills" id="solver-mode-pills">
          <button type="button" class="mode-pill active" data-mode="auto">✨ Avtomatik aniqlash</button>
          <button type="button" class="mode-pill" data-mode="derivative">📐 Hosilasini topish</button>
          <button type="button" class="mode-pill" data-mode="integral">∫ Integralini topish</button>
          <button type="button" class="mode-pill" data-mode="limit">🎯 Limit (x → 0)</button>
          <button type="button" class="mode-pill" data-mode="ai">🧠 Gemini AI (Chuqur tahlil)</button>
        </div>
      </div>

      <!-- Quick Math Symbols Toolbar -->
      <div class="math-quick-bar">
        <span style="font-size: 0.75rem; color: var(--text-subtle); margin-right: 0.25rem;">Tezkor belgilar:</span>
        <button type="button" class="quick-sym" data-insert="x">x</button>
        <button type="button" class="quick-sym" data-insert="^2">x²</button>
        <button type="button" class="quick-sym" data-insert="^3">x³</button>
        <button type="button" class="quick-sym" data-insert="sqrt()">√x</button>
        <button type="button" class="quick-sym" data-insert="sin(x)">sin</button>
        <button type="button" class="quick-sym" data-insert="cos(x)">cos</button>
        <button type="button" class="quick-sym" data-insert="ln(x)">ln</button>
        <button type="button" class="quick-sym" data-insert="e^x">eˣ</button>
        <button type="button" class="quick-sym" data-insert="lim (x->0) ">lim</button>
        <button type="button" class="quick-sym" data-insert="int ">∫</button>
        <button type="button" class="quick-sym" data-insert="d/dx ">d/dx</button>
        <button type="button" class="quick-sym" data-insert="y'' - 5y' + 6y = 0">y''</button>
        <button type="button" class="quick-sym" data-insert="=">=</button>
      </div>

      <!-- SEPARATED FILE INPUTS -->
      <input type="file" id="camera-file-input" accept="image/*" capture="environment" style="display: none;" />
      <input type="file" id="gallery-file-input" accept="image/*" style="display: none;" />

      <!-- PHOTO & CAMERA SECTION -->
      <div class="image-upload-wrapper">
        <div class="upload-options-bar">
          <button type="button" id="camera-btn" class="photo-btn camera-btn">
            <span class="btn-icon">📸</span>
            <div class="btn-text-group">
              <strong>Kameradan suratga olish</strong>
              <small>Daftar yoki kitobdagi misolni rasmga oling</small>
            </div>
          </button>

          <button type="button" id="gallery-btn" class="photo-btn gallery-btn">
            <span class="btn-icon">📁</span>
            <div class="btn-text-group">
              <strong>Rasm / Skrinshot yuklash</strong>
              <small>Galereyadan misol rasmini tanlang (Ctrl+V)</small>
            </div>
          </button>
        </div>

        <!-- Image Preview (hidden by default) -->
        <div id="image-preview-container" class="image-preview-container" style="display: none;">
          <img id="image-preview" src="" alt="Yuklangan misol rasmi" />
          <div class="image-preview-info">
            <div style="display: flex; flex-direction: column;">
              <span id="image-name" style="font-size: 0.85rem; color: var(--text-main); font-weight: 700;">rasm.jpg</span>
              <span id="image-status-badge" style="font-size: 0.75rem; color: #10b981; font-weight: 600;">⚡ Tezkor yuborish uchun siqildi va tayyor!</span>
            </div>
            <button type="button" id="remove-image-btn" class="btn-remove-image" title="Rasmni o'chirish">
              ✕ O'chirish
            </button>
          </div>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="input-actions-bottom">
        <button type="button" id="clear-problem-btn" class="btn btn-secondary" style="font-size: 0.9rem;">
          🧹 Tozalash
        </button>
        <button type="button" id="solve-problem-btn" class="btn btn-primary btn-solve" style="font-size: 1.02rem; padding: 0.75rem 1.85rem;">
          <span id="solve-btn-text">🚀 Tahlil qilish va Yechish</span>
          <span id="solve-btn-spinner" class="spinner" style="display: none;"></span>
        </button>
      </div>
    </div>

    <!-- PRESETS: Quick 1-Click Samples -->
    <div class="presets-section">
      <span style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.65rem; display: block;">
        ⚡ Tayyor namunalarni 1 bosishda sinab ko'ring (0.01 soniyada ishlaydi):
      </span>
      <div class="presets-grid">
        <button type="button" class="preset-card" data-problem={'sin(x) = 1'}>
          <span class="preset-tag">1-modul: Trigonometriya</span>
          <span class="preset-math">{'\\sin(x) = 1'}</span>
        </button>
        <button type="button" class="preset-card" data-problem={'x^2 - 5x + 6 = 0'}>
          <span class="preset-tag">1-modul: Kvadrat tenglama</span>
          <span class="preset-math">{'x^2 - 5x + 6 = 0'}</span>
        </button>
        <button type="button" class="preset-card" data-problem={'d/dx (x^3 * sin(x) + 4*x^2)'}>
          <span class="preset-tag">7-modul: Hosila</span>
          <span class="preset-math">{'\\frac{d}{dx}(x^3 \\sin x + 4x^2)'}</span>
        </button>
        <button type="button" class="preset-card" data-problem={'lim (x->0) (1 - cos(4*x)) / (x^2)'}>
          <span class="preset-tag">5-modul: Limit (0/0)</span>
          <span class="preset-math">{'\\lim_{x \\to 0} \\frac{1 - \\cos 4x}{x^2}'}</span>
        </button>
        <button type="button" class="preset-card" data-problem={'\\int x \\cdot \\cos(2x) \\, dx'}>
          <span class="preset-tag">8-modul: Bo'laklab integral</span>
          <span class="preset-math">{'\\int x \\cos(2x) \\, dx'}</span>
        </button>
        <button type="button" class="preset-card" data-problem={"y'' - 5y' + 6y = 0"}>
          <span class="preset-tag">12-modul: Diff. tenglama</span>
          <span class="preset-math">{"y'' - 5y' + 6y = 0"}</span>
        </button>
        <button type="button" class="preset-card" data-problem={'[[2, 1, -1], [3, 0, 2], [1, -2, 1]]'}>
          <span class="preset-tag">2-modul: 3x3 Determinant</span>
          <span class="preset-math">{'\\det A_{3\\times 3}'}</span>
        </button>
        <button type="button" class="preset-card" data-problem={'2x + y = 7, x - y = 2'}>
          <span class="preset-tag">2-modul: Kramer sistemasi</span>
          <span class="preset-math">{'\\begin{cases} 2x+y=7 \\\\ x-y=2 \\end{cases}'}</span>
        </button>
        <button type="button" class="preset-card" data-problem={'(1 + i\\sqrt{3})^{12}'}>
          <span class="preset-tag">4-modul: Muavr formulasi</span>
          <span class="preset-math">{'(1 + i\\sqrt{3})^{12}'}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 1. SMART TOPIC DIAGNOSIS & COURSE NAVIGATOR CARD -->
  <div id="topic-diagnosis-card" class="diagnosis-card" style="display: none;">
    <!-- Populated dynamically in 0.01s -->
  </div>

  <!-- 2. SOLUTION OUTPUT CONTAINER -->
  <div id="solution-container" class="solution-container" style="display: none;">
    <div class="solution-header">
      <div style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap;">
        <span style="font-size: 1.5rem;">📝</span>
        <div>
          <h2 id="solution-title-heading" style="font-size: 1.35rem; font-weight: 800; color: var(--text-main); margin: 0;">
            Qadamma-qadam Yechim
          </h2>
          <span id="solution-engine-badge" style="font-size: 0.78rem; color: #10b981; font-weight: 600;">
            ⚡ Analitik dvigatel orqali 0.01 soniyada yechildi
          </span>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <button type="button" id="ask-ai-deeper-btn" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.35rem 0.75rem; border-color: var(--primary); color: var(--primary);">
          🤖 Gemini AI dan yana-da batafsil so'rash
        </button>
        <button type="button" id="copy-solution-btn" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.35rem 0.65rem;">
          📋 Nusxalash
        </button>
        <button type="button" id="print-solution-btn" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.35rem 0.65rem;">
          🖨️ Chop etish (PDF)
        </button>
      </div>
    </div>

    <!-- Grounding Web Sources (if used) -->
    <div id="grounding-sources" style="display: none; margin-bottom: 1rem; padding: 0.75rem 1rem; background: var(--bg-muted); border-radius: var(--radius-md); font-size: 0.85rem; border: 1px solid var(--border-color);">
      <span style="font-weight: 700; color: var(--primary);">🌐 Google Qidiruv Manbalari:</span>
      <ul id="sources-list" style="margin: 0.5rem 0 0 1.25rem; padding: 0; color: var(--text-muted);"></ul>
    </div>

    <!-- Solution Body (Rendered with KaTeX and Markdown) -->
    <div id="solution-body" class="solution-body markdown-body">
      <!-- Generated solution goes here -->
    </div>
  </div>

  <!-- MODAL: WEBCAM LIVE CAPTURE -->
  <div id="webcam-modal-backdrop" class="modal-backdrop" style="display: none;">
    <div class="modal-dialog" style="max-width: 580px;">
      <div class="modal-header">
        <h3 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--text-main);">
          📸 Kamera orqali misolni suratga olish
        </h3>
        <button type="button" id="webcam-close-btn" class="btn-close" aria-label="Yopish">✕</button>
      </div>
      <div class="modal-body" style="text-align: center;">
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">
          Daftar yoki kitobdagi misolni kamera ro'parasiga to'g'rilab, "Suratga olish" tugmasini bosing:
        </p>
        <div style="position: relative; border-radius: var(--radius-md); overflow: hidden; background: #0f172a; aspect-ratio: 4/3; max-height: 340px; margin: 0 auto; display: flex; align-items: center; justify-content: center;">
          <video id="webcam-video" autoplay playsinline style="width: 100%; height: 100%; object-fit: cover;"></video>
          <canvas id="webcam-canvas" style="display: none;"></canvas>
          <div id="webcam-loading-spinner" style="position: absolute; color: white; font-size: 0.9rem;">
            Kamera ishga tushirilmoqda...
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" id="webcam-cancel-btn" class="btn btn-secondary" style="font-size: 0.85rem;">
          Bekor qilish
        </button>
        <button type="button" id="webcam-snap-btn" class="btn btn-primary" style="font-size: 0.95rem; font-weight: 700; padding: 0.5rem 1.5rem;">
          📸 Suratga olish
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL: API KEY CONFIGURATION -->
  <div id="api-modal-backdrop" class="modal-backdrop" style="display: none;">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 style="font-size: 1.2rem; font-weight: 700; margin: 0; color: var(--text-main);">
          ⚙️ Gemini API Kaliti Sozlamalari
        </h3>
        <button type="button" id="modal-close-btn" class="btn-close" aria-label="Yopish">✕</button>
      </div>
      <div class="modal-body">
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1rem;">
          Barcha asosiy matematik misollar (tenglamalar, hosilalar, limitlar, integrallar, matritsalar, differensial tenglamalar) va <strong>mavzu tashxisi 100% bepul va kalitsiz</strong> ishlaydi. Faqat rasmdagi qo'lyozmalarni o'qish uchun Google Gemini bepul kalitidan foydalaniladi.
        </p>

        <div style="background: var(--bg-muted); padding: 0.75rem 1rem; border-radius: var(--radius-md); margin-bottom: 1rem; font-size: 0.85rem; border: 1px solid var(--border-color);">
          <strong>1 daqiqada bepul kalit olish:</strong>
          <ol style="margin: 0.35rem 0 0 1.25rem; padding: 0;">
            <li><a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener" style="color: var(--primary); font-weight: 600;">aistudio.google.com/app/apikey</a> saytiga kiring.</li>
            <li>Google akkauntingiz bilan kiring va <strong>"Create API key"</strong> tugmasini bosing.</li>
            <li>Hosil bo'lgan kalitni nusxalab, quyidagi maydonga qo'ying.</li>
          </ol>
        </div>

        <label for="api-key-input" style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.35rem; color: var(--text-main);">
          Sizning Gemini API Kalitingiz:
        </label>
        <input 
          type="password" 
          id="api-key-input" 
          placeholder="AIzaSy..." 
          style="width: 100%; padding: 0.65rem 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-surface); color: var(--text-main); font-family: var(--font-mono); font-size: 0.95rem; margin-bottom: 0.5rem;"
        />
        <div style="font-size: 0.75rem; color: var(--text-subtle);">
          🔒 Kalitingiz faqat o'zingizning brauzeringiz xotirasida (localStorage) saqlanadi.
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" id="remove-key-btn" class="btn btn-secondary" style="font-size: 0.85rem; color: #dc2626;">
          Kalitni o'chirish
        </button>
        <button type="button" id="save-key-btn" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.5rem 1.25rem;">
          Saqlash
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .ai-solver-hero {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .ai-hero-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    display: inline-block;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulseAnimation 1.8s infinite;
  }

  @keyframes pulseAnimation {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .key-status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-left: 0.25rem;
  }
  .key-status-dot.set { background: #10b981; }
  .key-status-dot.not-set { background: #f59e0b; }

  /* Input Card */
  .solver-input-card {
    margin-top: 1.25rem;
    background: var(--bg-muted);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .input-controls-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }

  .toggle-switch-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    user-select: none;
  }

  .problem-textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--border-color);
    background: var(--bg-surface);
    color: var(--text-main);
    font-family: var(--font-mono);
    font-size: 1rem;
    resize: vertical;
    transition: border-color 0.15s ease;
  }
  .problem-textarea:focus {
    outline: none;
    border-color: var(--primary);
  }

  /* Mode Selector Bar */
  .mode-selector-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed var(--border-color);
  }
  .mode-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
  }
  .mode-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .mode-pill {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border-color);
    background: var(--bg-surface);
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .mode-pill:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .mode-pill.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #ffffff;
  }

  /* Quick Symbols Bar */
  .math-quick-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.65rem;
  }
  .quick-sym {
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    border: 1px solid var(--border-color);
    background: var(--bg-surface);
    color: var(--text-main);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.12s ease;
  }
  .quick-sym:hover {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }

  /* Photo Upload Section */
  .image-upload-wrapper {
    margin-top: 0.9rem;
  }
  .upload-options-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 0.65rem;
  }
  .photo-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--bg-surface);
    color: var(--text-main);
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
  }
  .photo-btn:hover {
    border-color: var(--primary);
    background: var(--primary-light);
  }
  .btn-icon {
    font-size: 1.45rem;
  }
  .btn-text-group {
    display: flex;
    flex-direction: column;
  }
  .btn-text-group strong {
    font-size: 0.88rem;
    color: var(--text-main);
  }
  .btn-text-group small {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .image-preview-container {
    margin-top: 0.75rem;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid #10b981;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .image-preview-container img {
    height: 68px;
    width: auto;
    max-width: 120px;
    object-fit: cover;
    border-radius: 4px;
