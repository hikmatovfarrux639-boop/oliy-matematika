</style>

<script>
  import katex from 'katex';
  import { solveLocally, diagnoseTopic, type TopicDiagnosis } from '../utils/localSolver';

  function initAiSolver() {
    const input = document.getElementById('problem-input') as HTMLTextAreaElement | null;
    const solveBtn = document.getElementById('solve-problem-btn');
    const solveBtnText = document.getElementById('solve-btn-text');
    const solveBtnSpinner = document.getElementById('solve-btn-spinner');
    const clearBtn = document.getElementById('clear-problem-btn');
    const searchToggle = document.getElementById('google-search-toggle') as HTMLInputElement | null;

    const cameraBtn = document.getElementById('camera-btn');
    const galleryBtn = document.getElementById('gallery-btn');
    const cameraInput = document.getElementById('camera-file-input') as HTMLInputElement | null;
    const galleryInput = document.getElementById('gallery-file-input') as HTMLInputElement | null;
    const previewContainer = document.getElementById('image-preview-container');
    const imagePreview = document.getElementById('image-preview') as HTMLImageElement | null;
    const imageName = document.getElementById('image-name');
    const removeImageBtn = document.getElementById('remove-image-btn');

    const errorBox = document.getElementById('ai-error-box');
    const errorText = document.getElementById('ai-error-text');
    const diagnosisCard = document.getElementById('topic-diagnosis-card');
    const solutionContainer = document.getElementById('solution-container');
    const solutionBody = document.getElementById('solution-body');
    const solutionEngineBadge = document.getElementById('solution-engine-badge');
    const askAiDeeperBtn = document.getElementById('ask-ai-deeper-btn');
    const copySolutionBtn = document.getElementById('copy-solution-btn');
    const printSolutionBtn = document.getElementById('print-solution-btn');
    const groundingContainer = document.getElementById('grounding-sources');
    const sourcesList = document.getElementById('sources-list');

    const apiKeyModal = document.getElementById('api-modal-backdrop');
    const apiKeySettingsBtn = document.getElementById('api-key-settings-btn');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const apiKeyInput = document.getElementById('api-key-input') as HTMLInputElement | null;
    const saveKeyBtn = document.getElementById('save-key-btn');
    const removeKeyBtn = document.getElementById('remove-key-btn');
    const apiKeyStatus = document.getElementById('api-key-status');
    const apiKeyBtnLabel = document.getElementById('api-key-btn-label');

    if (!input || !solveBtn) return;
    if ((input as any)._hasAiSolverInitialized) return;
    (input as any)._hasAiSolverInitialized = true;

    let selectedImageBase64: string | null = null;
    let selectedImageMime: string | null = null;
    let currentMode: string = 'auto';
    let currentPedagogy: string = 'solution';
    let lastRawSolutionText = '';
    let lastProblemText = '';

    // Render KaTeX on preset buttons
    document.querySelectorAll('.preset-math').forEach(el => {
      const txt = (el.textContent || '').trim();
      if (!txt) return;
      try {
        katex.render(txt.replace(/^\$+|\$+$/g, ''), el as HTMLElement, { throwOnError: false, displayMode: false });
      } catch {}
    });

    // Mode Selector Pills
    document.querySelectorAll('.mode-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.mode-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentMode = (pill as HTMLElement).dataset.mode || 'auto';
        if (input.value.trim() || selectedImageBase64) {
          handleSolve(currentMode === 'ai');
        }
      });
    });

    // Pedagogy Mode Pills (Solution vs Socratic vs Check)
    document.querySelectorAll('.pedagogy-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.pedagogy-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentPedagogy = (pill as HTMLElement).dataset.pedagogy || 'solution';
        if (input.value.trim() || selectedImageBase64) {
          handleSolve(true);
        }
      });
    });

    // Direct URL parameter deep-linking (e.g. from HEMIS Quiz error review or course links)
    const urlParams = new URLSearchParams(window.location.search);
    const queryParam = urlParams.get('q');
    const pedagogyParam = urlParams.get('pedagogy') || urlParams.get('mode');
    if (pedagogyParam && ['solution', 'socratic', 'check'].includes(pedagogyParam)) {
      currentPedagogy = pedagogyParam;
      document.querySelectorAll('.pedagogy-pill').forEach(p => {
        p.classList.toggle('active', (p as HTMLElement).dataset.pedagogy === currentPedagogy);
      });
    }
    if (queryParam) {
      input.value = queryParam;
      setTimeout(() => {
        handleSolve(true);
      }, 300);
    }

    // API Key status: supports secure serverless proxy or optional custom personal key
    function getUserApiKey(): string {
      return localStorage.getItem('gemini_user_api_key') || '';
    }

    function updateKeyStatus() {
      const userKey = getUserApiKey();
      if (userKey && userKey.trim()) {
        apiKeyStatus?.classList.remove('not-set');
        apiKeyStatus?.classList.add('set');
        if (apiKeyStatus) apiKeyStatus.setAttribute('title', '🔑 Shaxsiy Gemini API kaliti kiritilgan');
        if (apiKeyBtnLabel) apiKeyBtnLabel.textContent = '🔑 Shaxsiy Kalit';
      } else {
        apiKeyStatus?.classList.remove('not-set');
        apiKeyStatus?.classList.add('set');
        if (apiKeyStatus) apiKeyStatus.setAttribute('title', "⚡ Serverless AI bulutli yechuvchi");
        if (apiKeyBtnLabel) apiKeyBtnLabel.textContent = '⚡ Serverless AI Rejimi';
      }
    }
    updateKeyStatus();

    apiKeySettingsBtn?.addEventListener('click', () => {
      if (!apiKeyModal || !apiKeyInput) return;
      apiKeyInput.value = localStorage.getItem('gemini_user_api_key') || '';
      apiKeyModal.style.display = 'flex';
      apiKeyInput.focus();
    });
    modalCloseBtn?.addEventListener('click', () => { if (apiKeyModal) apiKeyModal.style.display = 'none'; });
    apiKeyModal?.addEventListener('click', (e) => { if (e.target === apiKeyModal) apiKeyModal.style.display = 'none'; });

    saveKeyBtn?.addEventListener('click', () => {
      const key = apiKeyInput?.value.trim() || '';
      if (key) localStorage.setItem('gemini_user_api_key', key);
      else localStorage.removeItem('gemini_user_api_key');
      updateKeyStatus();
      if (apiKeyModal) apiKeyModal.style.display = 'none';
    });

    removeKeyBtn?.addEventListener('click', () => {
      localStorage.removeItem('gemini_user_api_key');
      if (apiKeyInput) apiKeyInput.value = '';
      updateKeyStatus();
      if (apiKeyModal) apiKeyModal.style.display = 'none';
    });

    // Quick symbols
    document.querySelectorAll('.quick-sym').forEach(btn => {
      btn.addEventListener('click', () => {
        const sym = (btn as HTMLElement).dataset.insert || '';
        const start = input.selectionStart ?? input.value.length;
        const end = input.selectionEnd ?? input.value.length;
        const text = input.value;
        input.value = text.substring(0, start) + sym + text.substring(end);
        input.setSelectionRange(start + sym.length, start + sym.length);
        input.focus();
      });
    });

    // Presets 1-click
    document.querySelectorAll('.preset-card').forEach(btn => {
      btn.addEventListener('click', () => {
        const prob = (btn as HTMLElement).dataset.problem || '';
        input.value = prob;
        handleSolve(false);
      });
    });

    // FAST CLIENT-SIDE IMAGE COMPRESSION (Reduces 6MB photo to ~90KB in 40ms!)
    function compressAndLoadImage(file: File) {
      if (!file.type.startsWith('image/')) {
        showError('Faqat rasm fayllarini (JPG, PNG, WebP) yuklash mumkin.');
        return;
      }
      hideError();

      const reader = new FileReader();
      reader.onload = (e) => {
        const dataUrl = e.target?.result as string;
        const img = new Image();
        img.onload = () => {
          const MAX_DIM = 900;
          let w = img.width;
          let h = img.height;
          if (w > MAX_DIM || h > MAX_DIM) {
            if (w > h) {
              h = Math.round((h * MAX_DIM) / w);
              w = MAX_DIM;
            } else {
              w = Math.round((w * MAX_DIM) / h);
              h = MAX_DIM;
            }
          }
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx?.drawImage(img, 0, 0, w, h);

          const compressedUrl = canvas.toDataURL('image/jpeg', 0.75);
          selectedImageBase64 = compressedUrl.split(',')[1];
          selectedImageMime = 'image/jpeg';

          if (imagePreview && previewContainer && imageName) {
            imagePreview.src = compressedUrl;
            const sizeKb = Math.round((selectedImageBase64.length * 3) / 4 / 1024);
            imageName.textContent = `${file.name} (${sizeKb} KB — optimallashtirildi)`;
            previewContainer.style.display = 'flex';
          }
        };
        img.src = dataUrl;
      };
      reader.readAsDataURL(file);
    }

    // Direct Native Camera & File Gallery Triggers
    cameraBtn?.addEventListener('click', () => {
      cameraInput?.click();
    });

    galleryBtn?.addEventListener('click', () => {
      galleryInput?.click();
    });

    // DRAG AND DROP IMAGE
    const dropCard = document.querySelector('.solver-input-card') as HTMLElement | null;
    if (dropCard) {
      ['dragenter', 'dragover'].forEach(name => {
        dropCard.addEventListener(name, (e) => {
          e.preventDefault();
          dropCard.style.borderColor = '#38bdf8';
          dropCard.style.boxShadow = '0 0 16px rgba(56, 189, 248, 0.25)';
        });
      });
      ['dragleave', 'drop'].forEach(name => {
        dropCard.addEventListener(name, (e) => {
          e.preventDefault();
          dropCard.style.borderColor = '';
          dropCard.style.boxShadow = '';
        });
      });
      dropCard.addEventListener('drop', (e) => {
        const files = (e as DragEvent).dataTransfer?.files;
        if (files && files[0] && files[0].type.startsWith('image/')) {
          compressAndLoadImage(files[0]);
        }
      });
    }

    // VOICE RECOGNITION (SPEECH-TO-TEXT)
    const voiceBtn = document.getElementById('voice-input-btn');
    const voiceBtnText = document.getElementById('voice-btn-text');
    let isListening = false;
    const SpeechRec = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    if (SpeechRec) {
      const recognizer = new SpeechRec();
      recognizer.continuous = false;
      recognizer.interimResults = true;
      recognizer.lang = 'uz-UZ';

      function cleanSpokenMath(text: string): string {
        let s = text.toLowerCase();

        // Cyrillic homoglyphs
        s = s.replace(/х/g, 'x').replace(/у/g, 'y').replace(/а/g, 'a').replace(/е/g, 'e').replace(/о/g, 'o').replace(/р/g, 'p').replace(/с/g, 'c');

        s = s.replace(/\byteng\b/gi, 'y = ')
             .replace(/\by\s*teng\b/gi, 'y = ')
             .replace(/\bxteng\b/gi, 'x = ')
             .replace(/\bx\s*teng\b/gi, 'x = ')
             .replace(/teng(?=[\d\s+\-a-zA-Z]|$)/gi, ' = ')
             .replace(/barobar(?=[\d\s+\-a-zA-Z]|$)/gi, ' = ')
             .replace(/ravno(?=[\d\s+\-a-zA-Z]|$)/gi, ' = ')
             .replace(/([a-z0-9])\s*(?:ning\s*)?kvadrati?\b/gi, '$1^2')
             .replace(/([a-z0-9])\s*(?:ning\s*)?kubi?\b/gi, '$1^3')
             .replace(/\bkvadrat\b|\bkvadrati\b/gi, '^2')
             .replace(/\bkub\b|\bkubi\b/gi, '^3')
             .replace(/\bplyus\b|\bqo'shuv\b|\bqo'shilgan\b|\bplus\b/gi, ' + ')
             .replace(/\bminus\b|\bayiruv\b|\bayirilgan\b/gi, ' - ')
             .replace(/\bko'paytirilgan\b|\bko'paytiruv\b|\bzarb\b/gi, ' * ')
             .replace(/\bbo'lingan\b|\bbo'luv\b|\btaqsim\b/gi, ' / ')
             .replace(/\bildiz\s*(?:ostida)?\s*\(([^)]+)\)/gi, 'sqrt($1)')
             .replace(/\bildiz\s*(?:ostida)?\s*([a-zA-Z0-9]+)/gi, 'sqrt($1)')
             .replace(/\bmodul\s*\(([^)]+)\)/gi, 'abs($1)')
             .replace(/\bmodul\s*([a-zA-Z0-9]+)/gi, 'abs($1)')
             .replace(/\^\s*([+\-])/g, '^2 $1')
             .replace(/\^\s*$/g, '^2');

        const numWords: Record<string, string> = {
          'nol': '0', 'bir': '1', 'ikki': '2', 'uch': '3', 'to\'rt': '4', 'tort': '4',
          'besh': '5', 'olti': '6', 'yetti': '7', 'sakkiz': '8', 'to\'qqiz': '9', 'toqqiz': '9', 'o\'n': '10', 'on': '10'
        };
        for (const [w, n] of Object.entries(numWords)) {
          s = s.replace(new RegExp('\\b' + w + '\\b', 'gi'), n);
        }

        s = s.replace(/(?<![<>!:])\s*=\s*/g, ' = ')
             .replace(/<\s*=/g, '<=')
             .replace(/>\s*=/g, '>=')
             .replace(/\s+/g, ' ')
             .trim();
        return s;
      }

      recognizer.onstart = () => {
        isListening = true;
        voiceBtn?.classList.add('recording');
        if (voiceBtnText) voiceBtnText.textContent = 'Eshityapman...';
      };
      recognizer.onresult = (ev: any) => {
        let str = '';
        for (let i = ev.resultIndex; i < ev.results.length; i++) {
          str += ev.results[i][0].transcript;
        }
        if (str && input) {
          input.value = cleanSpokenMath(str);
        }
      };
      recognizer.onerror = () => {
        isListening = false;
        voiceBtn?.classList.remove('recording');
        if (voiceBtnText) voiceBtnText.textContent = 'Ovoz bilan aytish';
      };
      recognizer.onend = () => {
        isListening = false;
        voiceBtn?.classList.remove('recording');
        if (voiceBtnText) voiceBtnText.textContent = 'Ovoz bilan aytish';
      };

      voiceBtn?.addEventListener('click', () => {
        if (isListening) {
          recognizer.stop();
        } else {
          try {
            recognizer.start();
          } catch {
            recognizer.lang = 'ru-RU';
            recognizer.start();
          }
        }
      });
    } else {
      if (voiceBtn) voiceBtn.style.display = 'none';
    }

    // VOICE READOUT (TEXT-TO-SPEECH)
    const voiceSpeakBtn = document.getElementById('voice-speak-solution-btn');
    let isSpeaking = false;
    voiceSpeakBtn?.addEventListener('click', () => {
      if (!('speechSynthesis' in window)) {
        alert("Brauzeringiz ovoz chiqarishni qo'llab-quvvatlamaydi.");
        return;
      }
      if (isSpeaking) {
        window.speechSynthesis.cancel();
        isSpeaking = false;
        if (voiceSpeakBtn) voiceSpeakBtn.textContent = '🔊 Ovozli tushuntirish';
        return;
      }

      const rawText = solutionBody?.textContent || '';
      if (!rawText.trim()) return;

      const clean = rawText
        .replace(/\\frac\{([^}]+)\}\{([^}]+)\}/g, '$1 taqsim $2')
        .replace(/\^2/g, ' kvadrat')
        .replace(/\^3/g, ' kub')
        .replace(/\\int/g, 'integral ')
        .replace(/\\lim/g, 'limit ')
        .replace(/[\\${}]/g, '')
        .slice(0, 800);

      const u = new SpeechSynthesisUtterance(clean);
      u.rate = 1.0;
      const voices = window.speechSynthesis.getVoices();
      const v = voices.find(x => x.lang.startsWith('uz') || x.lang.startsWith('tr') || x.lang.startsWith('ru'));
      if (v) u.voice = v;

      u.onstart = () => {
        isSpeaking = true;
        if (voiceSpeakBtn) voiceSpeakBtn.textContent = '⏹️ To\'xtatish';
      };
      u.onend = () => {
        isSpeaking = false;
        if (voiceSpeakBtn) voiceSpeakBtn.textContent = '🔊 Ovozli tushuntirish';
      };
      u.onerror = () => {
        isSpeaking = false;
        if (voiceSpeakBtn) voiceSpeakBtn.textContent = '🔊 Ovozli tushuntirish';
      };
      window.speechSynthesis.speak(u);
    });

