   - [Matritsalar va amallar](/dars/chiziqli-algebra/matritsalar-tushunchasi-va-chiziqli-amallar)
   - [Determinantlar va xossalari](/dars/chiziqli-algebra/determinantlar-va-geometrik-manosi)
   - [Chiziqli tenglamalar sistemasi va Kramer qoidasi](/dars/chiziqli-algebra/chiziqli-tenglamalar-sistemasi-va-kronekker-kapelli)
   - [Gauss usuli](/dars/chiziqli-algebra/gauss-usuli-pogonasimon-va-teskari-yurish)
   - [Skalyar ko'paytma](/dars/vektorlar-geometriya/skalyar-kopaytma)
   - [Vektor va aralash ko'paytma](/dars/vektorlar-geometriya/vektor-va-aralash-kopaytma)
   - [Muavr formulasi va kompleks sonlar](/dars/kompleks-sonlar/muavr-formulasi-va-ildiz-chiqarish)
   - [Aniqmasliklar (0/0 va ∞/∞) va ularni ochish](/dars/limitlar/aniqmasliklar-va-ularni-ochish)
   - [Ajoyib limitlar](/dars/limitlar/ajoyib-limitlar)
   - [Funksiyani tekshirish va grafik yasash](/dars/funksiyalar-grafiklar/funksiyani-tekshirish-va-grafik-yasash)
   - [Differensiallash qoidalari va jadvali](/dars/hosila/differensiallash-qoidalari-va-jadval)
   - [Murakkab funksiya hosilasi](/dars/hosila/murakkab-funksiya-hosilasi)
   - [Lopital qoidasi](/dars/hosila/lopital-qoidasi)
   - [Boshlang'ich funksiya va aniqmas integral](/dars/integrallar/boshlangich-funksiya-va-aniqmas-integral)
   - [O'zgaruvchini almashtirish usuli](/dars/integrallar/integrallash-usullari-almashtirish)
   - [Bo'laklab integrallash usuli](/dars/integrallar/bolaklab-integrallash)
   - [Aniq integral va Nyuton-Leybnits formulasi](/dars/integrallar/aniq-integral-va-nyuton-leybnits)
   - [Xususiy hosilalar](/dars/kop-ozgaruvchili-funksiyalar/xususiy-hosilalar)
   - [Ikki karrali integral](/dars/karrali-integrallar/ikki-karrali-integral-va-hisoblash)
   - [Musbat hadli qatorlar: Dalamber va Koshi alomatlari](/dars/qatorlar/musbat-hadli-qatorlar-alomatlari)
   - [O'zgaruvchilari ajraladigan differensial tenglamalar](/dars/differensial-tenglamalar/ozgaruvchilari-ajraladigan-tenglamalar)
   - [2-tartibli o'zgarmas koeffitsiyentli differensial tenglamalar](/dars/differensial-tenglamalar/ikkinchi-tartibli-chiziqli-differensial-tenglamalar)
   - [Kombinatorika va klassik ehtimollik](/dars/ehtimollar-nazariyasi/kombinatorika-va-klassik-ehtimollik)`;
        }

        const parts: any[] = [];
        if (selectedImageBase64 && selectedImageMime) {
          parts.push({
            inlineData: {
              mimeType: selectedImageMime,
              data: selectedImageBase64
            }
          });
        }

        let queryText = '';
        if (currentPedagogy === 'socratic') {
          queryText = problemText
            ? `Quyidagi misol bo'yicha meni Sokratik repetitorlik metodi orqali doskaga va og'zaki imtihonga tayyorlang (tayyor javobni darhol aytmang!):\n${problemText}`
            : `Rasmdagi misol bo'yicha meni Sokratik repetitorlik metodi orqali doskaga va og'zaki imtihonga tayyorlang (tayyor javobni darhol aytmang!).`;
        } else if (currentPedagogy === 'check') {
          queryText = problemText
            ? `Quyida mening bajargan yechimim berilgan. Undagi xatolarni sinchkovlik bilan tekshirib, qaysi bosqichda adashganimni ko'rsatib bering:\n${problemText}`
            : `Rasmdagi yechimimni tekshirib, qaysi bosqichda xato ketganini aniqlab bering.`;
        } else {
          queryText = problemText
            ? `Misolni daftarga ko'chirishga qulay rasmiy akademik formatda, qadamma-qadam yeching va saytdagi mos darsni tavsiya qiling:\n${problemText}`
            : `Rasmdagi misolni o'qib, daftarga ko'chirishga qulay rasmiy formatda qadamma-qadam yeching va saytdagi mos darsni tavsiya qiling.`;
        }
        parts.push({ text: queryText });

        let data: any = null;
        let lastErrorMsg = '';

        const requestPayload: any = {
          contents: [{ parts }],
          systemInstruction: { parts: [{ text: systemPrompt }] },
          generationConfig: {
            temperature: 0.15,
            maxOutputTokens: 1200
          },
          model: 'gemini-flash-lite-latest'
        };
        if (useGoogleSearch) {
          requestPayload.tools = [{ google_search: {} }];
        }

        // 1. Try secure backend serverless proxy
        try {
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 45000);

          const headers: Record<string, string> = { 'Content-Type': 'application/json' };
          if (userCustomKey) {
            headers['x-user-gemini-key'] = userCustomKey;
          }

          const proxyRes = await fetch('/api/solve', {
            method: 'POST',
            headers,
            body: JSON.stringify(requestPayload),
            signal: controller.signal
          });
          clearTimeout(timeoutId);

          if (proxyRes.ok) {
            data = await proxyRes.json();
          } else {
            const errJson = await proxyRes.json().catch(() => ({}));
            lastErrorMsg = errJson?.error?.message || errJson?.error || `Server xatoligi (${proxyRes.status})`;
          }
        } catch (proxyErr: any) {
          lastErrorMsg = proxyErr.message || String(proxyErr);
        }

        // 2. Fallback: If proxy is unreachable (e.g. local static dev) and user provided their own key
        if (!data && userCustomKey) {
          for (const modelName of ['gemini-flash-lite-latest', 'gemini-flash-latest', 'gemini-pro-latest', 'gemini-3.8-flash']) {
            try {
              const controller = new AbortController();
              const timeoutId = setTimeout(() => controller.abort(), 15000);
              const directEndpoint = `https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${userCustomKey}`;
              const directRes = await fetch(directEndpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  system_instruction: { parts: [{ text: systemPrompt }] },
                  contents: [{ parts }],
                  generationConfig: { temperature: 0.15 }
                }),
                signal: controller.signal
              });
              clearTimeout(timeoutId);
              if (directRes.ok) {
                const candidateJson = await directRes.json();
                if (candidateJson?.candidates?.[0]) {
                  data = candidateJson;
                  break;
                }
              }
            } catch (e: any) {
              lastErrorMsg = e.message || String(e);
            }
          }
        }

        if (!data || !data.candidates?.[0]) {
          throw new Error(lastErrorMsg || "Gemini serveriga ulanib bo'lmadi.");
        }

        const candidate = data.candidates?.[0];
        const partsList = candidate?.content?.parts || [];
        const nonThoughtTexts = partsList
          .filter((p: any) => !p.thought && p.text)
          .map((p: any) => p.text);

        const rawText = nonThoughtTexts.length > 0
          ? nonThoughtTexts.join('\n\n')
          : (partsList[0]?.text || "Yechim hosil qilib bo'lmadi.");
        lastRawSolutionText = rawText;

        // Also update and show the diagnosis card below the solution based on the recognized math text!
        const textForDiagnosis = problemText || rawText.slice(0, 450);
        const aiDiag = diagnoseTopic(textForDiagnosis);
        renderDiagnosisCard(aiDiag);

        // Render Grounding Sources if Google Search was used
        const groundingChunks = candidate?.groundingMetadata?.groundingChunks || [];
        if (groundingContainer && sourcesList) {
          if (groundingChunks.length > 0) {
            sourcesList.innerHTML = groundingChunks
              .map((c: any) => {
                const title = c.web?.title || c.web?.uri || 'Manba';
                const uri = c.web?.uri || '#';
                return `<li style="margin-bottom: 0.25rem;"><a href="${uri}" target="_blank" rel="noopener" style="color: var(--primary); text-decoration: underline;">${title}</a></li>`;
              })
              .join('');
            groundingContainer.style.display = 'block';
          } else {
            groundingContainer.style.display = 'none';
          }
        }

        // Hybrid Cross-Verification: Check if local math solver also verified the problem
        let verificationNotice = '';
        if (problemText && localResult.solved) {
          const summaryBadge = localResult.shortAnswer || localResult.type || 'Analitik tasdiqlangan';
          const renderedBadge = summaryBadge.includes('\\') || summaryBadge.includes('=')
            ? renderMathText(`$${summaryBadge.replace(/^\$+|\$+$/g, '')}$`)
            : `<code style="font-weight: 700; color: var(--primary);">${summaryBadge}</code>`;
          verificationNotice = `
            <div style="margin-bottom: 1.25rem; background: rgba(16, 185, 129, 0.1); border: 1.5px solid rgba(16, 185, 129, 0.4); border-radius: var(--radius-md); padding: 0.75rem 1rem; display: flex; align-items: center; gap: 0.75rem;">
              <span style="font-size: 1.35rem;">✅</span>
              <div style="font-size: 0.9rem; line-height: 1.45; color: var(--text-main);">
                <strong style="color: #10b981;">Mashinaviy Gibrid Tekshiruv:</strong> Mahalliy matematik yadro ushbu masalani parallel hisobladi va tasdiqladi: ${renderedBadge}.
              </div>
            </div>
          `;
        }

        if (solutionBody) {
          solutionBody.innerHTML = verificationNotice + renderMathMarkdown(rawText);
        }
        if (solutionEngineBadge) {
          solutionEngineBadge.innerHTML = selectedImageBase64
            ? '📷 Gemini AI Vision (Rasmdan o\'qilgan va yechilgan) • To\'liq akademik tahlil'
            : '🛡️ Xavfsiz Gemini AI Pro Serveri orqali chuqur tahlil qilindi';
        }

        if (solutionContainer) {
          solutionContainer.style.display = 'block';
          solutionContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        if (diagnosisCard) {
          diagnosisCard.style.display = 'block';
        }
      } catch (err: any) {
        const errMsg = err.message || '';
        // If user entered an invalid custom key, clear it
        if (userCustomKey && (errMsg.includes('API key') || errMsg.includes('API_KEY_INVALID') || errMsg.includes('401'))) {
          localStorage.removeItem('gemini_user_api_key');
          updateKeyStatus();
        }

        // Graceful Academic Deep-Dive Fallback when Cloud AI is unavailable / unconfigured
        if (problemText && !selectedImageBase64) {
          const diag = localResult.diagnosis;
          const formulasMd = (diag.keyFormulas || [])
            .map((f) => `- **${f.name}:**\n$$${f.latex}$$`)
            .join('\n');
          const relatedLinksMd = [diag.primaryLesson, ...(diag.relatedLessons || [])]
            .filter(Boolean)
            .map((l) => `- [${l.title}](${l.url})`)
            .join('\n');

          const deepAcademicMd = [
            localResult.solved && localResult.markdown
              ? localResult.markdown
              : `## 1. Masala sharti va mavzu tashxisi\nBerilgan ifoda: \`${problemText}\`\nUshbu masala **${diag.moduleTitle}** modulining **${diag.topicName}** mavzusiga mansub (${diag.difficulty}).`,
            `\n---\n## 📚 Chuqurlashtirilgan Nazariy Tahlil va Isbot Asosi\n**Nega aynan shu usul qo'llaniladi?**\n${diag.whyThisTopic}`,
            formulasMd ? `\n## 📐 Asosiy Teorema va Formulalar Baza\n${formulasMd}` : '',
            `\n## 🎯 Professor Maslahati (Imtihon uchun)\n**Eslab qoling:** ${diag.studyAdvice}`,
            relatedLinksMd ? `\n## 📖 Chuqur o'rganish uchun tavsiya etilgan darslar\n${relatedLinksMd}` : ''
          ].filter(Boolean).join('\n');

          lastRawSolutionText = deepAcademicMd;
          if (solutionBody) {
            solutionBody.innerHTML = renderMathMarkdown(deepAcademicMd);
          }
          if (solutionEngineBadge) {
            solutionEngineBadge.innerHTML = `🧠 Akademik Ekspert Tizimi (${localResult.type || diag.topicName}) • To'liq nazariy tahlil`;
          }
          if (solutionContainer) {
            solutionContainer.style.display = 'block';
            solutionContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          if (diagnosisCard) {
            renderDiagnosisCard(diag);
            diagnosisCard.style.display = 'block';
          }
        } else {
          if (solutionContainer && forceAi) {
            solutionContainer.style.display = 'none';
          }
          if (selectedImageBase64) {
            showError("📷 Rasmdagi misolni o'qish (OCR) uchun yuqoridagi «🔑 Shaxsiy Gemini API kalit» tugmasini bosib, yangi kalit kiriting (yoki misolni matn ko'rinishida yozing).");
          } else {
            showError(`AI server javob bermadi (${errMsg}). Iltimos, misolni standart matematik yozuvda kiriting yoki yangi Gemini API kalitini ulang.`);
          }
        }
      } finally {
        solveBtn!.removeAttribute('disabled');
        if (solveBtnText) solveBtnText.textContent = '🚀 Tahlil qilish va Yechish';
        if (solveBtnSpinner) solveBtnSpinner.style.display = 'none';
        if (askAiDeeperBtn) {
          askAiDeeperBtn.removeAttribute('disabled');
          askAiDeeperBtn.textContent = '🤖 Gemini AI dan yana-da batafsil so\'rash';
        }
      }
    }

    solveBtn.addEventListener('click', () => handleSolve(currentMode === 'ai'));
    askAiDeeperBtn?.addEventListener('click', () => handleSolve(true));

    input.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        handleSolve(currentMode === 'ai');
      }
    });

    copySolutionBtn?.addEventListener('click', async () => {
      if (!lastRawSolutionText) return;
      try {
        await navigator.clipboard.writeText(lastRawSolutionText);
        const orig = copySolutionBtn.textContent;
        copySolutionBtn.textContent = '✅ Nusxalandi!';
        setTimeout(() => { copySolutionBtn.textContent = orig; }, 2000);
      } catch {}
    });

    printSolutionBtn?.addEventListener('click', () => window.print());
  }

  initAiSolver();
  document.addEventListener('astro:page-load', initAiSolver);
</script>
