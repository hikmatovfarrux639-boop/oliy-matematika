<script>
  function setupShpargalkalar() {
    const tabs = document.querySelectorAll('.sheet-tab');
    const sheets = document.querySelectorAll('.shpargalka-sheet');
    const printBtn = document.getElementById('print-current-sheet-btn');
    const printAllBtn = document.getElementById('print-all-sheets-btn');

    if (!tabs.length || (tabs[0] as any)._hasTabInit) return;
    (tabs[0] as any)._hasTabInit = true;

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const targetId = tab.getAttribute('data-target');
        sheets.forEach(s => {
          if (s.id === targetId) {
            (s as HTMLElement).style.display = 'block';
            s.classList.add('active-sheet');
          } else {
            (s as HTMLElement).style.display = 'none';
            s.classList.remove('active-sheet');
          }
        });
      });
    });

    printBtn?.addEventListener('click', () => {
      document.body.classList.remove('print-all-sheets');
      window.print();
    });

    printAllBtn?.addEventListener('click', () => {
      document.body.classList.add('print-all-sheets');
      window.print();
      setTimeout(() => document.body.classList.remove('print-all-sheets'), 500);
    });
  }

  setupShpargalkalar();
  document.addEventListener('astro:page-load', setupShpargalkalar);
  document.addEventListener('astro:after-swap', setupShpargalkalar);
</script>
