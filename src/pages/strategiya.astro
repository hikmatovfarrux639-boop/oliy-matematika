---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="AI O'quv Strategiyasi va Shaxsiy Yo'l Xaritasi — Oliy Matematika"
  description="Oliy matematikadan qaysi mavzuda qiynalyapsiz? AI sizdan maqsadingizni so'raydi (faqat shu mavzumi yoki chuqurmi) va saytdagi 156 ta dars ichidan shaxsiy o'quv strategiyasini tuzib beradi."
>
  <div class="strategy-page">
    <!-- Hero Header -->
    <header class="strategy-hero">
      <div class="hero-pill">
        <span>🧭</span>
        <span>AI O'quv Repetitori • 14 ta modul va 156 ta dars bo'yicha moslashuvchan yo'l xaritasi</span>
      </div>
      <h1>Qaysi mavzuda qiynalyapsiz?</h1>
      <p>
        Darsda tushunmay qolgan mavzungizni oddiy so'z bilan yozing (masalan: <em>«Men darsda determinantga qiynalyapman»</em>). AI sizdan <strong>«Faqat shu mavzuning o'zimi yoki poydevordan chuqurmi?»</strong> deb so'raydi va maqsadingizga qarab eng mos o'rganish ketma-ketligini tuzib beradi!
      </p>
    </header>

    <!-- Step 1: Input Section -->
    <section class="strategy-input-card">
      <label for="strategy-query-input" class="input-label">
        <span>💬 Qiynalayotgan mavzungiz yoki vaziyatingizni yozing:</span>
      </label>
      <div class="input-row">
        <input
          type="text"
          id="strategy-query-input"
          placeholder="Masalan: Men darsda determinantga qiynalyapman, nimadan boshlay?"
          autocomplete="off"
        />
        <button type="button" id="build-strategy-btn" class="btn btn-primary build-btn">
          <span>🔍 Yo'l xaritasini topish</span>
        </button>
      </div>

      <!-- Quick Sample Prompts -->
      <div class="sample-prompts">
        <span class="sample-title">Tezkor namunalar (bosib ko'ring):</span>
        <div class="sample-chips">
          <button type="button" class="sample-chip" data-query="Men darsda determinantga qiynalyapman">
            😟 Determinantga qiynalyapman
          </button>
          <button type="button" class="sample-chip" data-query="Tenglamalar sistemasini Kramer va Gauss usulida yechish">
            🔢 Kramer va Gauss usuli
          </button>
          <button type="button" class="sample-chip" data-query="Limitlarda aniqmasliklarni ochish va ajoyib limitlar">
            📉 Limitlar va aniqmasliklar
          </button>
          <button type="button" class="sample-chip" data-query="Murakkab funksiya hosilasi va urinma tenglamasi">
            📈 Hosila va urinma
          </button>
          <button type="button" class="sample-chip" data-query="Integrallarni bo'laklab va almashtirib yechish">
            ∫ Integrallarni yechish
          </button>
          <button type="button" class="sample-chip" data-query="Vektorlar, skalyar ko'paytma va piramida hajmi">
            📐 Vektorlar va Geometriya
          </button>
          <button type="button" class="sample-chip" data-query="Differensial tenglamalar turlarini bir-biridan ajratish">
            ⚙️ Differensial tenglamalar
          </button>
          <button type="button" class="sample-chip" data-query="Ehtimollar nazariyasi, Bayes va Bernulli formulalari">
            🎲 Ehtimollar va Statistika
          </button>
          <button type="button" class="sample-chip" data-query="Maktab bazam bo'sh, noldan qanday boshlay?">
            🧱 Maktab bazam bo'sh (Noldan)
          </button>
        </div>
      </div>
    </section>

    <!-- Step 2: AI Clarification Modal / Choice Section (The core requirement!) -->
    <section id="ai-clarify-section" class="clarify-card" style="display: none;">
      <div class="clarify-header">
        <div style="font-size: 1.8rem;">🤖</div>
        <div>
          <h2 id="clarify-topic-heading" style="margin: 0 0 0.25rem 0; font-size: 1.25rem; color: var(--text-main);">
            AI Tahlili: Sizga qanday o'rganish formati kerak?
          </h2>
          <p id="clarify-intro-text" style="margin: 0; font-size: 0.92rem; color: var(--text-muted); line-height: 1.5;"></p>
        </div>
      </div>

      <div class="clarify-options-grid">
        <!-- Option 1: Express (Only this topic) -->
        <button type="button" class="clarify-btn" data-mode="express">
          <div class="clarify-btn-badge" style="background: rgba(234, 88, 12, 0.15); color: #ea580c;">
            ⚡ TEZKOR / EKSPRESS (20–25 daqiqa)
          </div>
          <div class="clarify-btn-title">Faqat shu mavzuning o'zi (Eng zaruri)</div>
          <div class="clarify-btn-desc">
            Vaqtingiz kam bo'lsa yoki ertaga dars bo'lsa: ortiqcha nazariyasiz, faqat 1–2 ta eng asosiy dars, tayyor formulalar va kalkulyatorda yechish.
          </div>
          <div class="clarify-btn-action">
            <span>Ushbu variantni tanlash →</span>
          </div>
        </button>

        <!-- Option 2: Deep (Foundational) -->
        <button type="button" class="clarify-btn recommended" data-mode="deep">
          <div class="clarify-btn-badge" style="background: rgba(16, 185, 129, 0.15); color: #059669;">
            🎓 TAVSIYA ETILADI • CHUQUR (50–70 daqiqa)
          </div>
          <div class="clarify-btn-title">Poydevor bilan to'liq chuqur o'rganish</div>
          <div class="clarify-btn-desc">
            Mavzuni noldan, uning mohiyati, nima uchun bunday qilinishi, barcha teoremalari, isbotlari va xossalari bilan puxta o'zlashtirish.
          </div>
          <div class="clarify-btn-action">
            <span>To'liq yo'l xaritasini ochish →</span>
          </div>
        </button>

        <!-- Option 3: Exam (Test) -->
        <button type="button" class="clarify-btn" data-mode="exam">
          <div class="clarify-btn-badge" style="background: rgba(37, 99, 235, 0.15); color: #2563eb;">
            📝 IMTIHON VA TEST REJASI (35–45 daqiqa)
          </div>
          <div class="clarify-btn-title">Faqat nazorat va testlar uchun</div>
          <div class="clarify-btn-desc">
            Oraliq va yakuniy nazoratlarda eng ko'p tushadigan tipik savollar, hisoblashdagi xavfli tuzoqlar va test savollariga qaratilgan reja.
          </div>
          <div class="clarify-btn-action">
            <span>Test rejasini ko'rish →</span>
          </div>
        </button>
      </div>
    </section>

    <!-- Step 3: Strategy Output Container -->
    <div id="strategy-result-wrapper" style="display: none;">
      <!-- Active Mode Switch Bar (Allows switching anytime) -->
      <div class="active-mode-bar">
        <div style="font-size: 0.88rem; font-weight: 700; color: var(--text-main);">
          Tanlangan rejim:
        </div>
        <div class="mode-pills">
          <button type="button" class="mode-pill" data-switch="express">
            ⚡ Faqat shu mavzu (Tezkor)
          </button>
          <button type="button" class="mode-pill active" data-switch="deep">
            🎓 Chuqur (Poydevor bilan)
          </button>
          <button type="button" class="mode-pill" data-switch="exam">
            📝 Imtihon & Test rejasi
          </button>
        </div>
        <div class="share-actions">
          <button type="button" id="copy-strategy-btn" class="btn btn-secondary btn-sm" title="Rejani nusxalash">
            📋 Nusxalash
          </button>
          <a id="telegram-share-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="color: #0284c7; border-color: #0284c7;" title="Telegramga yuborish">
            📲 Telegramga saqlash
          </a>
        </div>
      </div>

      <!-- Diagnosis & Empathy Banner -->
      <div class="diagnosis-banner" id="strategy-diagnosis-banner"></div>

      <!-- Progress Tracker -->
      <div class="roadmap-progress-card">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
          <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-main);">
            📊 Ushbu strategiya bo'yicha shaxsiy natijangiz:
          </div>
          <span id="roadmap-progress-label" style="font-size: 0.85rem; font-weight: 700; color: var(--primary);">
            0 / 4 qadam o'zlashtirilgan (0%)
          </span>
        </div>
        <div class="progress-track">
          <div id="roadmap-progress-fill" class="progress-fill" style="width: 0%;"></div>
        </div>
        <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.4rem;">
          💡 Darslarni o'qib bo'lgach, katakchalarni belgilang — natijangiz brauzeringizda avtomatik saqlanadi.
        </div>
      </div>

      <!-- Step-by-Step Timeline -->
      <div class="timeline-section">
        <h2 class="section-heading" id="timeline-main-heading">🗺️ Qadamma-qadam Tavsiya Etilgan Darslar</h2>
        <div id="strategy-steps-list" class="timeline-list"></div>
      </div>

      <!-- Interactive Practice Tools & Exam Tip -->
      <div class="tools-and-tips-grid">
        <div class="tools-box">
          <h3 style="margin: 0 0 0.75rem 0; font-size: 1.1rem; color: var(--text-main);">
            🛠️ Amaliy Mashq va Tekshiruv Asboblari
          </h3>
          <div id="strategy-tools-list" class="tools-cards"></div>
        </div>

        <div class="exam-tip-box">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: 1.05rem; color: #d97706; margin-bottom: 0.6rem;">
            <span>🏆</span>
            <span>Professorning Imtihon Siri (Oraliq va Yakuniy uchun)</span>
          </div>
          <p id="strategy-exam-tip" style="margin: 0 0 1.25rem 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-main);"></p>

          <button type="button" id="ask-gemini-mentor-btn" class="btn ai-mentor-btn">
            <span>🤖 Gemini AI Mentoridan qo'shimcha shaxsiy maslahat olish</span>
          </button>
        </div>
      </div>

      <!-- Gemini AI Deep Personal Mentor Box -->
      <div id="ai-mentor-response-card" class="ai-mentor-card">
        <div class="ai-mentor-header">
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
              <span style="font-size: 1.4rem;">🎓</span>
              <div>
                <h3 style="margin: 0; font-size: 1.15rem; color: var(--text-main);">AI Shaxsiy Kouch Maslahati</h3>
                <span id="ai-mentor-badge" style="font-size: 0.78rem; color: var(--primary); font-weight: 700;">Sayt o'quv dasturi asosida tuzildi</span>
              </div>
            </div>
            <div class="mentor-card-actions">
              <button type="button" id="mentor-speak-btn" class="btn btn-secondary btn-sm" title="Ovozli eshitish">
                🔊 Ovozli eshitish
              </button>
              <button type="button" id="mentor-copy-btn" class="btn btn-secondary btn-sm" title="Nusxalash">
                📋 Nusxalash
              </button>
            </div>
          </div>
        </div>
        <div id="ai-mentor-body" class="ai-mentor-body prose-content"></div>
      </div>

      <!-- Interactive Q&A Chat with AI Mentor -->
      <section class="mentor-chat-section">
        <div class="chat-section-header">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="font-size: 1.6rem;">💬</div>
            <div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <h3 style="margin: 0; font-size: 1.15rem; color: var(--text-main);">AI Repetitor bilan Jonli Suhbat</h3>
                <span class="live-pill">🟢 Faol</span>
              </div>
              <p style="margin: 0.2rem 0 0; font-size: 0.86rem; color: var(--text-muted);">
                Mavzu bo'yicha tushunmagan joyingizni so'rang — AI kontekstni eslab qoladi va qadamma-qadam o'rgatadi.
              </p>
            </div>
          </div>
          <button type="button" id="clear-chat-btn" class="btn btn-secondary btn-sm" title="Suhbat tarixini tozalash">
            🔄 Suhbatni tozalash
          </button>
        </div>

        <!-- Quick Question Chips -->
        <div class="quick-questions-wrapper">
          <div class="quick-questions-title">💡 Eng ko'p so'raladigan savollar (bosib ko'ring):</div>
          <div id="chat-quick-chips" class="chat-quick-chips"></div>
        </div>

        <div id="mentor-chat-messages" class="chat-messages-container"></div>

        <div class="chat-input-bar">
          <input 
            type="text" 
            id="mentor-chat-input" 
            placeholder="AI Repetitordan so'rang (masalan: Sarryus qoidasida minus qayerga qo'yiladi?)..." 
          />
          <button type="button" id="mentor-chat-send-btn" class="btn btn-primary" style="padding: 0.65rem 1.25rem; font-weight: 700;">
            <span>Yuborish 🚀</span>
          </button>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { generateStudyStrategy, SITE_CURRICULUM_PROMPT_MAP, type StudyStrategyPlan } from '../utils/studyStrategyEngine';
  import katex from 'katex';

  function renderMarkdownWithLinksAndMath(md: string): string {
    const mathPlaceholders: string[] = [];

    // 1. Extract block math $$...$$
    let text = md.replace(/\$\$([\s\S]+?)\$\$/g, (_, m) => {
      const idx = mathPlaceholders.length;
      try {
        mathPlaceholders.push(katex.renderToString(m.trim(), { displayMode: true, throwOnError: false }));
      } catch {
        mathPlaceholders.push(`$$${m}$$`);
      }
      return `%%%MATH_BLOCK_${idx}%%%`;
    });

    // 2. Extract inline math $...$
    text = text.replace(/\$([^\$\n]+?)\$/g, (_, m) => {
      const idx = mathPlaceholders.length;
      try {
        mathPlaceholders.push(katex.renderToString(m.trim(), { displayMode: false, throwOnError: false }));
      } catch {
        mathPlaceholders.push(`$${m}$`);
      }
      return `%%%MATH_INLINE_${idx}%%%`;
    });

    // 3. Escape HTML safely on remaining prose
    let html = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    // 4. Course links [Title](/dars/...)
    html = html.replace(
      /\[([^\]]+)\]\((\/[^\)]+)\)/g,
      '<a href="$2" class="mentor-inline-link">📖 $1 →</a>'
    );

    // 5. Basic markdown formatting
    html = html
      .replace(/^### (.*$)/gim, '<h4 style="margin: 0.9rem 0 0.35rem; color: var(--text-main); font-weight: 700;">$1</h4>')
      .replace(/^## (.*$)/gim, '<h3 style="margin: 1.1rem 0 0.45rem; color: var(--primary); font-weight: 800;">$1</h3>')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/\n\n/g, '<br><br>')
      .replace(/\n- /g, '<br>• ');

    // 6. Restore math blocks and inlines
    html = html.replace(/%%%MATH_(BLOCK|INLINE)_(\d+)%%%/g, (_, type, idxStr) => {
      return mathPlaceholders[parseInt(idxStr, 10)] || '';
    });

    return html;
  }

  function setupStrategyPage() {
    const queryInput = document.getElementById('strategy-query-input') as HTMLInputElement | null;
    const buildBtn = document.getElementById('build-strategy-btn');
    const clarifySection = document.getElementById('ai-clarify-section');
    const clarifyHeading = document.getElementById('clarify-topic-heading');
    const clarifyIntro = document.getElementById('clarify-intro-text');
    const resultWrapper = document.getElementById('strategy-result-wrapper');
    const diagnosisBanner = document.getElementById('strategy-diagnosis-banner');
    const stepsList = document.getElementById('strategy-steps-list');
    const toolsList = document.getElementById('strategy-tools-list');
    const examTipEl = document.getElementById('strategy-exam-tip');
    const progressLabel = document.getElementById('roadmap-progress-label');
    const progressFill = document.getElementById('roadmap-progress-fill');
    const askMentorBtn = document.getElementById('ask-gemini-mentor-btn');
    const mentorCard = document.getElementById('ai-mentor-response-card');
    const mentorBody = document.getElementById('ai-mentor-body');
    const mentorBadge = document.getElementById('ai-mentor-badge');
    const mentorSpeakBtn = document.getElementById('mentor-speak-btn');
    const mentorCopyBtn = document.getElementById('mentor-copy-btn');
    const copyBtn = document.getElementById('copy-strategy-btn');
    const telegramShareBtn = document.getElementById('telegram-share-btn') as HTMLAnchorElement | null;
    const chatInput = document.getElementById('mentor-chat-input') as HTMLInputElement | null;
    const chatSendBtn = document.getElementById('mentor-chat-send-btn');
    const chatMessages = document.getElementById('mentor-chat-messages');
    const quickChipsContainer = document.getElementById('chat-quick-chips');
    const clearChatBtn = document.getElementById('clear-chat-btn');

    if (!queryInput || !buildBtn || (buildBtn as any)._hasStrategyV2Init) return;
    (buildBtn as any)._hasStrategyV2Init = true;

    let activeMode: 'express' | 'deep' | 'exam' = 'deep';
    let currentPlan: StudyStrategyPlan | null = null;
    let activeQuery = '';
    let mentorAdviceText = '';

    // Multi-turn conversation memory
    let chatHistory: Array<{ role: 'user' | 'model'; parts: Array<{ text: string }> }> = [];

    // Text-To-Speech (SpeechSynthesis) Manager
    let currentSpeakingBtn: HTMLElement | null = null;

    function stopSpeech() {
      if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
      if (currentSpeakingBtn) {
        currentSpeakingBtn.textContent = '🔊 Ovozli eshitish';
        currentSpeakingBtn.classList.remove('speaking');
        currentSpeakingBtn = null;
      }
    }

    function speakText(text: string, triggerBtn?: HTMLElement) {
      if (typeof window === 'undefined' || !('speechSynthesis' in window)) {
        alert("Brauzeringizda nutq sintezi (SpeechSynthesis) qo'llab-quvvatlanmaydi.");
        return;
      }

      if (currentSpeakingBtn === triggerBtn && window.speechSynthesis.speaking) {
        stopSpeech();
        return;
      }

      stopSpeech();

      // Clean markdown, links and format math symbols for clear pronunciation
      let clean = text
        .replace(/<[^>]*>/g, ' ')
        .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1')
        .replace(/\$\$([\s\S]+?)\$\$/g, ' formula: $1 ')
        .replace(/\$([^\$]+?)\$/g, ' $1 ')
        .replace(/\\frac\{([^}]+)\}\{([^}]+)\}/g, ' $1 taqsim $2 ')
        .replace(/\\sqrt\{([^}]+)\}/g, ' ildiz ostida $1 ')
        .replace(/\^2/g, ' kvadrat ')
        .replace(/\^3/g, ' kub ')
        .replace(/\\ne/g, ' teng emas ')
        .replace(/\\le/g, ' kichik yoki teng ')
        .replace(/\\ge/g, ' katta yoki teng ')
        .replace(/\\cdot|\\times/g, ' ko\'paytirilgan ')
        .replace(/\\pm/g, ' plyus minus ')
        .replace(/\\det/g, ' determinant ')
        .replace(/\\int/g, ' integral ')
        .replace(/\\lim/g, ' limit ')
        .replace(/\\to/g, ' intilganda ')
        .replace(/[*#_`~>]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

      if (!clean) return;

      const utterance = new SpeechSynthesisUtterance(clean);
      utterance.rate = 0.95;
      utterance.pitch = 1.0;

      const voices = window.speechSynthesis.getVoices();
      const uzVoice = voices.find(v => v.lang.startsWith('uz') || v.lang.startsWith('tr') || v.lang.startsWith('ru'));
      if (uzVoice) utterance.voice = uzVoice;

      if (triggerBtn) {
        currentSpeakingBtn = triggerBtn;
        triggerBtn.textContent = '⏹ To\'xtatish';
        triggerBtn.classList.add('speaking');
      }

      utterance.onend = () => stopSpeech();
      utterance.onerror = () => stopSpeech();

      window.speechSynthesis.speak(utterance);
    }

    function getCompletedLessons(): string[] {
      try {
        return JSON.parse(localStorage.getItem('math_completed_lessons') || '[]');
      } catch {
        return [];
      }
    }

    function toggleLessonCompletion(slug: string) {
      if (!slug) return;
      const completed = getCompletedLessons();
      let updated: string[];
      if (completed.includes(slug)) {
        updated = completed.filter((s) => s !== slug);
      } else {
        updated = [...completed, slug];
      }
      localStorage.setItem('math_completed_lessons', JSON.stringify(updated));
      updateProgressDisplay();
    }

    function updateProgressDisplay() {
      if (!currentPlan) return;
      const completed = getCompletedLessons();
      let completedInPlan = 0;
      currentPlan.steps.forEach((s) => {
        if (s.slug && completed.includes(s.slug)) {
          completedInPlan++;
        }
      });
      const total = currentPlan.steps.length;
      const pct = total > 0 ? Math.round((completedInPlan / total) * 100) : 0;
      if (progressLabel) {
        progressLabel.textContent = `${completedInPlan} / ${total} qadam o'zlashtirilgan (${pct}%)`;
      }
      if (progressFill) {
        progressFill.style.width = `${pct}%`;
      }

      // Update checkboxes and cards
      document.querySelectorAll('.timeline-card').forEach((card) => {
        const slug = card.getAttribute('data-slug');
        const chk = card.querySelector('.step-check') as HTMLInputElement | null;
        if (slug && completed.includes(slug)) {
          card.classList.add('is-completed');
          if (chk) chk.checked = true;
          const badge = card.querySelector('.completion-indicator');
          if (badge) badge.innerHTML = '<span class="done-badge">✅ O\'zlashtirilgan</span>';
        } else {
          card.classList.remove('is-completed');
          if (chk) chk.checked = false;
          const badge = card.querySelector('.completion-indicator');
          if (badge) badge.innerHTML = '<span class="todo-badge">⭕ O\'qish kerak</span>';
        }
      });
    }

    function onUserSubmitsTopic(raw: string, directMode?: 'express' | 'deep' | 'exam') {
      activeQuery = raw.trim() || 'Men darsda determinantga qiynalyapman';
      const basePlan = generateStudyStrategy(activeQuery, 'deep');

      if (clarifyHeading) {
        clarifyHeading.textContent = `AI Tahlili: «${basePlan.topicTitle}» bo'yicha yordam`;
      }
      if (clarifyIntro) {
        clarifyIntro.innerHTML = `Mavzuni aniqladik: <strong>${basePlan.moduleTitle}</strong>. O'qishni boshlashdan oldin bitta savol: Sizga aynan qaysi formatda yordam kerak?`;
      }

      if (directMode) {
        renderRoadmap(activeQuery, directMode);
      } else {
        if (clarifySection) {
          clarifySection.style.display = 'block';
          clarifySection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        if (resultWrapper) {
          resultWrapper.style.display = 'none';
        }
      }
    }

    function getTopicQuickQuestions(plan: StudyStrategyPlan): string[] {
      const title = plan.topicTitle;
      const questions: string[] = [];

      questions.push(`💡 «${title}» oddiy tilda nima o'zi?`);
      questions.push(`⚠️ Talabalar bu mavzuda eng ko'p qanday xatoga yo'l qo'yishadi?`);

      if (plan.steps.length > 0) {
        questions.push(`🔢 1-qadam darsi bo'yicha bitta oddiy misol ko'rsating`);
      }

      const id = plan.id.toLowerCase();
      if (id.includes('determinant')) {
        questions.push(`📐 Sarryus qoidasida qaysi hadlar oldiga minus qo'yiladi?`);
        questions.push(`⚡ Determinant qachon nolga teng bo'ladi?`);
      } else if (id.includes('kramer') || id.includes('gauss') || id.includes('tizim')) {
        questions.push(`⚖️ Kramer usuli qulaymi yoki Gauss usulimi?`);
        questions.push(`⚡ Qachon sistema yechimga ega bo'lmaydi?`);
      } else if (id.includes('limit')) {
        questions.push(`🚀 0/0 aniqmaslikni ochishning eng tez usuli nima?`);
        questions.push(`📉 Birinchi va ikkinchi ajoyib limitlar formulasi qanday?`);
      } else if (id.includes('hosila')) {
        questions.push(`📈 Hosilaning geometrik ma'nosi nima?`);
        questions.push(`⛓️ Murakkab funksiya hosilasi (zanjir) qoidasini tushuntiring`);
      } else if (id.includes('integral')) {
        questions.push(`✂️ Qachon bo'laklab integrallash (udv) usuli tanlanadi?`);
        questions.push(`🔄 O'zgaruvchini almashtirishda eng muhim qoida nima?`);
      } else if (id.includes('vektor')) {
        questions.push(`📐 Skalyar ko'paytma bilan vektor ko'paytma farqi nima?`);
        questions.push(`🔺 Piramida hajmini qanday formula bilan topamiz?`);
      } else if (id.includes('differensial')) {
        questions.push(`⚙️ Differensial tenglama tartibi qanday aniqlanadi?`);
        questions.push(`🎯 O'zgaruvchilari ajraladigan tenglamalarni yechish sxemasi`);
      } else if (id.includes('ehtimol')) {
        questions.push(`🎲 Geometrik ehtimollik bilan klassik ehtimollik farqi?`);
        questions.push(`📊 Bayes formulasi qachon ishlatiladi?`);
      } else {
        questions.push(`🎯 Oraliq yoki yakuniy nazoratda qanday tipik savollar tushadi?`);
        questions.push(`⚡ Ushbu mavzuni tez va oson o'zlashtirish siri nima?`);
      }

      return questions.slice(0, 4);
    }

    function renderQuickChips(questions: string[]) {
      if (!quickChipsContainer) return;
      quickChipsContainer.innerHTML = questions
        .map(
          (q) => `<button type="button" class="chat-chip-btn" data-question="${q.replace(/"/g, '&quot;')}">${q}</button>`
        )
        .join('');

      quickChipsContainer.querySelectorAll('.chat-chip-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const question = btn.getAttribute('data-question') || '';
          if (question) {
            sendChatMessage(question);
          }
        });
      });
    }

    function updateAiBubbleWithContent(aiBubble: HTMLElement, text: string) {
      const renderedHtml = renderMarkdownWithLinksAndMath(text);
      aiBubble.innerHTML = `
        <div class="bubble-header ai-header">
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <span class="ai-avatar">🤖</span>
            <strong>AI Repetitor</strong>
          </div>
          <span class="ai-badge-active">Jonli</span>
        </div>
        <div class="bubble-text prose-content">${renderedHtml}</div>
        <div class="bubble-actions">
          <button type="button" class="bubble-action-btn speak-btn" title="Ovozli eshitish">
            🔊 Ovozli eshitish
          </button>
          <button type="button" class="bubble-action-btn copy-btn" title="Javobni nusxalash">
            📋 Nusxalash
          </button>
        </div>
      `;

      const speakBtn = aiBubble.querySelector('.speak-btn') as HTMLElement | null;
