    function renderRoadmap(rawQuery: string, mode: 'express' | 'deep' | 'exam') {
      activeMode = mode;
      activeQuery = rawQuery;
      currentPlan = generateStudyStrategy(activeQuery, activeMode);
      stopSpeech();

      // Hide clarify question
      if (clarifySection) clarifySection.style.display = 'none';

      // Update active mode pill
      document.querySelectorAll('.mode-pill').forEach((pill) => {
        if (pill.getAttribute('data-switch') === activeMode) {
          pill.classList.add('active');
        } else {
          pill.classList.remove('active');
        }
      });

      // Diagnosis banner
      if (diagnosisBanner) {
        const modeBadge =
          activeMode === 'express'
            ? '⚡ Tezkor (Faqat eng asosiysi)'
            : activeMode === 'exam'
            ? '📝 Imtihon & Test Rejasi'
            : '🎓 Chuqur (Poydevor bilan)';

        diagnosisBanner.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
            <span class="module-pill">${currentPlan.moduleTitle}</span>
            <span class="time-pill">${modeBadge} • ⏱ ${currentPlan.estimatedTotalTime}</span>
          </div>
          <h2 style="margin: 0 0 0.6rem 0; font-size: 1.45rem; color: var(--text-main);">
            🎯 ${currentPlan.topicTitle}
          </h2>
          <p style="margin: 0 0 0.85rem 0; font-size: 0.98rem; color: var(--text-main); line-height: 1.55;">
            <strong>💬 AI Repetitor:</strong> ${currentPlan.empathyMessage}
          </p>
          <div class="root-cause-box">
            <strong>🔍 Nega talabalar bu mavzuda qiynaladi?</strong> ${currentPlan.rootCauseWhyHard}
          </div>
        `;
      }

      // Steps list rendering with Interactive Checkbox
      const completed = getCompletedLessons();
      if (stepsList) {
        stepsList.innerHTML = currentPlan.steps
          .map((step, idx) => {
            const isDone = step.slug ? completed.includes(step.slug) : false;
            return `
              <div class="timeline-card ${isDone ? 'is-completed' : ''}" data-slug="${step.slug || ''}">
                <div class="step-check-col">
                  <input type="checkbox" class="step-check" ${isDone ? 'checked' : ''} aria-label="O'zlashtirildi deb belgilash" />
                </div>
                <div class="timeline-num" style="background: ${isDone ? '#10b981' : step.badgeColor};">
                  ${idx + 1}
                </div>
                <div class="timeline-content">
                  <div class="timeline-top">
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                      <span class="phase-badge" style="background: ${step.badgeColor}18; color: ${step.badgeColor}; border: 1px solid ${step.badgeColor}40;">
                        ${idx + 1}-QADAM • ${step.phase.toUpperCase()}
                      </span>
                      <span class="duration-badge">⏱ ${step.duration}</span>
                      <span class="completion-indicator">
                        ${isDone ? '<span class="done-badge">✅ O\'zlashtirilgan</span>' : '<span class="todo-badge">⭕ O\'qish kerak</span>'}
                      </span>
                    </div>
                  </div>

                  <h3 class="step-title">
                    <a href="${step.url}">${step.title}</a>
                  </h3>

                  <p class="step-why">
                    <strong>Nima uchun bu dars?</strong> ${step.whyRead}
                  </p>

                  <div class="focus-list">
                    <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted);">Diqqat qiling:</span>
                    ${step.focusPoints.map((fp) => `<span class="focus-chip">✓ ${fp}</span>`).join('')}
                  </div>

                  <div style="margin-top: 0.85rem;">
                    <a href="${step.url}" class="btn btn-primary step-open-btn">
                      <span>📖 ${idx + 1}-qadam darsini ochish</span>
                      <span>→</span>
                    </a>
                  </div>
                </div>
              </div>
            `;
          })
          .join('');

        // Attach checkbox event listeners
        stepsList.querySelectorAll('.step-check').forEach((chk) => {
          chk.addEventListener('change', (e) => {
            const card = (e.target as HTMLElement).closest('.timeline-card');
            const slug = card?.getAttribute('data-slug');
            if (slug) toggleLessonCompletion(slug);
          });
        });
      }

      // Tools rendering
      if (toolsList) {
        toolsList.innerHTML = currentPlan.interactiveTools
          .map(
            (t) => `
            <a href="${t.url}" class="tool-item-card">
              <div style="font-size: 1.6rem;">${t.icon}</div>
              <div>
                <div style="font-weight: 700; color: var(--primary); font-size: 0.95rem; margin-bottom: 0.2rem;">
                  ${t.title} →
                </div>
                <div style="font-size: 0.84rem; color: var(--text-muted); line-height: 1.4;">
                  ${t.desc}
                </div>
              </div>
            </a>
          `
          )
          .join('');
      }

      if (examTipEl) {
        examTipEl.textContent = currentPlan.examTip;
      }

      // Telegram share link
      if (telegramShareBtn) {
        const text = encodeURIComponent(
          `Assalomu alaykum! OliyMatematika saytidan shaxsiy o'quv rejam:\n\n` +
          `🎯 Mavzu: ${currentPlan.topicTitle}\n` +
          `⏱ Rejim: ${activeMode.toUpperCase()} (${currentPlan.estimatedTotalTime})\n\n` +
          currentPlan.steps.map((s, i) => `${i + 1}-qadam: ${s.title} (https://oliy-matematika.vercel.app${s.url})`).join('\n') +
          `\n\n💡 Maslahat: ${currentPlan.examTip}`
        );
        telegramShareBtn.href = `https://t.me/share/url?url=${encodeURIComponent('https://oliy-matematika.vercel.app/strategiya?q=' + activeQuery + '&mode=' + activeMode)}&text=${text}`;
      }

      updateProgressDisplay();

      // Automatically load AI Mentor advice
      loadAiMentorAdvice(false);

      // Reset and initialize live chat with AI Repetitor
      chatHistory = [];
      if (chatMessages) {
        chatMessages.innerHTML = '';
        initChatGreeting(currentPlan);
      }

      if (resultWrapper) {
        resultWrapper.style.display = 'block';
        resultWrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Clarification buttons click
    document.querySelectorAll('.clarify-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = (btn.getAttribute('data-mode') as any) || 'deep';
        renderRoadmap(activeQuery, mode);
      });
    });

    // Active mode switch pills inside roadmap
    document.querySelectorAll('.mode-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        const mode = (pill.getAttribute('data-switch') as any) || 'deep';
        renderRoadmap(activeQuery, mode);
      });
    });

    // Copy strategy button
    copyBtn?.addEventListener('click', async () => {
      if (!currentPlan) return;
      const text =
        `OliyMatematika — Shaxsiy O'quv Rejasi:\nMavzu: ${currentPlan.topicTitle}\n\n` +
        currentPlan.steps.map((s, i) => `${i + 1}. ${s.title} -> https://oliy-matematika.vercel.app${s.url}`).join('\n') +
        `\n\nMaslahat: ${currentPlan.examTip}`;
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.textContent = '✅ Nusxalandi!';
        setTimeout(() => (copyBtn.textContent = '📋 Nusxalash'), 2500);
      } catch {
        alert("Nusxalab bo'lmadi.");
      }
    });

    // User submits search query
    buildBtn.addEventListener('click', () => {
      onUserSubmitsTopic(queryInput.value);
    });

    queryInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        onUserSubmitsTopic(queryInput.value);
      }
    });

    // Sample prompt chips
    document.querySelectorAll('.sample-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const q = chip.getAttribute('data-query') || '';
        queryInput.value = q;
        onUserSubmitsTopic(q);
      });
    });

    // Gemini Deep Personal Mentor button (refresh)
    askMentorBtn?.addEventListener('click', () => {
      loadAiMentorAdvice(true);
    });

    // Mentor Card action buttons (Voice TTS & Copy)
    mentorSpeakBtn?.addEventListener('click', () => {
      if (mentorAdviceText) speakText(mentorAdviceText, mentorSpeakBtn as HTMLElement);
    });

    mentorCopyBtn?.addEventListener('click', async () => {
      if (!mentorAdviceText) return;
      try {
        await navigator.clipboard.writeText(mentorAdviceText);
        mentorCopyBtn.textContent = '✅ Nusxalandi!';
        setTimeout(() => (mentorCopyBtn.textContent = '📋 Nusxalash'), 2000);
      } catch {
        alert("Nusxalab bo'lmadi");
      }
    });

    // Clear chat button
    clearChatBtn?.addEventListener('click', () => {
      stopSpeech();
      chatHistory = [];
      if (chatMessages && currentPlan) {
        chatMessages.innerHTML = '';
        initChatGreeting(currentPlan);
      }
    });

    chatSendBtn?.addEventListener('click', () => sendChatMessage());
    chatInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        sendChatMessage();
      }
    });

    // URL parameter handling (?q=...&mode=...)
    const params = new URLSearchParams(window.location.search);
    const urlQuery = params.get('q');
    const urlMode = params.get('mode') as 'express' | 'deep' | 'exam' | null;
    if (urlQuery) {
      queryInput.value = urlQuery;
      onUserSubmitsTopic(urlQuery, urlMode || undefined);
    } else {
      // Show default query prompt
      queryInput.value = 'Men darsda determinantga qiynalyapman';
      onUserSubmitsTopic(queryInput.value);
    }
  }

  setupStrategyPage();
  document.addEventListener('astro:page-load', setupStrategyPage);
  document.addEventListener('astro:after-swap', setupStrategyPage);
</script>

