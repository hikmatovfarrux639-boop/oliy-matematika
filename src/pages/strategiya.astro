---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="AI O'quv Strategiyasi va Shaxsiy Yo'l Xaritasi — Oliy Matematika"
  description="Oliy matematikadan qaysi mavzuda qiynalyapsiz? AI sizdan maqsadingizni so'raydi (faqat shu mavzumi yoki chuqurmi) va saytdagi 156 ta dars ichidan shaxsiy o'quv strategiyasini tuzib beradi."
>
  <div class="strategy-page">
    <!-- Hero Header -->
    <header class="strategy-hero">
      <div class="hero-pill">
        <span>🧭</span>
        <span>AI O'quv Repetitori • 14 ta modul va 156 ta dars bo'yicha moslashuvchan yo'l xaritasi</span>
      </div>
      <h1>Qaysi mavzuda qiynalyapsiz?</h1>
      <p>
        Darsda tushunmay qolgan mavzungizni oddiy so'z bilan yozing (masalan: <em>«Men darsda determinantga qiynalyapman»</em>). AI sizdan <strong>«Faqat shu mavzuning o'zimi yoki poydevordan chuqurmi?»</strong> deb so'raydi va maqsadingizga qarab eng mos o'rganish ketma-ketligini tuzib beradi!
      </p>
    </header>

    <!-- Step 1: Input Section -->
    <section class="strategy-input-card">
      <label for="strategy-query-input" class="input-label">
        <span>💬 Qiynalayotgan mavzungiz yoki vaziyatingizni yozing:</span>
      </label>
      <div class="input-row">
        <input
          type="text"
          id="strategy-query-input"
          placeholder="Masalan: Men darsda determinantga qiynalyapman, nimadan boshlay?"
          autocomplete="off"
        />
        <button type="button" id="build-strategy-btn" class="btn btn-primary build-btn">
          <span>🔍 Yo'l xaritasini topish</span>
        </button>
      </div>

      <!-- Quick Sample Prompts -->
      <div class="sample-prompts">
        <span class="sample-title">Tezkor namunalar (bosib ko'ring):</span>
        <div class="sample-chips">
          <button type="button" class="sample-chip" data-query="Men darsda determinantga qiynalyapman">
            😟 Determinantga qiynalyapman
          </button>
          <button type="button" class="sample-chip" data-query="Tenglamalar sistemasini Kramer va Gauss usulida yechish">
            🔢 Kramer va Gauss usuli
          </button>
          <button type="button" class="sample-chip" data-query="Limitlarda aniqmasliklarni ochish va ajoyib limitlar">
            📉 Limitlar va aniqmasliklar
          </button>
          <button type="button" class="sample-chip" data-query="Murakkab funksiya hosilasi va urinma tenglamasi">
            📈 Hosila va urinma
          </button>
          <button type="button" class="sample-chip" data-query="Integrallarni bo'laklab va almashtirib yechish">
            ∫ Integrallarni yechish
          </button>
          <button type="button" class="sample-chip" data-query="Vektorlar, skalyar ko'paytma va piramida hajmi">
            📐 Vektorlar va Geometriya
          </button>
          <button type="button" class="sample-chip" data-query="Differensial tenglamalar turlarini bir-biridan ajratish">
            ⚙️ Differensial tenglamalar
          </button>
          <button type="button" class="sample-chip" data-query="Ehtimollar nazariyasi, Bayes va Bernulli formulalari">
            🎲 Ehtimollar va Statistika
          </button>
          <button type="button" class="sample-chip" data-query="Maktab bazam bo'sh, noldan qanday boshlay?">
            🧱 Maktab bazam bo'sh (Noldan)
          </button>
        </div>
      </div>
    </section>

    <!-- Step 2: AI Clarification Modal / Choice Section (The core requirement!) -->
    <section id="ai-clarify-section" class="clarify-card" style="display: none;">
      <div class="clarify-header">
        <div style="font-size: 1.8rem;">🤖</div>
        <div>
          <h2 id="clarify-topic-heading" style="margin: 0 0 0.25rem 0; font-size: 1.25rem; color: var(--text-main);">
            AI Tahlili: Sizga qanday o'rganish formati kerak?
          </h2>
          <p id="clarify-intro-text" style="margin: 0; font-size: 0.92rem; color: var(--text-muted); line-height: 1.5;"></p>
        </div>
      </div>

      <div class="clarify-options-grid">
        <!-- Option 1: Express (Only this topic) -->
        <button type="button" class="clarify-btn" data-mode="express">
          <div class="clarify-btn-badge" style="background: rgba(234, 88, 12, 0.15); color: #ea580c;">
            ⚡ TEZKOR / EKSPRESS (20–25 daqiqa)
          </div>
          <div class="clarify-btn-title">Faqat shu mavzuning o'zi (Eng zaruri)</div>
          <div class="clarify-btn-desc">
            Vaqtingiz kam bo'lsa yoki ertaga dars bo'lsa: ortiqcha nazariyasiz, faqat 1–2 ta eng asosiy dars, tayyor formulalar va kalkulyatorda yechish.
          </div>
          <div class="clarify-btn-action">
            <span>Ushbu variantni tanlash →</span>
          </div>
        </button>

        <!-- Option 2: Deep (Foundational) -->
        <button type="button" class="clarify-btn recommended" data-mode="deep">
          <div class="clarify-btn-badge" style="background: rgba(16, 185, 129, 0.15); color: #059669;">
            🎓 TAVSIYA ETILADI • CHUQUR (50–70 daqiqa)
          </div>
          <div class="clarify-btn-title">Poydevor bilan to'liq chuqur o'rganish</div>
          <div class="clarify-btn-desc">
            Mavzuni noldan, uning mohiyati, nima uchun bunday qilinishi, barcha teoremalari, isbotlari va xossalari bilan puxta o'zlashtirish.
          </div>
          <div class="clarify-btn-action">
            <span>To'liq yo'l xaritasini ochish →</span>
          </div>
        </button>

        <!-- Option 3: Exam (HEMIS) -->
        <button type="button" class="clarify-btn" data-mode="exam">
          <div class="clarify-btn-badge" style="background: rgba(37, 99, 235, 0.15); color: #2563eb;">
            📝 HEMIS IMTIHON REJASI (35–45 daqiqa)
          </div>
          <div class="clarify-btn-title">Faqat nazorat va testlar uchun</div>
          <div class="clarify-btn-desc">
            Oraliq va yakuniy nazoratlarda eng ko'p tushadigan tipik savollar, hisoblashdagi xavfli tuzoqlar va test savollariga qaratilgan reja.
          </div>
          <div class="clarify-btn-action">
            <span>Test rejasini ko'rish →</span>
          </div>
        </button>
      </div>
    </section>

    <!-- Step 3: Strategy Output Container -->
    <div id="strategy-result-wrapper" style="display: none;">
      <!-- Active Mode Switch Bar (Allows switching anytime) -->
      <div class="active-mode-bar">
        <div style="font-size: 0.88rem; font-weight: 700; color: var(--text-main);">
          Tanlangan rejim:
        </div>
        <div class="mode-pills">
          <button type="button" class="mode-pill" data-switch="express">
            ⚡ Faqat shu mavzu (Tezkor)
          </button>
          <button type="button" class="mode-pill active" data-switch="deep">
            🎓 Chuqur (Poydevor bilan)
          </button>
          <button type="button" class="mode-pill" data-switch="exam">
            📝 HEMIS Test rejasi
          </button>
        </div>
        <div class="share-actions">
          <button type="button" id="copy-strategy-btn" class="btn btn-secondary btn-sm" title="Rejani nusxalash">
            📋 Nusxalash
          </button>
          <a id="telegram-share-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="color: #0284c7; border-color: #0284c7;" title="Telegramga yuborish">
            📲 Telegramga saqlash
          </a>
        </div>
      </div>

      <!-- Diagnosis & Empathy Banner -->
      <div class="diagnosis-banner" id="strategy-diagnosis-banner"></div>

      <!-- Progress Tracker -->
      <div class="roadmap-progress-card">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
          <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-main);">
            📊 Ushbu strategiya bo'yicha shaxsiy natijangiz:
          </div>
          <span id="roadmap-progress-label" style="font-size: 0.85rem; font-weight: 700; color: var(--primary);">
            0 / 4 qadam o'zlashtirilgan (0%)
          </span>
        </div>
        <div class="progress-track">
          <div id="roadmap-progress-fill" class="progress-fill" style="width: 0%;"></div>
        </div>
        <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.4rem;">
          💡 Darslarni o'qib bo'lgach, katakchalarni belgilang — natijangiz brauzeringizda avtomatik saqlanadi.
        </div>
      </div>

      <!-- Step-by-Step Timeline -->
      <div class="timeline-section">
        <h2 class="section-heading" id="timeline-main-heading">🗺️ Qadamma-qadam Tavsiya Etilgan Darslar</h2>
        <div id="strategy-steps-list" class="timeline-list"></div>
      </div>

      <!-- Interactive Practice Tools & Exam Tip -->
      <div class="tools-and-tips-grid">
        <div class="tools-box">
          <h3 style="margin: 0 0 0.75rem 0; font-size: 1.1rem; color: var(--text-main);">
            🛠️ Amaliy Mashq va Tekshiruv Asboblari
          </h3>
          <div id="strategy-tools-list" class="tools-cards"></div>
        </div>

        <div class="exam-tip-box">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: 1.05rem; color: #d97706; margin-bottom: 0.6rem;">
            <span>🏆</span>
            <span>Professorning Imtihon Siri (HEMIS va Oraliq uchun)</span>
          </div>
          <p id="strategy-exam-tip" style="margin: 0 0 1.25rem 0; font-size: 0.95rem; line-height: 1.6; color: var(--text-main);"></p>

          <button type="button" id="ask-gemini-mentor-btn" class="btn ai-mentor-btn">
            <span>🤖 Gemini AI Mentoridan qo'shimcha shaxsiy maslahat olish</span>
          </button>
        </div>
      </div>

      <!-- Gemini AI Deep Personal Mentor Box -->
      <div id="ai-mentor-response-card" class="ai-mentor-card" style="display: none;">
        <div class="ai-mentor-header">
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span style="font-size: 1.4rem;">🎓</span>
            <div>
              <h3 style="margin: 0; font-size: 1.1rem; color: var(--text-main);">AI Shaxsiy Kouch Xulosasi</h3>
              <span id="ai-mentor-badge" style="font-size: 0.78rem; color: var(--primary); font-weight: 600;">Sayt o'quv dasturi asosida tuzildi</span>
            </div>
          </div>
        </div>
        <div id="ai-mentor-body" class="ai-mentor-body prose-content"></div>
      </div>

      <!-- Interactive Q&A Chat with AI Mentor -->
      <section class="mentor-chat-section">
        <div class="chat-section-header">
          <div style="font-size: 1.4rem;">💬</div>
          <div>
            <h3 style="margin: 0 0 0.2rem 0; font-size: 1.1rem; color: var(--text-main);">AI Repetitorga savol bering</h3>
            <p style="margin: 0; font-size: 0.85rem; color: var(--text-muted);">
              Ushbu mavzu bo'yicha tushunmagan joyingizni so'rang (masalan: <em>«Minus ishora qayerga qo'yiladi?»</em> yoki <em>«1-qadamni o'qidim, endi qanday misol yechay?»</em>)
            </p>
          </div>
        </div>

        <div id="mentor-chat-messages" class="chat-messages-container"></div>

        <div class="chat-input-bar">
          <input 
            type="text" 
            id="mentor-chat-input" 
            placeholder="AI Repetitordan so'rang (masalan: Sarryus qoidasida minus qayerga qo'yiladi?)..." 
          />
          <button type="button" id="mentor-chat-send-btn" class="btn btn-primary" style="padding: 0.65rem 1.25rem; font-weight: 700;">
            Yuborish 🚀
          </button>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { generateStudyStrategy, SITE_CURRICULUM_PROMPT_MAP, type StudyStrategyPlan } from '../utils/studyStrategyEngine';
  import katex from 'katex';

  function renderMarkdownWithLinksAndMath(md: string): string {
    let html = md
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    // Block math
    html = html.replace(/\$\$([\s\S]+?)\$\$/g, (_, m) => {
      try {
        return katex.renderToString(m.trim(), { displayMode: true, throwOnError: false });
      } catch {
        return m;
      }
    });

    // Inline math
    html = html.replace(/\$([^\$\n]+?)\$/g, (_, m) => {
      try {
        return katex.renderToString(m.trim(), { displayMode: false, throwOnError: false });
      } catch {
        return m;
      }
    });

    // Course links [Title](/dars/...)
    html = html.replace(
      /\[([^\]]+)\]\((\/[^\)]+)\)/g,
      '<a href="$2" class="mentor-inline-link">📖 $1 →</a>'
    );

    html = html
      .replace(/^### (.*$)/gim, '<h4 style="margin: 1rem 0 0.4rem; color: var(--text-main);">$1</h4>')
      .replace(/^## (.*$)/gim, '<h3 style="margin: 1.25rem 0 0.5rem; color: var(--primary);">$1</h3>')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/\n\n/g, '<br><br>')
      .replace(/\n- /g, '<br>• ');

    return html;
  }

  function setupStrategyPage() {
    const queryInput = document.getElementById('strategy-query-input') as HTMLInputElement | null;
    const buildBtn = document.getElementById('build-strategy-btn');
    const clarifySection = document.getElementById('ai-clarify-section');
    const clarifyHeading = document.getElementById('clarify-topic-heading');
    const clarifyIntro = document.getElementById('clarify-intro-text');
    const resultWrapper = document.getElementById('strategy-result-wrapper');
    const diagnosisBanner = document.getElementById('strategy-diagnosis-banner');
    const stepsList = document.getElementById('strategy-steps-list');
    const toolsList = document.getElementById('strategy-tools-list');
    const examTipEl = document.getElementById('strategy-exam-tip');
    const progressLabel = document.getElementById('roadmap-progress-label');
    const progressFill = document.getElementById('roadmap-progress-fill');
    const askMentorBtn = document.getElementById('ask-gemini-mentor-btn');
    const mentorCard = document.getElementById('ai-mentor-response-card');
    const mentorBody = document.getElementById('ai-mentor-body');
    const mentorBadge = document.getElementById('ai-mentor-badge');
    const copyBtn = document.getElementById('copy-strategy-btn');
    const telegramShareBtn = document.getElementById('telegram-share-btn') as HTMLAnchorElement | null;
    const chatInput = document.getElementById('mentor-chat-input') as HTMLInputElement | null;
    const chatSendBtn = document.getElementById('mentor-chat-send-btn');
    const chatMessages = document.getElementById('mentor-chat-messages');

    if (!queryInput || !buildBtn || (buildBtn as any)._hasStrategyV2Init) return;
    (buildBtn as any)._hasStrategyV2Init = true;

    let activeMode: 'express' | 'deep' | 'exam' = 'deep';
    let currentPlan: StudyStrategyPlan | null = null;
    let activeQuery = '';

    function getCompletedLessons(): string[] {
      try {
        return JSON.parse(localStorage.getItem('math_completed_lessons') || '[]');
      } catch {
        return [];
      }
    }

    function toggleLessonCompletion(slug: string) {
      if (!slug) return;
      const completed = getCompletedLessons();
      let updated: string[];
      if (completed.includes(slug)) {
        updated = completed.filter((s) => s !== slug);
      } else {
        updated = [...completed, slug];
      }
      localStorage.setItem('math_completed_lessons', JSON.stringify(updated));
      updateProgressDisplay();
    }

    function updateProgressDisplay() {
      if (!currentPlan) return;
      const completed = getCompletedLessons();
      let completedInPlan = 0;
      currentPlan.steps.forEach((s) => {
        if (s.slug && completed.includes(s.slug)) {
          completedInPlan++;
        }
      });
      const total = currentPlan.steps.length;
      const pct = total > 0 ? Math.round((completedInPlan / total) * 100) : 0;
      if (progressLabel) {
        progressLabel.textContent = `${completedInPlan} / ${total} qadam o'zlashtirilgan (${pct}%)`;
      }
      if (progressFill) {
        progressFill.style.width = `${pct}%`;
      }

      // Update checkboxes and cards
      document.querySelectorAll('.timeline-card').forEach((card) => {
        const slug = card.getAttribute('data-slug');
        const chk = card.querySelector('.step-check') as HTMLInputElement | null;
        if (slug && completed.includes(slug)) {
          card.classList.add('is-completed');
          if (chk) chk.checked = true;
          const badge = card.querySelector('.completion-indicator');
          if (badge) badge.innerHTML = '<span class="done-badge">✅ O\'zlashtirilgan</span>';
        } else {
          card.classList.remove('is-completed');
          if (chk) chk.checked = false;
          const badge = card.querySelector('.completion-indicator');
          if (badge) badge.innerHTML = '<span class="todo-badge">⭕ O\'qish kerak</span>';
        }
      });
    }

    function onUserSubmitsTopic(raw: string, directMode?: 'express' | 'deep' | 'exam') {
      activeQuery = raw.trim() || 'Men darsda determinantga qiynalyapman';
      const basePlan = generateStudyStrategy(activeQuery, 'deep');

      if (clarifyHeading) {
        clarifyHeading.textContent = `AI Tahlili: «${basePlan.topicTitle}» bo'yicha yordam`;
      }
      if (clarifyIntro) {
        clarifyIntro.innerHTML = `Mavzuni aniqladik: <strong>${basePlan.moduleTitle}</strong>. O'qishni boshlashdan oldin bitta savol: Sizga aynan qaysi formatda yordam kerak?`;
      }

      if (directMode) {
        // Direct mode requested via URL or quick button
        renderRoadmap(activeQuery, directMode);
      } else {
        // Show Clarification Question section
        if (clarifySection) {
          clarifySection.style.display = 'block';
          clarifySection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        if (resultWrapper) {
          resultWrapper.style.display = 'none';
        }
      }
    }

    function renderRoadmap(rawQuery: string, mode: 'express' | 'deep' | 'exam') {
      activeMode = mode;
      activeQuery = rawQuery;
      currentPlan = generateStudyStrategy(activeQuery, activeMode);

      // Hide clarify question
      if (clarifySection) clarifySection.style.display = 'none';

      // Update active mode pill
      document.querySelectorAll('.mode-pill').forEach((pill) => {
        if (pill.getAttribute('data-switch') === activeMode) {
          pill.classList.add('active');
        } else {
          pill.classList.remove('active');
        }
      });

      // Diagnosis banner
      if (diagnosisBanner) {
        const modeBadge =
          activeMode === 'express'
            ? '⚡ Tezkor (Faqat eng asosiysi)'
            : activeMode === 'exam'
            ? '📝 HEMIS Imtihon Rejasi'
            : '🎓 Chuqur (Poydevor bilan)';

        diagnosisBanner.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
            <span class="module-pill">${currentPlan.moduleTitle}</span>
            <span class="time-pill">${modeBadge} • ⏱ ${currentPlan.estimatedTotalTime}</span>
          </div>
          <h2 style="margin: 0 0 0.6rem 0; font-size: 1.45rem; color: var(--text-main);">
            🎯 ${currentPlan.topicTitle}
          </h2>
          <p style="margin: 0 0 0.85rem 0; font-size: 0.98rem; color: var(--text-main); line-height: 1.55;">
            <strong>💬 AI Repetitor:</strong> ${currentPlan.empathyMessage}
          </p>
          <div class="root-cause-box">
            <strong>🔍 Nega talabalar bu mavzuda qiynaladi?</strong> ${currentPlan.rootCauseWhyHard}
          </div>
        `;
      }

      // Steps list rendering with Interactive Checkbox
      const completed = getCompletedLessons();
      if (stepsList) {
        stepsList.innerHTML = currentPlan.steps
          .map((step, idx) => {
            const isDone = step.slug ? completed.includes(step.slug) : false;
            return `
              <div class="timeline-card ${isDone ? 'is-completed' : ''}" data-slug="${step.slug || ''}">
                <div class="step-check-col">
                  <input type="checkbox" class="step-check" ${isDone ? 'checked' : ''} aria-label="O'zlashtirildi deb belgilash" />
                </div>
                <div class="timeline-num" style="background: ${isDone ? '#10b981' : step.badgeColor};">
                  ${idx + 1}
                </div>
                <div class="timeline-content">
                  <div class="timeline-top">
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                      <span class="phase-badge" style="background: ${step.badgeColor}18; color: ${step.badgeColor}; border: 1px solid ${step.badgeColor}40;">
                        ${idx + 1}-QADAM • ${step.phase.toUpperCase()}
                      </span>
                      <span class="duration-badge">⏱ ${step.duration}</span>
                      <span class="completion-indicator">
                        ${isDone ? '<span class="done-badge">✅ O\'zlashtirilgan</span>' : '<span class="todo-badge">⭕ O\'qish kerak</span>'}
                      </span>
                    </div>
                  </div>

                  <h3 class="step-title">
                    <a href="${step.url}">${step.title}</a>
                  </h3>

                  <p class="step-why">
                    <strong>Nima uchun bu dars?</strong> ${step.whyRead}
                  </p>

                  <div class="focus-list">
                    <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted);">Diqqat qiling:</span>
                    ${step.focusPoints.map((fp) => `<span class="focus-chip">✓ ${fp}</span>`).join('')}
                  </div>

                  <div style="margin-top: 0.85rem;">
                    <a href="${step.url}" class="btn btn-primary step-open-btn">
                      <span>📖 ${idx + 1}-qadam darsini ochish</span>
                      <span>→</span>
                    </a>
                  </div>
                </div>
              </div>
            `;
          })
          .join('');

        // Attach checkbox event listeners
        stepsList.querySelectorAll('.step-check').forEach((chk) => {
          chk.addEventListener('change', (e) => {
            const card = (e.target as HTMLElement).closest('.timeline-card');
            const slug = card?.getAttribute('data-slug');
            if (slug) toggleLessonCompletion(slug);
          });
        });
      }

      // Tools rendering
      if (toolsList) {
        toolsList.innerHTML = currentPlan.interactiveTools
          .map(
            (t) => `
            <a href="${t.url}" class="tool-item-card">
              <div style="font-size: 1.6rem;">${t.icon}</div>
              <div>
                <div style="font-weight: 700; color: var(--primary); font-size: 0.95rem; margin-bottom: 0.2rem;">
                  ${t.title} →
                </div>
                <div style="font-size: 0.84rem; color: var(--text-muted); line-height: 1.4;">
                  ${t.desc}
                </div>
              </div>
            </a>
          `
          )
          .join('');
      }

      if (examTipEl) {
        examTipEl.textContent = currentPlan.examTip;
      }

      // Telegram share link
      if (telegramShareBtn) {
        const text = encodeURIComponent(
          `Assalomu alaykum! OliyMatematika saytidan shaxsiy o'quv rejam:\n\n` +
          `🎯 Mavzu: ${currentPlan.topicTitle}\n` +
          `⏱ Rejim: ${activeMode.toUpperCase()} (${currentPlan.estimatedTotalTime})\n\n` +
          currentPlan.steps.map((s, i) => `${i + 1}-qadam: ${s.title} (https://oliy-matematika.vercel.app${s.url})`).join('\n') +
          `\n\n💡 Maslahat: ${currentPlan.examTip}`
        );
        telegramShareBtn.href = `https://t.me/share/url?url=${encodeURIComponent('https://oliy-matematika.vercel.app/strategiya?q=' + activeQuery + '&mode=' + activeMode)}&text=${text}`;
      }

      updateProgressDisplay();

      if (resultWrapper) {
        resultWrapper.style.display = 'block';
        resultWrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Clarification buttons click
    document.querySelectorAll('.clarify-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = (btn.getAttribute('data-mode') as any) || 'deep';
        renderRoadmap(activeQuery, mode);
      });
    });

    // Active mode switch pills inside roadmap
    document.querySelectorAll('.mode-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        const mode = (pill.getAttribute('data-switch') as any) || 'deep';
        renderRoadmap(activeQuery, mode);
      });
    });

    // Copy strategy button
    copyBtn?.addEventListener('click', async () => {
      if (!currentPlan) return;
      const text =
        `OliyMatematika — Shaxsiy O'quv Rejasi:\nMavzu: ${currentPlan.topicTitle}\n\n` +
        currentPlan.steps.map((s, i) => `${i + 1}. ${s.title} -> https://oliy-matematika.vercel.app${s.url}`).join('\n') +
        `\n\nMaslahat: ${currentPlan.examTip}`;
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.textContent = '✅ Nusxalandi!';
        setTimeout(() => (copyBtn.textContent = '📋 Nusxalash'), 2500);
      } catch {
        alert("Nusxalab bo'lmadi.");
      }
    });

    // User submits search query
    buildBtn.addEventListener('click', () => {
      onUserSubmitsTopic(queryInput.value);
    });

    queryInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        onUserSubmitsTopic(queryInput.value);
      }
    });

    // Sample prompt chips
    document.querySelectorAll('.sample-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const q = chip.getAttribute('data-query') || '';
        queryInput.value = q;
        onUserSubmitsTopic(q);
      });
    });

    // Gemini Deep Personal Mentor button
    askMentorBtn?.addEventListener('click', async () => {
      if (!currentPlan || !mentorCard || !mentorBody) return;
      askMentorBtn.setAttribute('disabled', 'true');
      askMentorBtn.textContent = '⏳ AI Mentor shaxsiy reja tuzmoqda...';
      mentorCard.style.display = 'block';
      mentorBody.innerHTML = `<p style="color: var(--text-muted);">⏳ Sizning so'rovingiz («${activeQuery}») va tanlangan «${activeMode}» rejimi asosida chuqur akademik ko'rsatma tayyorlanmoqda...</p>`;

      const userCustomKey = localStorage.getItem('gemini_user_api_key') || '';
      let aiText = '';

      try {
        const headers: Record<string, string> = { 'Content-Type': 'application/json' };
        if (userCustomKey) headers['x-user-gemini-key'] = userCustomKey;

        const res = await fetch('/api/solve', {
          method: 'POST',
          headers,
          body: JSON.stringify({
            model: 'gemini-flash-lite-latest',
            systemInstruction: { parts: [{ text: SITE_CURRICULUM_PROMPT_MAP }] },
            contents: [
              {
                parts: [
                  {
                    text: `Talaba so'rovi: "${activeQuery}". Tanlangan rejim: ${activeMode}. Unga motivatsiya bering va saytimizdagi dars havolalari bilan ${activeMode === 'express' ? 'faqat eng zarur 2 ta asosiy dars va formulalar bilan qisqa tezkor reja' : 'chuqur poydevorli yo\'l xaritasi'} tuzib bering.`
                  }
                ]
              }
            ],
            generationConfig: { temperature: 0.2 }
          })
        });

        if (res.ok) {
          const data = await res.json();
          aiText = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
        }
      } catch {
        // Fallback below
      }

      if (!aiText) {
        const stepLinks = currentPlan.steps
          .map((s, i) => `${i + 1}. **[${s.title}](${s.url})** — *(${s.duration})* ${s.whyRead}`)
          .join('\n- ');
        const toolLink = currentPlan.interactiveTools[0];

        aiText = `## 🎯 «${activeQuery}» bo'yicha Shaxsiy Tayyorgarlik Rejasi (${activeMode.toUpperCase()})

**1. Nima uchun hozir qiynalyapsiz va buni qanday yengamiz?**
${currentPlan.empathyMessage} ${currentPlan.rootCauseWhyHard}

## 📅 Ketma-ket Qadamlar:
- ${stepLinks}

## 🧪 Amaliy Mashq va Tekshiruv
Darslarni o'qigach, **[${toolLink.title}](${toolLink.url})** da misollarni hisoblang va **[${currentPlan.moduleTitle} HEMIS Testi](/testlar?modul=${currentPlan.moduleSlug}#quiz-section)** orqali o'zingizni sinab ko'ring!

**💡 Oltin qoida:** ${currentPlan.examTip}`;
        if (mentorBadge) mentorBadge.textContent = "⚡ Sayt Akademik AI Navigatori tomonidan tuzildi";
      } else if (mentorBadge) {
        mentorBadge.textContent = "🛡️ Gemini AI Pro Mentor tomonidan jonli tuzildi";
      }

      mentorBody.innerHTML = renderMarkdownWithLinksAndMath(aiText);
      askMentorBtn.removeAttribute('disabled');
      askMentorBtn.innerHTML = '<span>🤖 Gemini AI Mentoridan qo\'shimcha shaxsiy maslahat olish</span>';
      mentorCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    // Interactive Q&A Chat Handler
    async function sendChatMessage() {
      if (!chatInput || !chatMessages) return;
      const question = chatInput.value.trim();
      if (!question) return;

      chatInput.value = '';

      // Append user bubble
      const userBubble = document.createElement('div');
      userBubble.className = 'chat-bubble user-bubble';
      userBubble.textContent = question;
      chatMessages.appendChild(userBubble);
      chatMessages.scrollTop = chatMessages.scrollHeight;

      // Append AI loading bubble
      const aiBubble = document.createElement('div');
      aiBubble.className = 'chat-bubble ai-bubble';
      aiBubble.innerHTML = '<span class="typing-indicator">AI Repetitor javob yozmoqda...</span>';
      chatMessages.appendChild(aiBubble);
      chatMessages.scrollTop = chatMessages.scrollHeight;

      const userCustomKey = localStorage.getItem('gemini_user_api_key') || '';
      let replyText = '';

      try {
        const headers: Record<string, string> = { 'Content-Type': 'application/json' };
        if (userCustomKey) headers['x-user-gemini-key'] = userCustomKey;

        const res = await fetch('/api/solve', {
          method: 'POST',
          headers,
          body: JSON.stringify({
            model: 'gemini-flash-lite-latest',
            systemInstruction: { parts: [{ text: `${SITE_CURRICULUM_PROMPT_MAP}\nSiz repetitorsiz. Mavzu: ${currentPlan?.topicTitle}. Savolga qisqa, tushunarli, formulalar bilan javob bering va dars havolasini ko'rsating.` }] },
            contents: [
              {
                parts: [
                  {
                    text: `Mavzu konteksti: ${currentPlan?.topicTitle || activeQuery}. Talaba savoli: "${question}". O'zbek tilida aniq, formulalar ($...$) bilan javob bering.`
                  }
                ]
              }
            ],
            generationConfig: { temperature: 0.2 }
          })
        });

        if (res.ok) {
          const data = await res.json();
          replyText = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
        }
      } catch {
        // Fallback
      }

      if (!replyText) {
        replyText = `Savolingiz uchun rahmat! Ushbu savol bo'yicha to'liq ma'lumot va qadamma-qadam formulalar yuqoridagi **[${currentPlan?.steps[0]?.title || 'Dars'}](${currentPlan?.steps[0]?.url || '/'})** sahifasida batafsil yoritilgan. O'sha darsni o'qib chiqsangiz, barcha savollaringizga to'liq javob olasiz!`;
      }

      aiBubble.innerHTML = renderMarkdownWithLinksAndMath(replyText);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    chatSendBtn?.addEventListener('click', sendChatMessage);
    chatInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        sendChatMessage();
      }
    });

    // URL parameter handling (?q=...&mode=...)
    const params = new URLSearchParams(window.location.search);
    const urlQuery = params.get('q');
    const urlMode = params.get('mode') as 'express' | 'deep' | 'exam' | null;
    if (urlQuery) {
      queryInput.value = urlQuery;
      onUserSubmitsTopic(urlQuery, urlMode || undefined);
    } else {
      // Show default query prompt
      queryInput.value = 'Men darsda determinantga qiynalyapman';
      onUserSubmitsTopic(queryInput.value);
    }
  }

  setupStrategyPage();
  document.addEventListener('astro:page-load', setupStrategyPage);
  document.addEventListener('astro:after-swap', setupStrategyPage);
</script>

