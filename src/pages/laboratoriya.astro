---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="🔮 Interaktiv Matematik Laboratoriya — 3Blue1Brown va Vizual Simulyatsiyalar | Oliy Matematika" 
  description="Matematikani ko'z bilan ko'ring va his qiling: 3Blue1Brown uslubidagi matritsa fazo transformatori, Riman integrali slayderi, Monte-Karlo pi hisoblagichi, Fure epitsikllari, Galton doskasi va Gradient tushishi."
>
  <div class="lab-container">
    <!-- Lab Hero Banner -->
    <header class="lab-hero">
      <div class="lab-badge">
        <span class="badge-icon">🔮</span>
        <span>Vizual Laboratoriya & Simulyatsiyalar</span>
        <span class="badge-pill">60 FPS Interaktiv</span>
      </div>
      <h1 class="lab-title">Interaktiv Matematika Laboratoriyasi</h1>
      <p class="lab-subtitle">
        Matematika — faqat qog'ozdagi quruq formulalar emas. Bu yerda siz fazoning buralishini, integral maydonlarining tug'ilishini, ehtimollik tartibini va sun'iy intellekt qanday o'rganishini o'z qo'lingiz bilan boshqarib ko'rasiz!
      </p>

      <!-- Navigation Tabs -->
      <div class="lab-tabs" role="tablist">
        <button class="lab-tab active" data-tab="matrix-warp">
          <span class="tab-icon">🌌</span>
          <div class="tab-text">
            <strong>Fazo Transformatori</strong>
            <small>3Blue1Brown uslubi</small>
          </div>
        </button>
        <button class="lab-tab" data-tab="riemann-sum">
          <span class="tab-icon">⚡</span>
          <div class="tab-text">
            <strong>Riman Integrali</strong>
            <small>Maydon slayderi</small>
          </div>
        </button>
        <button class="lab-tab" data-tab="monte-carlo">
          <span class="tab-icon">🎯</span>
          <div class="tab-text">
            <strong>Monte-Karlo π</strong>
            <small>Ehtimollik yog'dusi</small>
          </div>
        </button>
        <button class="lab-tab" data-tab="fourier-epicycles">
          <span class="tab-icon">🌊</span>
          <div class="tab-text">
            <strong>Fure Epitsikllari</strong>
            <small>Aylanalar garmoniyasi</small>
          </div>
        </button>
        <button class="lab-tab" data-tab="galton-board">
          <span class="tab-icon">🔮</span>
          <div class="tab-text">
            <strong>Galton Doskasi</strong>
            <small>Normal taqsimot</small>
          </div>
        </button>
        <button class="lab-tab" data-tab="gradient-descent">
          <span class="tab-icon">🏔️</span>
          <div class="tab-text">
            <strong>Gradient Tushishi</strong>
            <small>AI qanday o'rganadi?</small>
          </div>
        </button>
      </div>
    </header>

    <!-- ================= 1. MATRIX WARP SIMULATOR ================= -->
    <section id="panel-matrix-warp" class="sim-panel active">
      <div class="sim-grid">
        <div class="canvas-card">
          <div class="canvas-header">
            <h3>🌌 2D Fazo Transformatsiyasi va Determinant</h3>
            <span class="live-tag">Jonli 2D Canvas</span>
          </div>
          <div class="canvas-wrapper">
            <canvas id="matrix-canvas" width="600" height="500"></canvas>
          </div>
          <div class="canvas-legend">
            <span><strong style="color: #ef4444;">— î</strong> (1, 0) yangi o'rni</span>
            <span><strong style="color: #10b981;">— ĵ</strong> (0, 1) yangi o'rni</span>
            <span><strong style="color: #3b82f6;">■ Parallelogramm:</strong> Determinant</span>
          </div>
        </div>

        <div class="controls-card">
          <div class="panel-section">
            <h4>Matritsa elementlari: A = [[a, b], [c, d]]</h4>
            <div class="matrix-inputs-grid">
              <div class="input-field">
                <label>a (î.x):</label>
                <input type="number" id="mat-a" value="1" step="0.5" />
              </div>
              <div class="input-field">
                <label>b (ĵ.x):</label>
                <input type="number" id="mat-b" value="1" step="0.5" />
              </div>
              <div class="input-field">
                <label>c (î.y):</label>
                <input type="number" id="mat-c" value="0" step="0.5" />
              </div>
              <div class="input-field">
                <label>d (ĵ.y):</label>
                <input type="number" id="mat-d" value="1" step="0.5" />
              </div>
            </div>
          </div>

          <div class="panel-section">
            <label class="control-label">
              <span>Transformatsiya animatsiyasi (t):</span>
              <strong id="time-val">100%</strong>
            </label>
            <input type="range" id="time-slider" min="0" max="1" step="0.01" value="1" style="width: 100%;" />
            <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
              <button id="btn-animate-matrix" class="btn btn-primary" style="flex: 1;">▶ Qayta animatsiya</button>
              <button id="btn-reset-matrix" class="btn btn-secondary">Boshlang'ich</button>
            </div>
          </div>

          <div class="panel-section">
            <h4>Mashhur Tayyor Namunalar (Presets):</h4>
            <div class="presets-wrap">
              <button class="preset-pill" data-preset="shear">Siljish (Shear)</button>
              <button class="preset-pill" data-preset="rotate45">Burish 45°</button>
              <button class="preset-pill" data-preset="rotate90">Burish 90°</button>
              <button class="preset-pill" data-preset="scale2">2x Cho'zish</button>
              <button class="preset-pill" data-preset="reflect">Akslantirish (X)</button>
              <button class="preset-pill danger-pill" data-preset="squash">Yassilash (det = 0)</button>
            </div>
          </div>

          <div class="metrics-box">
            <div class="metric-row">
              <span>Determinant det(A):</span>
              <strong id="mat-det-display">1</strong>
            </div>
            <div class="metric-row">
              <span>Geometrik ma'no:</span>
              <span id="mat-status-display" style="color: #10b981; font-weight: 600;">Yuz saqlanadi</span>
            </div>
          </div>
        </div>
      </div>

      <div class="theory-card">
        <h4>💡 Nima sodir bo'lmoqda?</h4>
        <p>
          Siz kiritgan har qanday 2 × 2 matritsa fazodagi barcha nuqtalarni yangi joyga ko'chiradi. 
          Bunda eng muhim qoida: <strong>to'g'ri chiziqlar to'g'riligicha qoladi va koordinatalar boshi (0, 0) o'z o'rnida qoladi</strong>.
          Rangli parallelogramm yuzi esa aynan <strong>Determinant</strong>ga teng! Agar det(A) = 0 bo'lsa, butun 2 o'lchamli tekislik bir zumda 1 o'lchamli chiziqqa qulab tushadi.
        </p>
      </div>
    </section>

    <!-- ================= 2. RIEMANN SUM SIMULATOR ================= -->
    <section id="panel-riemann-sum" class="sim-panel">
      <div class="sim-grid">
        <div class="canvas-card">
          <div class="canvas-header">
            <h3>⚡ Riman Integrali: Maydon qanday tug'iladi?</h3>
            <span class="live-tag">Egri chiziq osti yuzi</span>
          </div>
          <div class="canvas-wrapper">
            <canvas id="riemann-canvas" width="600" height="500"></canvas>
          </div>
        </div>

        <div class="controls-card">
          <div class="panel-section">
            <h4>Funksiyani tanlang:</h4>
            <div class="presets-wrap">
              <button class="preset-pill active" data-func="parabola">f(x) = x²</button>
              <button class="preset-pill" data-func="sin">f(x) = sin(x) + 1.2</button>
              <button class="preset-pill" data-func="gauss">f(x) = 3·e^(-x²)</button>
              <button class="preset-pill" data-func="poly">f(x) = x³ - 2x + 2</button>
            </div>
          </div>

          <div class="panel-section">
            <label class="control-label">
              <span>Bo'laklar soni (n ta to'rtburchak):</span>
              <strong id="riemann-n-display">10</strong>
            </label>
            <input type="range" id="riemann-n-slider" min="2" max="100" value="10" style="width: 100%;" />
          </div>

          <div class="panel-section">
            <h4>Approksimatsiya usuli:</h4>
            <div class="presets-wrap">
              <button class="preset-pill active" data-mode="mid">O'rta nuqta (Midpoint)</button>
              <button class="preset-pill" data-mode="left">Chap burchak (Left)</button>
              <button class="preset-pill" data-mode="right">O'ng burchak (Right)</button>
              <button class="preset-pill" data-mode="trap">Trapetsiyalar usuli</button>
            </div>
          </div>

          <div class="metrics-box">
            <div class="metric-row">
              <span>Aniq Integral (Nazariy):</span>
              <strong id="exact-integral-display">2.6667</strong>
            </div>
            <div class="metric-row">
              <span>Riman Yig'indisi:</span>
              <strong id="approx-integral-display">2.6500</strong>
            </div>
            <div class="metric-row">
              <span>Absolyut xatolik (Δ):</span>
              <span id="error-display" style="color: #f59e0b; font-weight: 700;">0.0167</span>
            </div>
          </div>
        </div>
      </div>

      <div class="theory-card">
        <h4>💡 Riman g'oyasi:</h4>
        <p>
          Egri chiziqli shaklning yuzini to'g'ridan-to'g'ri hisoblash qiyin. Riman ushbu yuzani juda mayda to'rtburchaklarga bo'lib chiqishni taklif qilgan. 
          To'rtburchaklar soni n → ∞ intilganda, ularning eni Δx → 0 bo'lib, yig'indi aniq integralga aylanadi:
          <strong>∫ f(x)dx = lim ∑ f(x_i) · Δx</strong>.
        </p>
      </div>
    </section>

    <!-- ================= 3. MONTE CARLO PI SIMULATOR ================= -->
    <section id="panel-monte-carlo" class="sim-panel">
      <div class="sim-grid">
        <div class="canvas-card">
          <div class="canvas-header">
            <h3>🎯 Monte-Karlo: Ehtimollik orqali π ni topish</h3>
            <span class="live-tag">Tasodifiy o'qlar</span>
          </div>
          <div class="canvas-wrapper">
            <canvas id="monte-canvas" width="500" height="500"></canvas>
          </div>
        </div>

        <div class="controls-card">
          <div class="panel-section">
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <button id="btn-monte-start" class="btn btn-primary" style="flex: 1;">▶ Boshlash / To'xtatish</button>
              <button id="btn-monte-drop1000" class="btn btn-secondary">+1000 Nuqta</button>
              <button id="btn-monte-reset" class="btn btn-secondary">Tozalash</button>
            </div>
          </div>

          <div class="panel-section">
            <label class="control-label">
              <span>Simulyatsiya tezligi:</span>
              <strong id="monte-speed-display">50 nuqta/kadr</strong>
            </label>
            <input type="range" id="monte-speed-slider" min="5" max="200" value="50" style="width: 100%;" />
          </div>

          <div class="metrics-box">
            <div class="metric-row">
              <span>Jami tashlangan nuqtalar (N):</span>
              <strong id="monte-total">0</strong>
            </div>
            <div class="metric-row">
              <span>Doira ichiga tushganlar (M):</span>
              <strong id="monte-inside" style="color: #10b981;">0</strong>
            </div>
            <div class="metric-row" style="font-size: 1.15rem; border-top: 1px solid var(--border-color); padding-top: 0.5rem; margin-top: 0.5rem;">
              <span>Hisoblangan π ≈ 4 · (M / N):</span>
              <strong id="monte-pi-display" style="color: var(--primary);">0.00000</strong>
            </div>
            <div class="metric-row">
              <span>Haqiqiy π qiymati:</span>
              <strong>3.14159</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="theory-card">
        <h4>💡 Monte-Karlo mohiyati:</h4>
        <p>
          Doira yuzi S_doira = π R², uni o'rab turgan kvadrat yuzi S_kvadrat = 4R². 
          Ular maydonlarining nisbati aniq π / 4 ga teng. 
          Agar kvadratga tasodifiy nuqtalar yomg'irini yog'dirsangiz, doira ichiga tushgan nuqtalar ulushi ehtimollik bo'yicha aynan π / 4 ga intiladi!
        </p>
      </div>
    </section>

    <!-- ================= 4. FOURIER EPICYCLES ================= -->
    <section id="panel-fourier-epicycles" class="sim-panel">
      <div class="sim-grid">
        <div class="canvas-card">
          <div class="canvas-header">
            <h3>🌊 Fure Epitsikllari: Aylanuvchi aylanalar to'lqini</h3>
            <span class="live-tag">Trigonometrik Garmoniya</span>
          </div>
          <div class="canvas-wrapper">
            <canvas id="fourier-canvas" width="600" height="400"></canvas>
          </div>
        </div>

        <div class="controls-card">
          <div class="panel-section">
            <h4>To'lqin shakli:</h4>
            <div class="presets-wrap">
              <button class="preset-pill active" data-wave="square">Kvadrat to'lqin</button>
              <button class="preset-pill" data-wave="sawtooth">Arrasimon (Sawtooth)</button>
              <button class="preset-pill" data-wave="triangle">Uchburchak to'lqin</button>
            </div>
          </div>

          <div class="panel-section">
            <label class="control-label">
              <span>Garmonik aylanalar soni ($N$):</span>
              <strong id="fourier-n-display">5 ta aylana</strong>
            </label>
            <input type="range" id="fourier-n-slider" min="1" max="25" value="5" style="width: 100%;" />
          </div>

          <div class="panel-section">
            <div style="display: flex; gap: 0.5rem;">
              <button id="btn-fourier-pause" class="btn btn-secondary" style="flex: 1;">Pauza / Davom</button>
            </div>
          </div>

          <div class="metrics-box">
            <div class="metric-row">
              <span>Joriy qator yoyilmasi:</span>
              <span id="fourier-formula-display" style="font-family: var(--font-mono); font-size: 0.8rem;">y = 4/π (sin(t) + sin(3t)/3 + ...)</span>
            </div>
          </div>
        </div>
      </div>

      <div class="theory-card">
        <h4>💡 Jan Batist Fure kashfiyoti:</h4>
        <p>
          Fure isbotlaganki, har qanday davriy to'lqinni (hatto to'g'ri burchakli yoki arra shaklida bo'lsa ham) oddiy aylanma harakatlar — ya'ni <strong>sinus va kosinuslarning cheksiz yig'indisi</strong> ko'rinishida yozish mumkin.
          Har bir aylana ma'lum chastota va amplituda bilan aylanadi, ularning birgalikdagi harakati murakkab to'lqinni chizadi!
        </p>
      </div>
    </section>

    <!-- ================= 5. GALTON BOARD ================= -->
    <section id="panel-galton-board" class="sim-panel">
      <div class="sim-grid">
        <div class="canvas-card">
          <div class="canvas-header">
            <h3>🔮 Galton Doskasi: Tasodifdan tartib tug'ilishi</h3>
            <span class="live-tag">Normal (Gauss) Taqsimot</span>
          </div>
          <div class="canvas-wrapper">
            <canvas id="galton-canvas" width="550" height="500"></canvas>
          </div>
        </div>

        <div class="controls-card">
          <div class="panel-section">
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <button id="btn-galton-start" class="btn btn-primary" style="flex: 1;">▶ Oqimni yoqish / o'chirish</button>
              <button id="btn-galton-drop50" class="btn btn-secondary">+50 Sharcha</button>
              <button id="btn-galton-reset" class="btn btn-secondary">Tozalash</button>
            </div>
          </div>

          <div class="metrics-box">
            <div class="metric-row">
              <span>Tushgan sharchalar soni:</span>
              <strong id="galton-count">0</strong>
            </div>
            <div class="metric-row">
              <span>Markaziy quti ulushi:</span>
              <strong id="galton-center-percent">0%</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="theory-card">
        <h4>💡 Frensis Galton mo'jizasi:</h4>
        <p>
          Har bir sharcha mixga urilganda 50% ehtimol bilan chapga, 50% bilan o'ngga sakraydi. 
          Garchi har bir sharchaning harakati mutlaqo tasodifiy bo'lsa-da, ularning umumiy to'plami har doim 
          <strong>qo'ng'iroqsimon Gauss egri chizig'i</strong>ni (Normal taqsimotni) hosil qiladi!
        </p>
      </div>
    </section>

    <!-- ================= 6. GRADIENT DESCENT ================= -->
    <section id="panel-gradient-descent" class="sim-panel">
      <div class="sim-grid">
        <div class="canvas-card">
          <div class="canvas-header">
            <h3>🏔️ Gradient Tushishi: AI qanday minimum qidiradi?</h3>
            <span class="live-tag">Interaktiv Kontur Xaritasi</span>
          </div>
          <div class="canvas-wrapper">
            <canvas id="gradient-canvas" width="550" height="500"></canvas>
          </div>
          <p style="font-size: 0.8rem; color: var(--text-muted); text-align: center; margin-top: 0.5rem;">
            👆 <em>Xaritaning ixtiyoriy joyiga bosing — sharcha gradient bo'yicha pastga qarab sirpanadi!</em>
          </p>
        </div>

        <div class="controls-card">
          <div class="panel-section">
            <h4>Relyef / Xatolik sirti:</h4>
            <div class="presets-wrap">
              <button class="preset-pill active" data-surface="bowl">Kosadek botiq (x² + y²)</button>
              <button class="preset-pill" data-surface="saddle">Egar sirt (x² - y²)</button>
              <button class="preset-pill" data-surface="wells">Ikkita chuqurlik (Double Well)</button>
            </div>
          </div>

          <div class="panel-section">
            <label class="control-label">
              <span>O'rganish tezligi (Learning rate α):</span>
              <strong id="grad-lr-display">0.1</strong>
            </label>
            <input type="range" id="grad-lr-slider" min="0.01" max="0.5" step="0.01" value="0.1" style="width: 100%;" />
          </div>

          <div class="panel-section">
            <button id="btn-grad-reset" class="btn btn-secondary" style="width: 100%;">Tarixni tozalash</button>
          </div>

          <div class="metrics-box">
            <div class="metric-row">
              <span>Joriy nuqta (x, y):</span>
              <strong id="grad-pos">(0.00, 0.00)</strong>
            </div>
            <div class="metric-row">
              <span>Funksiya qiymati f(x, y):</span>
              <strong id="grad-val">0.00</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="theory-card">
        <h4>💡 Sun'iy intellekt va Neyron to'rlar poydevori:</h4>
        <p>
          Zamonaviy AI (ChatGPT, Gemini, haydovchisiz mashinalar) o'rganish jarayonida xatolik funksiyasini minimallashtiradi. 
          Gradient ∇f funksiyaning eng tez o'sish yo'nalishini ko'rsatadi. 
          Shuning uchun unga qarama-qarshi tomonga qadam tashlash — <strong>Antigradient yo'nalishi</strong> eng pastki nuqtaga (minimal xatolikka) olib boradi!
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .lab-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .lab-hero {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .lab-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(236, 72, 153, 0.1);
    color: #ec4899;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .badge-pill {
    background: #ec4899;
    color: white;
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .lab-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  .lab-subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 840px;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* Lab Tab Bar */
  .lab-tabs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.5rem;
    background: var(--bg-muted);
    padding: 0.4rem;
    border-radius: var(--radius-md);
  }

  .lab-tab {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
  }

  .lab-tab:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.5);
  }

  :global([data-theme="dark"]) .lab-tab:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .lab-tab.active {
    background: var(--bg-surface);
    color: var(--primary);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }

  .tab-icon {
    font-size: 1.4rem;
  }

  .tab-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .tab-text strong {
    font-size: 0.85rem;
  }

  .tab-text small {
    font-size: 0.7rem;
    color: var(--text-subtle);
  }

  /* Panels */
  .sim-panel {
    display: none;
    animation: fadeIn 0.25s ease-out;
  }

  .sim-panel.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .sim-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 960px) {
    .sim-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Canvas card */
  .canvas-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .canvas-header {
    display: flex;
    align-items: center;
